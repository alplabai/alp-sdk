// SPDX-License-Identifier: Apache-2.0
//
// Renode platform descriptor: E1M-X V2N (Renesas RZ/V2N, r9a09g056),
// the Cortex-M33 "system-manager" (M33-SM) subsystem, for the
// `--sim-mode` studio hardware-simulator contract, specified in
// github.com/alplabai/alp-sdk#674.  NB that contract currently has NO
// implementation: alp-sdk#674 was closed by the Python
// `west alp-renode --sim-mode`, which ADR-0020 Phase 4 (#848) deleted,
// and porting it to `tan renode --sim-mode` is open as tan-cli#77.
// This descriptor is still the faithful model that port will consume.
//
// FAITHFUL to the real M33-SM address map -- it boots the actual
// V2N M33 Zephyr image (SRAM-linked at 0x08003000) headless.
//
// The M33-SM is a HEADLESS core in production: its board defconfig sets
// CONFIG_CONSOLE=n, and sci0 -- the EVK "Pmod USB-UART" header, not
// populated on the SoM -- is NOT wired as a CM33 console ("the only
// console is the A55's"; see the board .dts header for why: opening it
// enables RX onto a floating RXD pin, and the resulting receive-error
// interrupt escalates to a Zephyr fatal before main() runs on real
// silicon).  The `--sim-mode` gateway's designed path is unaffected by
// any of this: Zephyr's `ram_console` backend writes to a RAM ring
// buffer (`ram_console_buf`), which that gateway polls out of SRAM and
// streams to the studio UART socket.  That polling/streaming half is
// NOT ported yet (tan-cli#77) -- the Python `RamConsoleStreamer` went
// with the west command, so no such helper exists in any repo today;
// this paragraph describes the contract, not shipping code.
//
// sci0 IS modelled below (issue #1158): the plain (non --sim-mode)
// `tan renode` boot had NO observable console at all -- a sim gate that
// produces no output can't fail on anything the console would show.
// Renode never drives a floating-pin receive-error the way real
// silicon's unpopulated Pmod header does, so enabling sci0 is safe in
// simulation only; the production board .dts keeps it disabled, and a
// firmware build only reaches this model at all if it opts in via
// tests/renode/v2n_m33_sci0_console.overlay + .conf (mirrors the AEN
// M55 sim's own Renode-only overlay pattern).  Boots real firmware
// through it and prints the boot banner + app output -- verified
// against a real `alp_e1m_v2n101_m33_sm/r9a09g056n48gbg/cm33` hello_world
// build under Renode v1.16.1.
//
// The one bit of RZ/V2N IP that stock Renode v1.16.1 lacks and that the
// firmware needs to BOOT is the clock/reset + interrupt-monitor window
// (CPG/ICU at 0x4040_0000) -- a coarse Python stub whose CLKMON reads
// report "clock on" and whose RSTMON reads report "out of reset", so the
// FSP R_BSP_MODULE_START clock/reset handshakes complete.  It is not a
// cycle-faithful CPG; it is the minimum to let real firmware boot.
//
// Address provenance (all public):
//   - SRAM base/size: the M33-SM board devicetree
//     zephyr/boards/alp/e1m_v2n101_m33_sm/..._cm33.dts  (memory@8003000,
//     reg <0x08003000 0xfbfff>).
//   - iic8 (RIIC / BRD_I2C) base: r9a09g056.dtsi  i2c@41c01000,
//     compatible "renesas,rz-riic".  tmp112 sits on it at 0x48.
//   - CPG/ICU window base 0x40400000: r9a09g056.dtsi (rz-intc-v2 reg +
//     the CPG module-monitor registers the FSP BSP polls).
//   - sci0 base 0x42800c00 (M33-visible; NOT the A55-visible aperture,
//     which is a different address on this SoC): Zephyr's vendored SoC
//     dtsi arm/renesas/rz/rzv/r9a09g056.dtsi, sci0@42800c00, compatible
//     "renesas,rz-sci-b" / "renesas,rz-sci-b-uart" -- the same node the
//     M33-SM board .dts disables.  Register offsets (RDR/TDR/CCR0/CESR/
//     CSR/CFCLR) are R_SCI_B0_Type from the vendor FSP register header
//     (hal_renesas drivers/rz/fsp/src/rzv/bsp/cmsis/Device/RENESAS/
//     Include/R9A09G056N/iodefines/sci_b_iodefine.h).

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 200000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

// M33-SM SRAM.  The real bank is 0x08003000 + ~1 MiB (board dts:
// reg <0x08003000 0xfbfff>); rounded up to a page-aligned 1 MiB here.
// The firmware's ram_console_buf lives in this bank.
sram: Memory.MappedMemory @ sysbus 0x08003000
    size: 0x100000

// Coarse RZ/V2N clock/reset + interrupt-monitor stub (see header).
// CLKMON registers (local offset 0x800..0x9FF) read all-ones = "clock
// supplied"; everything else (incl. RSTMON at 0xA10) reads 0 =
// "out of reset" -- both are what R_BSP_MODULE_START polls for.
syscon: Python.PythonPeripheral @ sysbus 0x40400000
    size: 0x100000
    initable: true
    script: "request.Value = (0xFFFFFFFF if (0x800 <= (request.Offset & 0xFFFF) < 0xA00) else 0x0)"

// RIIC / BRD_I2C bus host + the tmp112 the studio descriptor drives.
// Named `i2c_tmp112`; reachable in the monitor as
// `sysbus.iic8.i2c_tmp112`.  TMP103 is a settable-`Temperature` I2C
// temperature-sensor model shipped with Renode, standing in for the
// TMP112 on the V2N X-EVK bus (0x48 = TMP112 ADD0=GND).
iic8: I2C.RenesasRA_IIC @ sysbus 0x41c01000

i2c_tmp112: Sensors.TMP103 @ iic8 0x48

// sci0 UART (issue #1158 -- see the header for scope/safety).  Coarse
// TX-only stub, same "not cycle-faithful, minimum to unblock the real
// driver" spirit as the syscon stub above: CESR always reports RIST=1/
// TIST=0 and CSR always reports TDRE/TEND ready, so R_SCI_B_UART_Open()
// and uart_rz_sci_poll_out() (zephyr/drivers/serial/uart_renesas_rz_sci.c)
// never block; RX, baud generation, interrupts and errors are not
// modelled. Renode's stock UART classes aren't register-compatible with
// this Renesas SCI-B IP (Renode ships a SCIFA model for the older RZ/G2L
// SCI family, a different register layout), and a Python peripheral
// can't implement IUART for `showAnalyzer` -- so TDR writes are instead
// line-buffered and flushed to the Renode log on '\n' via self.Log,
// which is visible on stdout the same way `showAnalyzer` output is under
// `--console` (confirmed: both are plain Renode INFO log lines).
sci0: Python.PythonPeripheral @ sysbus 0x42800c00
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    line = ""

if request.IsWrite:
    if request.Offset == 0x04:
        # TDR (TDAT[8:0], offset 0x04).
        b = request.Value & 0xFF
        if b == 0x0A:
            self.Log(LogLevel.Info, "sci0 TX: %s" % line)
            line = ""
        elif b != 0x0D:
            line += chr(b) if 0x20 <= b < 0x7F else "?"
    request.Value = 0
elif request.IsRead:
    if request.Offset == 0x48:
        # CSR (offset 0x48): TDRE = bit29, TEND = bit30 -- always ready.
        request.Value = (1 << 29) | (1 << 30)
    elif request.Offset == 0x1C:
        # CESR (offset 0x1C, 1 byte): RIST = bit0 (always 1), TIST =
        # bit4 (always 0) -- satisfies both R_SCI_B_UART_Open()'s wait
        # for RIST==1 and the close/other paths' wait for TIST==0.
        request.Value = 0x1
    else:
        request.Value = 0
'''
