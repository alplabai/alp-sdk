{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alplabai/alp-sdk/metadata/schemas/core-ownership-v1.schema.json",
  "title": "SoM-family AMP core ownership (core-ownership.yaml)",
  "description": "Alp Lab policy for which core drives a SoM-family pad. `core_ownership` = FIXED facts (cited rows keyed by (peripheral, pad)); `assignable` = per-product choices keyed by E1M instance (a project overrides the default with board.yaml `ownership:`); `a55_only_resources` = resources with no pinmux row. Row references are validated against metadata/pinmux by scripts/validate_metadata.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["core_ownership"],
  "$defs": {
    "core": { "type": "string", "enum": ["a55", "m33"] },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peripheral", "pad"],
      "properties": {
        "peripheral": { "type": "string", "minLength": 1 },
        "pad": { "type": "string", "minLength": 1 },
        "pfc_port": { "type": "string", "pattern": "^PORT_[0-9A-F]{2}$", "description": "RZ/V2N PFC port of the pad, e.g. PORT_05 for P50.  Optional: absent until the PFC function is cited from the hardware manual -- no generator guesses it." },
        "pfc_pin": { "type": "integer", "minimum": 0, "maximum": 7 },
        "pfc_func": { "type": "integer", "minimum": 0, "maximum": 15 }
      },
      "dependentRequired": { "pfc_port": ["pfc_pin", "pfc_func"], "pfc_pin": ["pfc_port", "pfc_func"], "pfc_func": ["pfc_port", "pfc_pin"] }
    }
  },
  "properties": {
    "core_ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["peripheral", "pad", "core", "evidence"],
        "properties": {
          "peripheral": { "type": "string", "minLength": 1 },
          "pad": { "type": "string", "minLength": 1 },
          "core": { "$ref": "#/$defs/core" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assignable": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["default", "candidates", "rows"],
        "properties": {
          "default": { "$ref": "#/$defs/core" },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "Only cores with a real backend today.",
            "items": { "$ref": "#/$defs/core" }
          },
          "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
          "note": { "type": "string" },
          "m33": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dt_label", "alias", "pinctrl"],
            "description": "Zephyr (Cortex-M33) devicetree facts for this instance; present only when the SoC dtsi already carries the node and every row has a pfc_* triple.  gen_zephyr_board.py emits the node `disabled` + the pinctrl group from this; a project that assigns the instance to m33 gets `okay` + the alias + `kconfig` from `--emit dts-overlay` / `zephyr-conf`.",
            "properties": {
              "dt_label": { "type": "string", "minLength": 1 },
              "alias": { "type": "string", "pattern": "^alp-[a-z0-9-]+$" },
              "kconfig": { "type": "array", "items": { "type": "string", "pattern": "^CONFIG_[A-Z0-9_]+=.+$" } },
              "pinctrl": {
                "type": "object",
                "additionalProperties": false,
                "required": ["group_label", "node", "child_node"],
                "properties": {
                  "group_label": { "type": "string", "minLength": 1 },
                  "node": { "type": "string", "minLength": 1 },
                  "child_node": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "a55_only_resources": { "type": "array", "items": { "type": "object" } }
  }
}
