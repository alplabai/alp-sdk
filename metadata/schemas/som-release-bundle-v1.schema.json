{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alplabai/alp-sdk/metadata/schemas/som-release-bundle-v1.schema.json",
  "title": "ALP SoM Release Bundle Manifest v1",
  "description": "Public contract for a versioned per-SKU SoM-release bundle ({bl2, fip, system image}). The bundle (binaries + this manifest instance) is a private production artifact in alp-sdk-internal; this schema is public because it is the producer->consumer contract the provisioning tool (Piece 4) validates against. Every field is public-safe by construction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sku", "family", "hw_rev", "release_version", "created", "status", "components", "provenance"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "sku": { "type": "string", "pattern": "^E1M-(AEN|V2N|V2M|NX9)\\d{3}$" },
    "family": { "type": "string", "enum": ["aen", "v2n", "v2n-m1", "imx93"] },
    "hw_rev": { "type": "string", "minLength": 1 },
    "release_version": { "type": "string", "pattern": "^som-\\d+\\.\\d+\\.\\d+$" },
    "created": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["complete", "bootloader-only:image-pending-hw"] },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "file", "sha256", "size_bytes", "flash_target"],
        "properties": {
          "role": { "type": "string", "enum": ["bl2", "bl2_mmc", "fip", "system_image", "system_image_bmap", "cm33", "dxm1_fw", "dxm1_fw_uart_boot", "dxm1_dxflash", "dxm1_dtb", "dxm1_dxcli"] },
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "flash_target": { "type": "string", "enum": ["xspi:mtd0", "xspi:mtd1", "emmc", "emmc:boot1", "dxm1"] },
          "version": { "type": "string", "minLength": 1, "description": "Optional. The firmware release this file carries; required on the dxm1_fw role, which the dxm1_npu_flash step verifies against the DX-M1 (dxrt-cli -s)." }
        },
        "description": "system_image_bmap (optional) is the .wic.bmap of the system_image: when present, the V2N flow writes and verifies only the mapped ranges; flash_target emmc, never flashed on its own. cm33 (optional) is the CM33 firmware as BL2 loads it: the stored, PADDED image -- 0x3000 zero bytes followed by Zephyr's zephyr.bin, at most 0x30000 bytes in all -- flash_target xspi:mtd1, written at mtd1 offset 0x1a0000 (xSPI byte 0x200000); BL2 copies it raw to SRAM 0x08000000 and the CM33 starts at 0x08003000. Size and md5 checks apply to exactly these bytes; nothing verifies the image at boot. bl2_mmc is the eMMC-boot BL2 (bl2_bp_mmc) and is the only role flashed to emmc:boot1. The optional dxm1_* roles (V2M, v2n-m1 only) carry the license-gated DX-M1 NPU programming set -- dxm1_fw (application firmware), dxm1_fw_uart_boot (UART bootloader stage), dxm1_dxflash (the dxflash.py helper), dxm1_dtb (the dxuart2 device tree), dxm1_dxcli (dxcli.py, only to erase a NAND that already holds boot2nd) -- flash_target dxm1; the binaries live only in the private bundle, this schema is the public contract.",
        "if": { "properties": { "role": { "const": "bl2_mmc" } }, "required": ["role"] },
        "then": { "properties": { "flash_target": { "const": "emmc:boot1" } } },
        "else": { "properties": { "flash_target": { "not": { "const": "emmc:boot1" } } } },
        "allOf": [
          { "if": { "properties": { "role": { "const": "system_image_bmap" } }, "required": ["role"] },
            "then": { "properties": { "flash_target": { "const": "emmc" } } } },
          { "if": { "properties": { "role": { "const": "cm33" } }, "required": ["role"] },
            "then": { "properties": { "flash_target": { "const": "xspi:mtd1" } } } },
          { "if": { "properties": { "role": { "const": "dxm1_fw" } }, "required": ["role"] },
            "then": { "required": ["version"] } }
        ]
      },
      "allOf": [
        { "contains": { "type": "object", "properties": { "role": { "const": "bl2" } }, "required": ["role"] } },
        { "contains": { "type": "object", "properties": { "role": { "const": "fip" } }, "required": ["role"] } }
      ]
    },
    "memory_tier": {
      "description": "Optional. The DRAM tier the BL2 images in this bundle were built for; one leg of the provisioning DDR tier check. label names the tier (two tiers can share one dram_mbit, so only the label tells them apart).",
      "type": "object",
      "additionalProperties": false,
      "required": ["dram_mbit"],
      "properties": {
        "dram_mbit": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "pattern": "^[A-Za-z0-9]+$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain", "u_boot_srcrev", "tf_a_srcrev", "uboot_defconfig", "patches", "equivalence"],
      "properties": {
        "toolchain": { "type": "string" },
        "u_boot_srcrev": { "type": "string" },
        "tf_a_srcrev": { "type": "string" },
        "uboot_defconfig": { "type": "string" },
        "patches": { "type": "array", "items": { "type": "string" } },
        "equivalence": { "type": "string" },
        "equivalence_ref": { "type": "string" }
      }
    },
    "provenance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signature": {
      "description": "ECDSA-P256 provenance signature (null until signed).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format_version", "algorithm", "key_id", "signed_at", "value"],
          "properties": {
            "format_version": { "const": 1 },
            "algorithm": { "const": "ecdsa-p256-sha256" },
            "key_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
            "signed_at": { "type": "string", "format": "date" },
            "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
          }
        }
      ]
    }
  },
  "if": { "required": ["status"], "properties": { "status": { "const": "complete" } } },
  "then": {
    "properties": {
      "components": {
        "contains": { "type": "object", "properties": { "role": { "const": "system_image" } }, "required": ["role"] }
      }
    }
  }
}
