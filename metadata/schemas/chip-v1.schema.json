{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alplabai/alp-sdk/metadata/schemas/chip-v1.schema.json",
  "title": "alp-sdk chip manifest (v1)",
  "description": "Per-chip manifest under metadata/chips/<part>.yaml. Physical block optional; when present it feeds the carrier netlist + BOM (alp-studio#65).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chip_id", "display_name", "vendor", "mpn_population", "datasheet", "bus", "kconfig", "families", "verification"],
  "$defs": {
    "rail_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slave", "kind", "status_reg", "vset0_reg", "vset_mask", "dvs_regs", "enable_reg", "enable_bit", "range_reg", "range_bit", "ranges", "abs_min_mv", "abs_max_mv"],
      "properties": {
        "id": { "type": "string" }, "slave": { "type": "string" }, "kind": { "type": "string" }, "notes": { "type": "string" },
        "status_reg": { "type": "integer", "minimum": 0 }, "vset0_reg": { "type": "integer", "minimum": 0 }, "vset_mask": { "type": "integer", "minimum": 0 },
        "dvs_regs": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "enable_reg": { "type": "integer", "minimum": 0 }, "enable_bit": { "type": "integer", "minimum": 0 },
        "range_reg": { "type": ["integer", "null"], "minimum": 0 }, "range_bit": { "type": ["integer", "null"], "minimum": 0 },
        "ranges": { "type": "array" },
        "abs_min_mv": { "type": "number" }, "abs_max_mv": { "type": "number" }
      }
    },
    "channel_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "abs_min_mv", "abs_max_mv", "step_mv"],
      "properties": {
        "id": { "type": "string" }, "phases": { "type": "array" }, "role_v2n": { "type": "string" }, "role_v2n_m1": { "type": "string" }, "voltage_range": { "type": "string" },
        "ctrl_reg": { "type": "integer", "minimum": 0 }, "en_bit": { "type": "integer", "minimum": 0 }, "vsel_bit": { "type": "integer", "minimum": 0 }, "dis_pd_bit": { "type": "integer", "minimum": 0 }, "vstep_bit": { "type": "integer", "minimum": 0 },
        "vsel_lo_reg": { "type": "integer", "minimum": 0 }, "vsel_hi_reg": { "type": "integer", "minimum": 0 }, "vout_reg": { "type": "integer", "minimum": 0 },
        "abs_min_mv": { "type": "number" }, "abs_max_mv": { "type": "number" },
        "step_mv": { "type": "number" }, "base_mv": { "type": "number" }
      }
    },
    "register_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" }, "type": { "type": "string" }, "summary": { "type": "string" }, "slave": { "type": "string" },
        "addr": { "type": "integer", "minimum": 0 }, "addr_range": { "type": "array" }, "default": {},
        "write": { "enum": ["allow", "guarded", "deny"] }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "chip_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "display_name": { "type": "string" },
    "driver_status": { "type": "string" },
    "vendor": { "type": "string" },
    "mpn_population": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "datasheet": { "type": "object" },
    "bus": { "type": "string" },
    "i2c": { "type": "object" },
    "spi": { "type": "object" },
    "uart": { "type": "object" },
    "kconfig": { "type": "object" },
    "families": { "type": "array" },
    "verification": { "type": "object" },
    "resolutions": { "type": "object" },
    "peripherals": { "type": "object" },
    "sensor": { "type": "object" },
    "mipi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lanes_supported"],
      "description": "MIPI interface capability of the part.  `lanes_supported` lists the data-lane counts the silicon can run; `role` is the direction the part drives (`csi2_tx` = a CSI-2 transmitter such as a camera sensor, `dsi_rx` = a DSI receiver such as a display controller).",
      "properties": {
        "lanes_supported": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "role": { "enum": ["csi2_tx", "dsi_rx"] }
      }
    },
    "drivers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-OS driver binding facts for the part, consumed by the camera DT/overlay generators.  Only facts that are sourced in-tree belong here; an OS with no known driver is simply absent.",
      "properties": {
        "zephyr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compatible"],
          "properties": {
            "compatible": { "type": "string", "pattern": "^[a-z0-9]+,[a-z0-9._-]+$", "description": "Zephyr devicetree compatible string." },
            "endpoint_flags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "Boolean properties the Zephyr driver's binding wants on the sensor's `port/endpoint` node (e.g. `no-lp11-clock-lane-park`).  A sensor property, so it lives on the chip; host-controller properties live in the camera module's `zephyr_host_overrides`." }
          }
        },
        "linux": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compatible"],
          "properties": {
            "compatible": { "type": "string", "pattern": "^[a-z0-9]+,[a-z0-9._-]+$", "description": "Linux devicetree compatible string the in-kernel driver matches (may differ from the part number, e.g. OV9281 probes as ovti,ov9282)." },
            "kconfig": { "type": "string", "pattern": "^CONFIG_[A-Z0-9_]+$", "description": "Kernel config symbol that builds the driver." },
            "link_freqs": {
              "type": "array",
              "minItems": 1,
              "description": "CSI-2 link frequencies the Linux driver accepts on its endpoint, per data-lane count (the accepted rate can depend on the lane count).  Omit when the driver parses no `link-frequencies`.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lanes", "link_freqs_hz"],
                "properties": {
                  "lanes": { "type": "integer", "minimum": 1, "maximum": 4 },
                  "link_freqs_hz": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
                }
              }
            },
            "supplies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }, "description": "Regulator supply names the driver requests (`<name>-supply` DT properties), spelled exactly as in the driver (some use upper case)." },
            "clock_name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "description": "`clock-names` entry the driver passes to devm_clk_get().  Omit when the driver asks for the unnamed clock." },
            "reset_property": { "enum": ["reset-gpios", "pwdn-gpios"], "description": "GPIO property the driver reads for its reset / power-down line." },
            "endpoint_flags": { "type": "array", "uniqueItems": true, "items": { "enum": ["clock-noncontinuous"] }, "description": "Boolean properties the sensor's `port/endpoint` node needs for the driver to behave as bench-proven." },
            "xclk_supported_hz": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 }, "description": "Input-clock rates the driver accepts; a camera module's `xclk_hz` must be one of them." }
          }
        }
      }
    },
    "precision": { "type": "object" },
    "notes": { "type": "string" },
    "audio": { "type": "object" },
    "motor": { "type": "object" },
    "ranging": { "type": "object" },
    "gnss": { "type": "object" },
    "formats": { "type": "array" },
    "cellular": { "type": "object" },
    "encoder": { "type": "object" },
    "protocol": { "type": "object" },
    "register_table": { "type": "array", "items": { "$ref": "#/$defs/register_item" } },
    "interconnect": { "type": "object" },
    "rails": { "type": "array", "items": { "$ref": "#/$defs/rail_item" } },
    "crypto": { "type": "object" },
    "operation_mode": { "type": "string" },
    "channels": { "type": "array", "items": { "$ref": "#/$defs/channel_item" } },
    "control_lines": { "type": "array" },
    "upstream": { "type": "object" },
    "license": { "type": "string" },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue": { "type": ["integer", "string"], "pattern": "^#?[0-9]+$" },
        "blocker": { "type": "string" }
      }
    },
    "dependencies": { "type": "array" },
    "capacity": { "type": "object" },
    "pwm_routing": { "type": "object" },
    "pcie": { "type": "object" },
    "adc": { "type": "object" },
    "monitoring": { "type": "object" },
    "silicon_under_lid": { "type": "array" },
    "side_channel_lines": { "type": "array" },
    "bulk_traffic_lines": { "type": "array" },
    "capabilities": { "type": "object" },
    "gpios": { "type": "object" },
    "instances_per_lane": { "type": "integer" },
    "v2n_m1_path_mapping": { "type": "object" },
    "features": { "type": "array" },
    "mdio": { "type": "object" },
    "oui": { "type": "integer" },
    "phy_id_pattern": { "type": "integer" },
    "firmware_banner_regex": { "type": "string" },
    "instances_per_v2n": { "type": "integer" },
    "instances": { "type": "array" },
    "power": { "type": "object" },
    "slave_address_range": { "type": "string" },
    "radio": { "type": "object" },
    "host_interfaces": { "type": "object" },
    "signals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["input", "output", "bidir", "power", "ground", "analog", "open_drain", "open_drain_output"] },
          "scope": { "type": "string" },
          "v2n_route": { "type": "string" },
          "notes": { "type": "string" },
          "direction": { "type": "string" },
          "role": { "type": "string" },
          "route": { "type": "string" },
          "aen_route": { "type": "string" }
        }
      }
    },
    "physical": {
      "type": "object", "additionalProperties": false,
      "if": { "required": ["pins"] },
      "then": { "required": ["refdes_prefix", "package", "footprint", "pins", "visibility", "provenance"] },
      "properties": {
        "refdes_prefix": { "type": "string", "pattern": "^[A-Z]+$" },
        "package": { "type": "string" },
        "footprint": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "visibility": { "type": "string", "enum": ["public", "internal"] },
        "provenance": { "type": "string", "enum": ["datasheet_confirmed", "web_provisional", "internal_netlist"], "description": "Trust level of the pad/footprint data. web_provisional = transcribed from a public datasheet found online, pending maintainer confirmation." },
        "dimension_mm": { "type": "string" },
        "antenna": { "type": "string" },
        "operating_temp_deg_c": { "type": "string" },
        "pins": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["pad", "signal"],
            "properties": { "pad": { "type": "string" }, "signal": { "type": "string" } }
          }
        },
        "passives": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "value", "net", "refdes_prefix"],
            "properties": {
              "role": { "type": "string", "enum": ["decouple", "pullup", "pulldown", "series", "bulk", "level_shift"] },
              "value": { "type": "string" }, "net": { "type": "string" },
              "refdes_prefix": { "type": "string", "pattern": "^[A-Z]+$" }
            }
          }
        }
      }
    }
  }
}
