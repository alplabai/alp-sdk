/*
 * Copyright 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * native_sim already instantiates an enabled `counter0` node
 * (boards/native/native_sim/native_sim.dts, "zephyr,native-sim-counter")
 * -- point the alp-counter0 alias at it so the zephyr_drv backend's
 * z_open() resolves a real (emulated) counter device instead of the
 * NULL it gets on an unaliased build.  This lets tests exercise the
 * alarm-arm/close/reopen lifecycle (#1627) against the real backend,
 * not just the sw_fallback stub.
 */
/ {
	aliases {
		alp-counter0 = &counter0;
	};
};
