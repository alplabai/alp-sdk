 *
 * Host-emulated alp,pin-array for gpio_cc3501e_rev_guard under native_sim,
 * so the platform-delegate path (alp_z_gpio_open_owned) has a real DT node
 * to resolve against for the "guard confirmed / revision-independent pin"
 * cases (issue #2144), the same known-bad-validation trap #1854 already
 * flagged for cc3501e_gpio_unrouted: without this node, delegating a
 * pin_id on bare native_sim returns ALP_ERR_INVAL (no alp,pin-array at
 * all), which would make a passing open fail for the WRONG reason and mask
 * whether the per-pin guard is what let it through.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	gpio_emul0: gpio_emul0 {
		compatible = "zephyr,gpio-emul";
		status = "okay";
		gpio-controller;
		rising-edge;
		falling-edge;
		#gpio-cells = <2>;
		ngpios = <22>;
	};

	alp_pins: alp-pins {
		compatible = "alp,pin-array";
		gpios = <&gpio_emul0 0 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 1 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 2 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 3 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 4 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 5 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 6 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 7 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 8 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 9 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 10 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 11 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 12 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 13 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 14 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 15 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 16 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 17 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 18 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 19 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 20 GPIO_ACTIVE_HIGH>,
			<&gpio_emul0 21 GPIO_ACTIVE_HIGH>;
	};
};
