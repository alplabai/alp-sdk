/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Application overlay for testing driver builds -- see testcase.yaml.
 * Names chosen not to conflict with real-world devicetree nodes, mirroring
 * upstream's tests/drivers/build_all/video/app.overlay convention.
 *
 * OV9281, OV5647 and IMX296 all sit on native_sim's real I2C emulation bus (&i2c0,
 * "zephyr,i2c-emul-controller" -- see boards/native/native_sim/native_sim.dts), where
 * ov9281_emul.c's EMUL_DT_INST_DEFINE(ovti_ov9281), ov5647_emul.c's
 * EMUL_DT_INST_DEFINE(ovti_ov5647) and imx296_emul.c's EMUL_DT_INST_DEFINE(sony_imx296) answer
 * them at runtime -- see ov9281_test.c / ov5647_test.c / imx296_test.c.
 */

/ {
	ov5647_input_clock: ov5647-input-clock {
		compatible = "fixed-clock";
		clock-frequency = <25000000>;
		#clock-cells = <0>;
	};

	ov9281_input_clock: ov9281-input-clock {
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		#clock-cells = <0>;
	};

	imx296_input_clock: imx296-input-clock {
		compatible = "fixed-clock";
		/* 54 MHz: the Raspberry Pi Global Shutter Camera module's own oscillator -- one
		 * of the three INCK frequencies imx296.c's imx296_inck_table[] supports. */
		clock-frequency = <54000000>;
		#clock-cells = <0>;
	};
};

&i2c0 {
	status = "okay";

	ov5647_test: ov5647@36 {
		compatible = "ovti,ov5647";
		reg = <0x36>;
		clocks = <&ov5647_input_clock>;
		status = "okay";

		port {
			ov5647_test_ep: endpoint {
				remote-endpoint-label = "";
				data-lanes = <1 2>;
			};
		};
	};

	ov9281_test: ov9281@60 {
		compatible = "ovti,ov9281";
		reg = <0x60>;
		clocks = <&ov9281_input_clock>;
		status = "okay";

		port {
			ov9281_test_ep: endpoint {
				remote-endpoint-label = "";
				data-lanes = <1 2>;
			};
		};
	};

	imx296_test: imx296@1a {
		compatible = "sony,imx296";
		reg = <0x1a>;
		clocks = <&imx296_input_clock>;
		status = "okay";

		port {
			imx296_test_ep: endpoint {
				remote-endpoint-label = "";
				/* IMX296 is a single-lane part, unlike its OV5647/OV9281
				 * siblings above -- see the BUILD_ASSERT in imx296.c. */
				data-lanes = <1>;
			};
		};
	};

	/* Second instance at a distinct CCI address, purely to give
	 * imx296_test.c a device whose emulator seeds a WRONG SENSOR_INFO
	 * (imx296_emul.c matches this node by its reg address) -- exercises
	 * imx296_init()'s identity-mismatch -ENODEV path, which the real
	 * imx296_test node above (seeded with the bench-confirmed signature)
	 * cannot reach.
	 */
	imx296_bad_id_test: imx296@1b {
		compatible = "sony,imx296";
		reg = <0x1b>;
		clocks = <&imx296_input_clock>;
		status = "okay";

		port {
			imx296_bad_id_test_ep: endpoint {
				remote-endpoint-label = "";
				data-lanes = <1>;
			};
		};
	};
};
