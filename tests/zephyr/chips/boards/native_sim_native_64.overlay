/*
 * Copyright 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * Overlay for the alp-sdk chips ztest under native_sim_64.
 *
 * Wires one emulated I2C bus (alp_i2c0) for the lsm6dso / ssd1306
 * smoke tests, and an emulated GPIO controller backing two pins
 * for the button_led helper.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    aliases {
        alp-i2c0  = &i2c0_emul;
    };

    /* native_sim's /soc has #address-cells=2, #size-cells=1. */
    soc {
        i2c0_emul: i2c@100 {
            compatible = "zephyr,i2c-emul-controller";
            status = "okay";
            reg = <0 0x100 4>;
            #address-cells = <1>;
            #size-cells = <0>;
            clock-frequency = <I2C_BITRATE_STANDARD>;

            /* Fake i2c-emul targets at chip-default addresses stay
             * commented out by maintainer decision (commit 4b0b33d5):
             * chip register-protocol validation happens on real
             * silicon via examples/v2n/v2n-brd-i2c-bringup, not against
             * these doubles (see CHANGELOG.md, "Removed -- chips:
             * fake-based register tests").  The fake-using ZTESTs are
             * gated on DT_NODE_EXISTS so they no-op cleanly while the
             * fake_* nodes below stay commented out.
             *
             * fake_lsm6dso: fake_lsm6dso@6a {
             *     compatible = "alp,fake-lsm6dso";
             *     reg = <0x6a>;
             * };
             * fake_ssd1306: fake_ssd1306@3c {
             *     compatible = "alp,fake-ssd1306";
             *     reg = <0x3c>;
             * };
             * fake_bme280: fake_bme280@76 {
             *     compatible = "alp,fake-bme280";
             *     reg = <0x76>;
             * };
             */

            /* Fake targets for the 2026-09 chip-driver session's new
             * register-protocol coverage (rv3028c7, tcal9538,
             * icm42670, bmi323, bmp581, ina236, tas2563) -- unlike the
             * lsm6dso/ssd1306/bme280 fakes above, these stay ACTIVE:
             * there is no real-silicon substitute test for these
             * functions yet (see tests/zephyr/chips/src/fake_*.c file
             * headers). */
            fake_rv3028c7: fake_rv3028c7@52 {
                compatible = "alp,fake-rv3028c7";
                reg = <0x52>;
            };
            fake_tcal9538_main: fake_tcal9538_main@73 {
                compatible = "alp,fake-tcal9538";
                reg = <0x73>;
            };
            fake_tcal9538_alt: fake_tcal9538_alt@20 {
                compatible = "alp,fake-tcal9538";
                reg = <0x20>;
            };
            fake_icm42670: fake_icm42670@68 {
                compatible = "alp,fake-icm42670";
                reg = <0x68>;
            };
            fake_bmi323: fake_bmi323@69 {
                compatible = "alp,fake-bmi323";
                reg = <0x69>;
            };
            fake_bmp581: fake_bmp581@46 {
                compatible = "alp,fake-bmp581";
                reg = <0x46>;
            };
            fake_ina236: fake_ina236@40 {
                compatible = "alp,fake-ina236";
                reg = <0x40>;
            };
            /* 0x4D = the AD0/SPICLK "10k to GND" strap (SLASET3D
             * Table 7-3, p.30), which is U27 on the E1M-X EVK.  One
             * instance is enough: nothing this driver does is
             * per-instance stateful across two amps. */
            fake_tas2563: fake_tas2563@4d {
                compatible = "alp,fake-tas2563";
                reg = <0x4d>;
            };
            /* V2N power tree (BRD_I2C on silicon): ACT88760 ADD1/ADD2
             * share one register image; DA9292 at its OTP address; the
             * V2N-M1 TPS628640 bucks except 0x4D (fake_tas2563 above
             * holds it).  0x25 is also PCA9451A_I2C_ADDR, so the
             * pca9451a probe smoke now ACKs and takes its skip branch. */
            fake_act8760_add1: fake_act8760@25 {
                compatible = "alp,fake-act8760";
                reg = <0x25>;
            };
            fake_act8760_add2: fake_act8760@26 {
                compatible = "alp,fake-act8760";
                reg = <0x26>;
            };
            fake_da9292: fake_da9292@1e {
                compatible = "alp,fake-da9292";
                reg = <0x1e>;
            };
            fake_tps628640_44: fake_tps628640@44 {
                compatible = "alp,fake-tps628640";
                reg = <0x44>;
            };
            fake_tps628640_48: fake_tps628640@48 {
                compatible = "alp,fake-tps628640";
                reg = <0x48>;
            };
            fake_tps628640_4f: fake_tps628640@4f {
                compatible = "alp,fake-tps628640";
                reg = <0x4f>;
            };
            /* 0x6A: strap_field 2 of the 0x68..0x6B clk_5l35023b range
             * (0x68/0x69/0x6D unused here, and 0x69 is fake_bmi323
             * above) -- clk_5l35023b_register_dump()'s one-transaction-
             * per-register proof. */
            fake_clk_5l35023b: fake_clk_5l35023b@6a {
                compatible = "alp,fake-clk_5l35023b";
                reg = <0x6a>;
            };
        };
    };

    gpio_emul0: gpio_emul0 {
        compatible = "zephyr,gpio-emul";
        status = "okay";
        gpio-controller;
        rising-edge;
        falling-edge;
        #gpio-cells = <2>;
        ngpios = <8>;
    };

    /* Pin ids passed to alp_gpio_open(): 0 = button (with pull-up),
     * 1 = LED, 2 = TAS2563 IRQ_N (AMP.FAULT), 3 = TAS2563 SD_N
     * (AMP.ENABLE).  Pins 2 and 3 are declared ACTIVE_HIGH so the
     * test drives raw levels and the DRIVER owns the active-low
     * interpretation of IRQ_N -- inverting in the overlay instead
     * would hide exactly the polarity bug the test is there to
     * catch.  Pins 4..6 = the DA9292 CH2 sequence's DEEPX_PWR_EN_REQ
     * (P65, input), DEEPX_CORE_0P75_EN (P64) and M1_RESET (PA6). */
    alp_pins: alp-pins {
        compatible = "alp,pin-array";
        gpios = <&gpio_emul0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                <&gpio_emul0 1 GPIO_ACTIVE_HIGH>,
                <&gpio_emul0 2 GPIO_ACTIVE_HIGH>,
                <&gpio_emul0 3 GPIO_ACTIVE_HIGH>,
                <&gpio_emul0 4 GPIO_ACTIVE_HIGH>,
                <&gpio_emul0 5 GPIO_ACTIVE_HIGH>,
                <&gpio_emul0 6 GPIO_ACTIVE_HIGH>;
    };
};
