        {
          "path": "build/m33_sm-zephyr/alp.conf",
          "contents": "# Auto-generated by scripts/alp_orchestrate.py -- do not edit.\n# Per-core Kconfig fragment for slice `m33_sm` (zephyr).\n\nCONFIG_ALP_SDK=y\nCONFIG_LOG=y\nCONFIG_PRINTK=y\nCONFIG_THREAD_LOCAL_STORAGE=y\nCONFIG_LOG_DEFAULT_LEVEL=3\n\n# Boot-banner SoC identity + system summary (from the SoC spec JSON + SoM preset `memory:`; see alp_banner.c).\nCONFIG_ALP_SDK_SOC_NAME=\"Renesas RZ/V2N R9A09G056N44GBG\"\nCONFIG_ALP_SDK_SOC_CPUS=\"Cortex-M33 @200MHz (active)|cm33 + 4x Cortex-A55 @1800MHz\"\nCONFIG_ALP_SDK_SOC_NPUS=\"Drp-Ai\"\nCONFIG_ALP_SDK_SOC_SRAM_KB=1536\nCONFIG_ALP_SDK_SOM_DRAM_MBIT=32768\nCONFIG_ALP_SDK_SOM_FLASH_MBIT=32768\n\n# On-module HW manifest EEPROM -> portable bus 0 (alp-i2c0);\n# enables alp_hw_info_read() + the console banner manifest line.\nCONFIG_ALP_SDK_HW_INFO_EEPROM_I2C_BUS_ID=0\n\nCONFIG_ALP_SDK_SOM_HW_REV=\"2625-r1\"\n\n# SoM silicon (renesas:rzv2n:n44 via E1M-V2N101)\nCONFIG_ALP_SOC_RENESAS_RZV2N_N44=y\n\n# Cross-EVK board facade selector (<alp/board.h>); CONFIG_COMPILER_OPT is single-value (do not also set in prj.conf).\nCONFIG_COMPILER_OPT=\"-DALP_BOARD_E1M_X_EVK\"\n\n# SoM-intrinsic chip drivers (from `E1M-V2N101` on_module + helper_firmware)\nCONFIG_ALP_SDK_CHIP_ACT8760=y\nCONFIG_ALP_SDK_CHIP_CLK_5L35023B=y\nCONFIG_ALP_SDK_CHIP_DA9292=y\nCONFIG_ALP_SDK_CHIP_EEPROM_24C128=y\nCONFIG_ALP_SDK_CHIP_GD32G553=y\nCONFIG_ALP_SDK_CHIP_MURATA_LBEE5HY2FY=y\nCONFIG_ALP_SDK_CHIP_OPTIGA_TRUST_M=y\nCONFIG_ALP_SDK_CHIP_RTL8211FDI=y\nCONFIG_ALP_SDK_CHIP_RV3028C7=y\nCONFIG_ALP_SDK_CHIP_TMP112=y\n\n# Board-populated chip drivers (from the resolved board definition)\nCONFIG_ALP_SDK_CHIP_BME280=n\nCONFIG_ALP_SDK_CHIP_BMI323=y\nCONFIG_ALP_SDK_CHIP_BMP581=y\nCONFIG_ALP_SDK_BLOCK_BUTTON_LED=y\nCONFIG_ALP_SDK_CHIP_CAM_MUX_PI3WVR626=n\nCONFIG_ALP_SDK_CHIP_ICM42670=y\nCONFIG_ALP_SDK_CHIP_INA228=y\nCONFIG_ALP_SDK_CHIP_INA236=y\nCONFIG_ALP_SDK_CHIP_LIS2DW12=n\nCONFIG_ALP_SDK_CHIP_LSM6DSO=n\nCONFIG_ALP_SDK_CHIP_OV5640=n\nCONFIG_ALP_SDK_BLOCK_PDM_MIC=y\nCONFIG_ALP_SDK_CHIP_SSD1306=n\nCONFIG_ALP_SDK_CHIP_SSD1331=n\nCONFIG_ALP_SDK_CHIP_TAS2563=y\nCONFIG_ALP_SDK_CHIP_TCAL9538=y\n\n# Zephyr subsystems required on core `m33_sm` (chip drivers + peripherals)\nCONFIG_ADC=y\nCONFIG_GPIO=y\nCONFIG_I2C=y\nCONFIG_SPI=y\n\n# Libraries declared on core `m33_sm`\nCONFIG_CMSIS_DSP=y\nCONFIG_CMSIS_DSP_BASICMATH=y\nCONFIG_CMSIS_DSP_COMPLEXMATH=y\nCONFIG_CMSIS_DSP_CONTROLLER=y\nCONFIG_CMSIS_DSP_FASTMATH=y\nCONFIG_CMSIS_DSP_FILTERING=y\nCONFIG_CMSIS_DSP_INTERPOLATION=y\nCONFIG_CMSIS_DSP_MATRIX=y\nCONFIG_CMSIS_DSP_STATISTICS=y\nCONFIG_CMSIS_DSP_SUPPORT=y\nCONFIG_CMSIS_DSP_TRANSFORM=y\nCONFIG_ALP_CMSIS_DSP_SCALAR=y\n\n# \u00a7D.lib.loader -- per-library HW-accelerator wiring (auto-emitted).\nCONFIG_ALP_CMSIS_DSP_NEON=y  # cmsis_dsp / simd\nCONFIG_ALP_CMSIS_DSP_TMU_CORDIC=y  # cmsis_dsp / cordic\nCONFIG_ALP_CMSIS_DSP_TMU_FFT=y  # cmsis_dsp / fft\nCONFIG_ALP_CMSIS_DSP_ADC_DMA=y  # cmsis_dsp / dma\n\n# board.yaml ipc[].kind: raw_shmem or rpmsg names this core as\n# an endpoint with no explicit cacheable: true opt-out.\n# <alp/mproc.h> (raw_shmem) and <alp/rpc.h> (rpmsg) both have no\n# cache-maintenance layer, so the D-cache must stay off (not\n# just the carve-out's own region) for both sides to see each\n# other's writes without explicit clean/invalidate (PR #1080,\n# #1088).\nCONFIG_DCACHE=n\n\n"
        },
        {
          "path": "build/m33_sm-zephyr/alp.overlay",
          "contents": "/*\n * Auto-generated by scripts/alp_project.py -- do not edit by hand.\n * Regenerate after changes to board.yaml or include/alp/boards/<board>.h.\n *\n * Per-pad GPIO bank/index values are TBD; cross-reference the in-tree\n * board file at zephyr/boards/alp/<board>/*.dts (zephyr/module.yml board_root).\n * The alp,pin-array below is the full 52-entry positional map in\n * e1m_pinout.h canonical order; fill the <&gpioX Y FLAGS> columns\n * in place without renumbering (the positional index is the ABI).\n */\n\n#include <zephyr/dt-bindings/gpio/gpio.h>\n\n/ {\n    /* Board: E1M-X-EVK (SoM SKU E1M-V2N101) */\n    /* Source: include/alp/boards/alp_e1m_x_evk.h */\n    /* v2 scope: --core m33_sm peripherals: adc, gpio, i2c */\n\n    aliases {\n    };\n\n    alp_pins: alp-pins {\n        compatible = \"alp,pin-array\";\n        /* 52 entries in E1M canonical order (e1m_pinout.h).  Indices:\n         *   0..25  IO0..IO25       26..33 PWM0..PWM7\n         *   34..41 ENC0_X..ENC3_Y  42..49 ADC0..ADC7   50..51 DAC0..DAC1\n         * Each <&gpioX Y FLAGS> triplet is TBD pending the upstream SoM\n         * board file; unrouted pads keep their slot so indices stay\n         * stable (alp_gpio_open of an unrouted pad returns NULL).      */\n        gpios =\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 0] ALP_E1M_GPIO_IO0 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 1] ALP_E1M_GPIO_IO1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 2] ALP_E1M_GPIO_IO2 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 3] ALP_E1M_GPIO_IO3 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 4] ALP_E1M_GPIO_IO4 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 5] ALP_E1M_GPIO_IO5 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 6] ALP_E1M_GPIO_IO6 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 7] ALP_E1M_GPIO_IO7 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 8] ALP_E1M_GPIO_IO8 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 9] ALP_E1M_GPIO_IO9 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [10] ALP_E1M_GPIO_IO10 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [11] ALP_E1M_GPIO_IO11 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [12] ALP_E1M_GPIO_IO12 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [13] ALP_E1M_GPIO_IO13 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [14] ALP_E1M_GPIO_IO14 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [15] ALP_E1M_GPIO_IO15 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [16] ALP_E1M_GPIO_IO16 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [17] ALP_E1M_GPIO_IO17 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [18] ALP_E1M_GPIO_IO18 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [19] ALP_E1M_GPIO_IO19 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [20] ALP_E1M_GPIO_IO20 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [21] ALP_E1M_GPIO_IO21 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [22] ALP_E1M_GPIO_IO22 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [23] ALP_E1M_GPIO_IO23 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [24] ALP_E1M_GPIO_IO24 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [25] ALP_E1M_GPIO_IO25 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [26] ALP_E1M_GPIO_PWM0 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [27] ALP_E1M_GPIO_PWM1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [28] ALP_E1M_GPIO_PWM2 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [29] ALP_E1M_GPIO_PWM3 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [30] ALP_E1M_GPIO_PWM4 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [31] ALP_E1M_GPIO_PWM5 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [32] ALP_E1M_GPIO_PWM6 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [33] ALP_E1M_GPIO_PWM7 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [34] ALP_E1M_GPIO_ENC0_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [35] ALP_E1M_GPIO_ENC0_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [36] ALP_E1M_GPIO_ENC1_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [37] ALP_E1M_GPIO_ENC1_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [38] ALP_E1M_GPIO_ENC2_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [39] ALP_E1M_GPIO_ENC2_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [40] ALP_E1M_GPIO_ENC3_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [41] ALP_E1M_GPIO_ENC3_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [42] ALP_E1M_GPIO_ADC0 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [43] ALP_E1M_GPIO_ADC1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [44] ALP_E1M_GPIO_ADC2 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [45] ALP_E1M_GPIO_ADC3 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [46] ALP_E1M_GPIO_ADC4 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [47] ALP_E1M_GPIO_ADC5 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [48] ALP_E1M_GPIO_ADC6 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [49] ALP_E1M_GPIO_ADC7 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [50] ALP_E1M_GPIO_DAC0 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>;  /* [51] ALP_E1M_GPIO_DAC1 */\n    };\n\n};\n"
