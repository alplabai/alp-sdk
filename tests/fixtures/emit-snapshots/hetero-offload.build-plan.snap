        {
          "path": "build/m33_sm-zephyr/alp_hw_info_build.h",
          "contents": "/*\n * Auto-generated by scripts/alp_project.py -- do not edit by hand.\n * Regenerate after changes to board.yaml.\n *\n * Build-time identifier companion to <alp/hw_info.h>.  Apps include\n * this header alongside <alp/hw_info.h> and pass the ALP_HW_BUILD_*\n * string macros to alp_hw_info_assert_matches_build() so the runtime\n * EEPROM read can be checked against what the firmware was built for.\n */\n\n#ifndef ALP_HW_INFO_BUILD_H\n#define ALP_HW_INFO_BUILD_H\n\n#define ALP_HW_BUILD_SOM_SKU         \"E1M-V2N101\"\n#define ALP_HW_BUILD_SOM_FAMILY      \"v2n\"\n#define ALP_HW_BUILD_SOM_HW_REV      \"2625-r1\"\n#define ALP_HW_BUILD_BOARD_NAME      \"E1M-X-EVK\"\n#define ALP_HW_BUILD_BOARD_HW_REV    \"r1\"\n#define ALP_HW_BUILD_OS              \"zephyr\"\n\n#define ALP_HW_BUILD_CORES           \"a55_cluster,m33_sm\"\n#define ALP_HW_BUILD_PRIMARY_CORE    \"m33_sm\"\n\n/* Per-core presence flags: `ALP_HW_BUILD_HAS_<id>` means core <id> exists in\n * the project; its value is that core's OS string.  Defined for EVERY active\n * core in EVERY slice -- it cannot say which core is compiling.\n *\n * `ALP_HW_BUILD_PRIMARY_CORE` names the compiling slice ONLY when this header\n * was emitted --core-scoped (the per-slice build path).  Emitted without\n * --core -- as the project-wide recipe in docs/board-config-emit.md does -- it\n * names the project's primary core (first M-class core alphabetically),\n * which on a multi-core project is not necessarily the one you are\n * building.\n *\n * Zephyr's own CONFIG_BOARD and CONFIG_BOARD_TARGET differ per slice too --\n * the board name and the board/soc/cpucluster target passed to `west build\n * -b` -- and do so no matter how this header was emitted.  E.g. on E1M-AEN801,\n * the HE slice's CONFIG_BOARD is \"alp_e1m_aen801_m55_he\" and its\n * CONFIG_BOARD_TARGET ends \".../rtss_he\"; the HP slice's end \"_hp\" and\n * \".../rtss_hp\".  Prefer them over PRIMARY_CORE where that portability\n * matters. */\n#define ALP_HW_BUILD_HAS_A55_CLUSTER  \"yocto\"\n#define ALP_HW_BUILD_HAS_M33_SM       \"zephyr\"\n\n#endif /* ALP_HW_INFO_BUILD_H */\n"
        },
        {
          "path": "build/m33_sm-zephyr/alp-west-libs.yml",
          "contents": "# SPDX-License-Identifier: Apache-2.0\n#\n# Auto-generated by scripts/alp_project.py -- do not edit by hand.\n# Regenerate after changes to board.yaml's `libraries:` array.\n#\n# Import into your application's west.yml so `west update`\n# pulls only the Zephyr modules the libraries you enabled\n# actually need.  Drop alongside your west.yml and reference\n# from the `import:` field of the alp-sdk project entry.\n\nmanifest:\n  projects:\n    - name: zephyr\n      import:\n        name-allowlist:\n          - cmsis-dsp        # board.yaml libraries: 'cmsis-dsp'\n"
        }
