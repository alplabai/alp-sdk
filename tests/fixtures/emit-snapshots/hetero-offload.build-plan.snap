      "path": "build/generated/dts-reservations.dtsi",
      "contents": "/*\n * Auto-generated by scripts/alp_orchestrate.py -- do not edit.\n * Regenerate after changes to board.yaml `ipc:` or the SoM's\n * memory_map block.  #include this file from your kernel /\n * Zephyr DT.\n */\n\n/ {\n    reserved-memory {\n        #address-cells = <2>;\n        #size-cells = <2>;\n\n        alp_default_rpmsg: alp_default_rpmsg@10000 {\n            compatible = \"shared-dma-pool\";\n            reg = <0x0 0x00010000 0x0 0x00080000>;\n            no-map;\n            label = \"alp_default_rpmsg\";\n        };\n\n    };\n};\n"
