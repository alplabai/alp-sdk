      "configArtefacts": [
        {
          "path": "build/m55_hp-zephyr/alp.conf",
          "contents": "# Auto-generated by scripts/alp_orchestrate.py -- do not edit.\n# Per-core Kconfig fragment for slice `m55_hp` (zephyr).\n\nCONFIG_ALP_SDK=y\nCONFIG_LOG=y\nCONFIG_PRINTK=y\nCONFIG_THREAD_LOCAL_STORAGE=y\nCONFIG_LOG_DEFAULT_LEVEL=3\n\n# Console: Alp UART console (auto-selected for os: zephyr).\n# printf/LOG land on the module's console UART (the board layer\n# owns the `zephyr,console` DT chosen + pinmux -- e.g. E1M edge\n# UART0).  Override in board.yaml with `diagnostics.console: ram`\n# (SWD bench flow) or `none` (inherit the board default).\nCONFIG_SERIAL=y\nCONFIG_CONSOLE=y\nCONFIG_UART_CONSOLE=y\nCONFIG_UART_INTERRUPT_DRIVEN=y\n\n# Boot-banner SoC identity + system summary (from the SoC spec JSON + SoM preset `memory:`; see alp_banner.c).\nCONFIG_ALP_SDK_SOC_NAME=\"Alif Ensemble E8\"\nCONFIG_ALP_SDK_SOC_CPUS=\"M55-HP @400MHz (active)|rtss_hp + 2x Cortex-A32 @800MHz + M55-HE @160MHz|rtss_he\"\nCONFIG_ALP_SDK_SOC_NPUS=\"Ethos-U85 + 2x Ethos-U55\"\nCONFIG_ALP_SDK_SOC_SRAM_KB=9984\nCONFIG_ALP_SDK_SOC_MRAM_KB=5632\n\n# On-module HW manifest EEPROM -> portable bus 0 (alp-i2c0);\n# enables alp_hw_info_read() + the console banner manifest line.\nCONFIG_ALP_SDK_HW_INFO_EEPROM_I2C_BUS_ID=0\n\nCONFIG_ALP_SDK_SOM_HW_REV=\"2626-r2\"\n\n# SoM silicon (alif:ensemble:e8 via E1M-AEN801)\nCONFIG_ALP_SOC_ALIF_ENSEMBLE_E8=y\n\n# Cross-EVK board facade selector (<alp/board.h>); CONFIG_COMPILER_OPT is single-value (do not also set in prj.conf).\nCONFIG_COMPILER_OPT=\"-DALP_BOARD_E1M_EVK\"\n\n# SoM-intrinsic chip drivers (from `E1M-AEN801` on_module + helper_firmware)\nCONFIG_ALP_SDK_CHIP_CC3501E=y\nCONFIG_ALP_SDK_CHIP_EEPROM_24C128=y\nCONFIG_ALP_SDK_CHIP_RV3028C7=y\nCONFIG_ALP_SDK_CHIP_TMP112=y\n\n# Board-populated chip drivers (from the resolved board definition)\nCONFIG_ALP_SDK_CHIP_BME280=n\nCONFIG_ALP_SDK_CHIP_BMI323=y\nCONFIG_ALP_SDK_CHIP_BMP581=y\nCONFIG_ALP_SDK_BLOCK_BUTTON_LED=y\nCONFIG_ALP_SDK_CHIP_CAM_MUX_PI3WVR626=y\nCONFIG_ALP_SDK_CHIP_ICM42670=y\nCONFIG_ALP_SDK_CHIP_INA236=y\nCONFIG_ALP_SDK_CHIP_LIS2DW12=n\nCONFIG_ALP_SDK_CHIP_OV5640=n\nCONFIG_ALP_SDK_BLOCK_PDM_MIC=y\nCONFIG_ALP_SDK_CHIP_SSD1331=n\nCONFIG_ALP_SDK_CHIP_TAS2563=y\nCONFIG_ALP_SDK_CHIP_TCAL9538=y\n\n# Zephyr subsystems required on core `m55_hp` (chip drivers + peripherals)\nCONFIG_GPIO=y\nCONFIG_I2C=y\nCONFIG_I2S=y\nCONFIG_SPI=y\n\n"
        },
        {
          "path": "build/m55_hp-zephyr/alp.overlay",
          "contents": "/*\n * Auto-generated by scripts/alp_project.py -- do not edit by hand.\n * Regenerate after changes to board.yaml or include/alp/boards/<board>.h.\n *\n * Per-pad GPIO bank/index values are TBD; cross-reference the in-tree\n * board file at zephyr/boards/alp/<board>/*.dts (zephyr/module.yml board_root).\n * The alp,pin-array below is the full 52-entry positional map in\n * e1m_pinout.h canonical order; fill the <&gpioX Y FLAGS> columns\n * in place without renumbering (the positional index is the ABI).\n */\n\n#include <zephyr/dt-bindings/gpio/gpio.h>\n\n/ {\n    /* Board: E1M-EVK (SoM SKU E1M-AEN801) */\n    /* Source: include/alp/boards/alp_e1m_evk.h */\n    /* v2 scope: --core m55_hp peripherals: i2s */\n\n    aliases {\n        /* SPI */\n        alp-spi1 = &spi1;  /* EVK_SPI_BUS_ARDUINO */\n        /* UART */\n        alp-uart0 = &uart0;  /* EVK_UART_PORT_DEBUG */\n        alp-uart1 = &uart1;  /* EVK_UART_PORT_ARDUINO */\n        /* PWM */\n        alp-pwm0 = &pwm0;  /* EVK_PWM_LED_RED */\n        alp-pwm1 = &pwm1;  /* EVK_PWM_LED_BLUE, EVK_ARD_PWM1 */\n        alp-pwm2 = &pwm2;  /* EVK_ARD_PWM4 */\n        alp-pwm3 = &pwm3;  /* EVK_PWM_LED_GREEN */\n        alp-pwm4 = &pwm4;  /* EVK_ARD_PWM2 */\n        alp-pwm5 = &pwm5;  /* EVK_ARD_PWM3 */\n        alp-pwm6 = &pwm6;  /* EVK_MB_PWM */\n        /* DAC */\n        alp-dac0 = &dac0;  /* EVK_DAC_ARDUINO_DAC0 */\n        alp-dac1 = &dac1;  /* EVK_DAC_AUDIO_LINE_OUT */\n    };\n\n    alp_pins: alp-pins {\n        compatible = \"alp,pin-array\";\n        /* 52 entries in E1M canonical order (e1m_pinout.h).  Indices:\n         *   0..25  IO0..IO25       26..33 PWM0..PWM7\n         *   34..41 ENC0_X..ENC3_Y  42..49 ADC0..ADC7   50..51 DAC0..DAC1\n         * Each <&gpioX Y FLAGS> triplet is TBD pending the upstream SoM\n         * board file; unrouted pads keep their slot so indices stay\n         * stable (alp_gpio_open of an unrouted pad returns NULL).      */\n        gpios =\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 0] ALP_E1M_GPIO_IO0 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 1] ALP_E1M_GPIO_IO1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 2] ALP_E1M_GPIO_IO2  routed: EVK_PIN_CAM_MUX_SEL */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 3] ALP_E1M_GPIO_IO3 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 4] ALP_E1M_GPIO_IO4  routed: EVK_PIN_ENCODER_SW */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 5] ALP_E1M_GPIO_IO5  routed: EVK_PIN_CAM_RST */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 6] ALP_E1M_GPIO_IO6 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 7] ALP_E1M_GPIO_IO7  routed: EVK_PIN_PCIE_IOEXP_INT */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 8] ALP_E1M_GPIO_IO8  routed: EVK_PIN_I2S_MUX_EN */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [ 9] ALP_E1M_GPIO_IO9  routed: EVK_PIN_PCIE_IOEXP_RST */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [10] ALP_E1M_GPIO_IO10  routed: EVK_PIN_PCIE0_I2C_EN */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [11] ALP_E1M_GPIO_IO11  routed: EVK_PIN_USB2_MUX_SEL */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [12] ALP_E1M_GPIO_IO12 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [13] ALP_E1M_GPIO_IO13  routed: EVK_PIN_I2S_MUX_SEL */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [14] ALP_E1M_GPIO_IO14 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [15] ALP_E1M_GPIO_IO15  routed: EVK_PIN_BMI323_INT1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [16] ALP_E1M_GPIO_IO16  routed: EVK_PIN_W_DISABLE2 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [17] ALP_E1M_GPIO_IO17  routed: EVK_PIN_W_DISABLE1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [18] ALP_E1M_GPIO_IO18  routed: EVK_PIN_M2E_SDIO_WAKE */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [19] ALP_E1M_GPIO_IO19  routed: EVK_PIN_M2E_UART_WAKE */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [20] ALP_E1M_GPIO_IO20  routed: EVK_PIN_SDIO_MUX_EN */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [21] ALP_E1M_GPIO_IO21  routed: EVK_PIN_SDIO_MUX_SEL */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [22] ALP_E1M_GPIO_IO22  routed: EVK_PIN_PCIE_MUX_PD */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [23] ALP_E1M_GPIO_IO23  routed: EVK_PIN_PCIE_MUX_SEL */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [24] ALP_E1M_GPIO_IO24 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [25] ALP_E1M_GPIO_IO25 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [26] ALP_E1M_GPIO_PWM0  default fn: EVK_PWM_LED_RED */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [27] ALP_E1M_GPIO_PWM1  default fn: EVK_ARD_PWM1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [28] ALP_E1M_GPIO_PWM2  default fn: EVK_ARD_PWM4 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [29] ALP_E1M_GPIO_PWM3  default fn: EVK_PWM_LED_GREEN */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [30] ALP_E1M_GPIO_PWM4  default fn: EVK_ARD_PWM2 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [31] ALP_E1M_GPIO_PWM5  default fn: EVK_ARD_PWM3 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [32] ALP_E1M_GPIO_PWM6  default fn: EVK_MB_PWM */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [33] ALP_E1M_GPIO_PWM7 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [34] ALP_E1M_GPIO_ENC0_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [35] ALP_E1M_GPIO_ENC0_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [36] ALP_E1M_GPIO_ENC1_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [37] ALP_E1M_GPIO_ENC1_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [38] ALP_E1M_GPIO_ENC2_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [39] ALP_E1M_GPIO_ENC2_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [40] ALP_E1M_GPIO_ENC3_X */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [41] ALP_E1M_GPIO_ENC3_Y */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [42] ALP_E1M_GPIO_ADC0 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [43] ALP_E1M_GPIO_ADC1 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [44] ALP_E1M_GPIO_ADC2 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [45] ALP_E1M_GPIO_ADC3 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [46] ALP_E1M_GPIO_ADC4 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [47] ALP_E1M_GPIO_ADC5 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [48] ALP_E1M_GPIO_ADC6 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [49] ALP_E1M_GPIO_ADC7 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>,  /* [50] ALP_E1M_GPIO_DAC0 */\n            <&gpio0 0 GPIO_ACTIVE_HIGH>;  /* [51] ALP_E1M_GPIO_DAC1 */\n    };\n\n};\n"
        },
        {
          "path": "build/m55_hp-zephyr/cmake-args.txt",
          "contents": "# Auto-generated by scripts/alp_orchestrate.py -- pass to cmake.\n-DALP_SOM_SKU=E1M-AEN801\n-DALP_SOM_FAMILY=alif-ensemble\n-DALP_CORE_ID=m55_hp\n-DALP_BOARD_E1M_EVK\n-DALP_TOOLCHAIN=arm-zephyr-eabi\n"
        }
      ],
