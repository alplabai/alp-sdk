// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/*
 * ALP E1M-V2N SoM (on-module) — Renesas RZ/V2N (r9a09g056n48).
 *
 * Public, per SoM-vendor norm (Toradex/Phytec/Variscite publish their SoM
 * dtsi; the dtb ships on every module and is GPL). Schematic design IP
 * (resistor IDs, divider math, datasheet notes) stays in alp-sdk-internal
 * metadata, NOT here.
 *
 * On-module hardware described here: DRP-AI/codec reserved memory, the
 * core fixed rails, the dual Realtek RTL8211F-VD GbE PHYs, on-module eMMC
 * (SDHI0), and the on-module xSPI NOR. Carrier-facing enables live in the
 * carrier dtsi (e1m-x-evk.dtsi); each product board dts composes
 * SoC dtsi + this SoM dtsi + a carrier dtsi.
 *
 * Ported from the Renesas RZ/V2N EVK reference dts (kernel SHA 6717c06,
 * AI SDK platform 7.1 / BSP v6.30).
 *
 * STATUS: UNVALIDATED through dtc/bitbake — first structured port.
 */

#include <dt-bindings/gpio/gpio.h>
#include "r9a09g056.dtsi"

/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* A55 view of the CM33 OpenAMP window: the CM33 board trees'
		 * openamp_shm (memory@9f700000, 0x900000, CM33-NS view; A55 =
		 * CM33-NS - 0x50000000, see src/backends/rpc/yocto_uio_drv.c).
		 * no-map so Linux never hands this RAM out: a CM33 image with
		 * IPC enabled writes the resource table + vrings here whether or
		 * not the A55 peer is up (#2374).  The generic-uio nodes the A55
		 * RPC backend opens are declared at the end of this file. */
		openamp_reserved: openamp@4f700000 {
			no-map;
			reg = <0x0 0x4f700000 0x0 0x900000>;
		};

		global_cma: linux,cma@58000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0x58000000 0x0 0x28000000>;
		};

		mmp_reserved: linux,multimedia {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0x80000000 0x0 0x10000000>;
		};

		isp: isp@90000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0x90000000 0x0 0x18000000>;
		};

		opencva_reserved: opencva@a8000000 {
			reusable;
			reg = <0x0 0xa8000000 0x0 0x7cff000>;
		};

		shared_drp_reserved: shareddrp@afcff000 {
			reusable;
			reg = <0x0 0xafcff000 0x0 0x00001000>;
		};

		drp_codec: drp-codec@afd00000 {
			reusable;
			reg = <0x0 0xafd00000 0x0 0x300000>;
		};

		image_buf0: image_buf@b0000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xb0000000 0x0 0x4000000>;
			label = "image_buf0";
		};

		cru_func: cru_buffer@b4000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xb4000000 0x0 0x16400000>;
		};

		/* DRP-AI3 working memory (on-die NPU). */
		drp_reserved: drp-ai@d0000000 {
			reusable;
			reg = <0x0 0xd0000000 0x0 0x20000000>;
		};
	};

	/*
	 * A55 half of the CM33 OpenAMP link (#2374): generic-uio nodes the
	 * userspace OpenAMP master (src/backends/rpc/yocto_uio_drv.c) opens
	 * through libmetal.  The node NAME is load-bearing: sysfs exposes the
	 * platform device as "<unit-address>.<node-name>" (e.g.
	 * 4f700000.rsctbl) and the backend looks each region up by exactly
	 * that string.  Layout = the CM33 board trees' openamp_shm window
	 * (A55 = CM33-NS - 0x50000000) inside openamp_reserved above.
	 * uio_pdrv_genirq binds "generic-uio" (uio.cfg + the 0012 patch).
	 */
	rsctbl@4f700000 {
		compatible = "generic-uio";
		reg = <0x0 0x4f700000 0x0 0x1000>;
	};

	mhu-shm@4f701000 {
		compatible = "generic-uio";
		reg = <0x0 0x4f701000 0x0 0x1000>;
	};

	vring-ctl0@4f800000 {
		compatible = "generic-uio";
		reg = <0x0 0x4f800000 0x0 0x50000>;
	};

	vring-ctl1@4f850000 {
		compatible = "generic-uio";
		reg = <0x0 0x4f850000 0x0 0x50000>;
	};

	vring-shm0@4f900000 {
		compatible = "generic-uio";
		reg = <0x0 0x4f900000 0x0 0x300000>;
	};

	vring-shm1@4fc00000 {
		compatible = "generic-uio";
		reg = <0x0 0x4fc00000 0x0 0x300000>;
	};

	/*
	 * MHU-B register block (A55 0x10480000, CM33-view 0x50480000).  The
	 * M33->A55 doorbell is MHU-B SWINT unit 12, the only CA55-routed
	 * reverse line: INTID 436 = GIC_SPI 404 (GIC-measured on silicon,
	 * alp-sdk #697 cycle 10; see yocto_uio_drv.c ALP_MHU_SWINT_RECV_*).
	 * Level-high: the backend acks by writing SWINT unit 12 CLR.
	 * uio_pdrv_genirq disables the line at IRQ time and libmetal
	 * re-enables it after the backend's ack.
	 */
	mhu-uio@10480000 {
		compatible = "generic-uio";
		reg = <0x0 0x10480000 0x0 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 404 IRQ_TYPE_LEVEL_HIGH>;
	};

	mmngr {
		compatible = "renesas,mmngr";
		memory-region = <&mmp_reserved>;
	};

	mmngrbuf {
		compatible = "renesas,mmngrbuf";
	};

	vspm_if {
		compatible = "renesas,vspm_if";
	};

	reg_0p8v: regulator-0p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-0.8V";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* SD1 (carrier microSD, SDHI1) IO-voltage selector. It sits on the
	 * SoM and feeds the SoC's SD1 VDDQ pad rail; &sdhi1 (e1m-x-evk.dtsi)
	 * uses it as vqmmc-supply. Driven by PA2 (µSD1_V_SEL): low = 3.3 V,
	 * high = 1.8 V; SEL has an internal pull-down, so it defaults to
	 * 3.3 V. Bench-verified at 1.8 V up to SDR104 (see &sdhi1). */
	vqmmc_sdhi1: regulator-vqmmc-sdhi1 {
		compatible = "regulator-gpio";
		regulator-name = "SDHI1 VqmmC";
		gpios = <&pinctrl RZV2N_GPIO(A, 2) GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpios-states = <0>;
		states = <3300000 0>, <1800000 1>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&gpt1_2 0 200000>;
		power-supply = <&reg_3p3v>;
		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <6>;
	};
};

/* Display backlight: the LED boost driver lives ON the SoM (BL_LED_A/K
 * to the module edge); Renesas PA5 = BL_PWM drives its CNTRL input.
 * PA5 func 9 = GTIOC10B. GPT naming trap, the full story:
 *   - GPT INSTANCES are unit-channel composite: GPT00-07 (unit 0,
 *     0x13010000) and GPT10-17 (unit 1, 0x13020000 + ch * 0x100).
 *     "GPT12" = unit 1 channel 2. There is no GPT08/09 instance.
 *   - PIN FUNCTIONS GTIOCnA/B are numbered FLAT n = 0..15 across both
 *     units (HW manual Table 1.2-3 has GTIOC8/9, never GTIOC16/17;
 *     Table 5.7-12 lists unit-1's own pins as GTIOC8A..GTIOC15B).
 *   - Therefore GTIOC10B = unit 1 channel 2 = gpt@13020200 = &gpt1_2,
 *     B-side output (hence channel_B). 5 kHz PWM.
 * The FSP iodefine name "R_GPT10" (= 0x.3020000) is the composite
 * INSTANCE name, not the pin-function index -- do not "fix" this back
 * to &gpt1_0. Silicon-verified 2026-06-06: GPT12 PWM observed at the
 * PA5 die pad via PIN-register sampling (IEN on, ~50% duty); unit-1
 * ch-0 (&gpt1_0) runs identical register images into the unmuxed
 * GTIOC8B function and leaves PA5 dead.
 */
&gpt1_2 {
	pinctrl-0 = <&backlight_pwm_pins>;
	pinctrl-names = "default";
	channel = "channel_B";
	status = "okay";
};

/*
 * CA55 cluster maximum operating point: 1.7 GHz (default) or 1.8 GHz (opt-in).
 *
 * The SoC dtsi (r9a09g056.dtsi) ships a cluster0_opp table that tops out at
 * 1.7 GHz -- the conservative Renesas default -- with an in-tree note that the
 * PLLCA55 "can be clocked to 1.8GHz as well" and that "the table below should
 * be overridden in the board DTS". The RZ/V2N datasheet (r01ds0466) rates the
 * CA55 at 1.8 GHz @ 0.9 V (1.1 GHz @ 0.8 V).
 *
 * 1.7 GHz and 1.8 GHz sit on the SAME 0.9 V rail (the voltage step is lower in
 * the table, at <= 0.85 GHz / 0.8 V), so raising the cap is a ~6 % clock bump
 * at unchanged voltage -- not a higher-voltage corner. The CPG clk driver
 * reprograms PLLCA55 dynamically (the boot-strapped BOOTPLLCA frequency is the
 * initial value, not a ceiling). 1.8 GHz IS the datasheet ceiling, though, so
 * per-unit Fmax margin is thinner there; we ship 1.7 GHz by default and leave
 * 1.8 GHz as a one-line opt-in.
 *
 * TO RAISE THE CAP TO 1.8 GHz: flip ALP_CA55_1P8GHZ to 1 below (or build the
 * kernel dtb with -DALP_CA55_1P8GHZ=1 -- no DT edit needed). Bench-validated
 * on E1M-V2M101 silicon (2026-06-12): a 5 min 4-core soak held 1.8 GHz on all
 * cores with zero sha256 miscompute, no thermal throttle (56 C peak vs the
 * 95 C passive trip), and a clean boot. Validate your own silicon + thermals
 * before enabling 1.8 GHz fleet-wide.
 */
#ifndef ALP_CA55_1P8GHZ
#define ALP_CA55_1P8GHZ 0	/* 0 = 1.7 GHz (default), 1 = 1.8 GHz */
#endif

#if ALP_CA55_1P8GHZ
&cluster0_opp {
	opp-1800000000 {
		opp-hz = /bits/ 64 <1800000000>;
		opp-microvolt = <900000>;
		clock-latency-ns = <300000>;
	};
};
#endif

/*
 * Dual on-module GbE PHYs. Each PHY is addressed at MDIO address 2 on its
 * bus (the on-module wiring makes address 2 the reliable address; address
 * 0 does not respond to phy_poll_reset). The compatible string carries the
 * PHY's IEEE OUI/model so the matching mainline driver binds.
 */
&mdio0 {
	phy0: ethernet-phy@2 {
		compatible = "ethernet-phy-id001c.c878",
			     "ethernet-phy-ieee802.3-c22";
		reg = <2>;
	};
};

&mdio1 {
	phy1: ethernet-phy@2 {
		compatible = "ethernet-phy-id001c.c878",
			     "ethernet-phy-ieee802.3-c22";
		reg = <2>;
	};
};

/*
 * On-die DRP-AI3 NPU enable (claims drp_reserved + shared_drp_reserved
 * above, and flips the node to "okay").
 *
 * Kept in its own file because it can only be compiled when the OPTIONAL
 * meta-rz-drpai layer is in bblayers.conf: that layer's
 * 0001-add-drpai-property-to-devicetree.patch is what CREATES the `drpai0`
 * label in r9a09g056.dtsi -- the pristine linux-renesas tree has no such
 * node, so an unconditional `&drpai0` here aborts dtc for every board that
 * includes this SoM dtsi (V2N and V2M alike).  The linux-renesas bbappend
 * installs the real override when the layer is present and a comment-only
 * stub when it is not; the rationale, the mandatory-second-property rule and
 * the mmp_reserved warning all live in that file.
 */
#include "e1m-v2n-drpai.dtsi"

/* On-module eMMC on SDHI0 (8-bit, HS200, non-removable). */
&sdhi0 {
	pinctrl-0 = <&sdhi0_emmc_pins>;
	pinctrl-1 = <&sdhi0_emmc_pins>;
	pinctrl-names = "default", "state_uhs";
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	fixed-emmc-driver-type = <1>;
	status = "okay";
};

/* GD32G553 supervisor MCU bridge -- I2C slave transport on BRD_I2C.
 * Exposes the GD32-routed E1M IO pads plus sideband control lines
 * (logical bridge map, 21 lines) as a Linux gpiochip: line 5 =
 * IO13/LCD1_RST, line 3 = IO11/CTP1_RST, line 1 = IO9/CTP1_INT (input
 * only -- the GT911 drives it), line 18 = bt-reg-on (the `bluetooth`
 * node's shutdown-gpios below), line 19 = wl-reg-on (the
 * mmc-pwrseq-simple node's reset-gpios below), line 20 = can-stby
 * (sideband, not an E1M pad -- see the gpio-hog below; requires
 * bridge protocol MINOR >= 13, gated at the wire, not in .request();
 * see can-stby-hog below).
 * Same physical chip as the CM33's SCI7 SPI link peer; Linux only
 * issues short GPIO frames here.
 *
 * On-module real-time clock: Micro Crystal RV-3028-C7 at 0x52, also on
 * BRD_I2C -- the RTC of record for the whole SoM family (rtc0 alias
 * below). The SoC's own RTXIN has no discrete 32.768 kHz crystal; it is
 * instead fed by SE1 of the on-module 5L35023B clock generator, which
 * U-Boot corrects from its as-shipped 24.576 MHz to 32.768 kHz on every
 * boot before Linux starts (board_late_init() -> alp_clk5l_fixup(),
 * meta-alp-sdk u-boot 0007 patch) -- bench-confirmed 2026-09-24
 * (E1M-V2M103 board #1): with the fix applied, the SoC RTC (&rtc below)
 * starts and counts at 32.768 kHz. See &rtc's own comment below -- do
 * NOT re-disable it without also reverting that U-Boot fix.
 * No trickle-resistor-ohms is set: whether the RV-3028-C7's VBACKUP net
 * carries a backup cap/coin cell on this SoM is not confirmed on the
 * schematic -- add the property once that's known, don't guess it.
 *
 * CA55/Linux is the sole master of the WHOLE RIIC8/BRD_I2C bus -- every
 * device on it, not just this one (metadata/e1m_modules/v2n/
 * core-ownership.yaml). The CM33 must never issue I2C transactions here.
 *
 * FOLLOW-UP: rv3028c7.yaml's INT/v2n_route (RTC_ALARM) isn't wired to an
 * `interrupts` property below -- the SoC-side pin/mux isn't confirmed
 * yet. /dev/rtc0 alarm ioctls still work via poll/select without it; a
 * wake-capable alarm needs that pin nailed down first.
 */
&i2c8 {
	gd32_gpio: gpio@70 {
		compatible = "alplab,gd32-bridge-gpio";
		reg = <0x70>;
		gpio-controller;
		#gpio-cells = <2>;
		/* Names come from here, not gpio_chip.names: the driver's
		 * names[] made a re-bind oops in gpiolib's duplicate-name walk
		 * (alplabai/alp-sdk#2508). */
		gpio-line-names =
			"IO8",  "IO9",  "IO10", "IO11", "IO12", "IO13",
			"IO14", "IO16", "IO24", "IO25", "IO27", "IO28",
			"IO29", "IO30", "IO31", "IO32", "IO34", "IO35",
			"bt-reg-on", "wl-reg-on", "can-stby", "se-rst";

		/* CAN_STBY (bridge line 20, GD32 PB13,
		 * metadata/e1m_modules/v2n/gd32-io-mcu-map.csv:38): the
		 * shared standby line for the two on-module TCAN1044 CAN-FD
		 * transceivers (U15/U16). STB HIGH = standby, STB LOW =
		 * normal -- the bridge firmware boots the pad HIGH (bus held
		 * in standby) as its own safe default; this hog is Linux
		 * actively taking the bus out of standby at boot.
		 *
		 * Requires bridge protocol MINOR >= 13 (firmware >= 0.2.16).
		 * Unlike lines 18/19, this line is NOT gated in .request():
		 * the only consumer is this hog on the same gpiochip, and
		 * deferring a hog's request would fail the whole gpiochip
		 * registration (bt-reg-on, wl-reg-on, RTC, Display-1). The
		 * 0005 kernel patch instead grants the request immediately
		 * and gates at the wire level (gd32_bridge_gate_blocked()):
		 * on a bridge below MINOR 13 the line-20 write is never sent,
		 * so CAN_STBY stays HIGH and BOTH transceivers sit in
		 * standby indefinitely, with only a one-shot dev_warn.
		 * There is no deferred probe. When the bridge is merely slow
		 * to boot, the driver latches the level and replays it once
		 * the bridge answers. */
		can-stby-hog {
			gpio-hog;
			gpios = <20 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "can-stby";
		};
	};

	rv3028: rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
	};
};

/ {
	aliases {
		/* BRD_I2C is a SoM-internal bus (RIIC8), not one of the E1M-X-EVK
		 * carrier's own routed pins -- its Linux adapter alias lives here,
		 * not in e1m-x-evk.dtsi's carrier-bus aliases block. */
		i2c8 = &i2c8;
		rtc0 = &rv3028;
		/* &rtc (SoC RTCA-3) below is enabled and probes before rtc0
		 * above -- Linux's rtc class allocates ids in probe order
		 * (drivers/rtc/class.c ida_alloc), and drivers/Makefile links
		 * rtc/ before i2c/, so without a fixed id here &rtc would grab
		 * /dev/rtc0 and rv3028 would land on /dev/rtc1, breaking
		 * RTC_HCTOSYS and every alias above that assumes rv3028 = rtc0.
		 * Pin &rtc to rtc1 explicitly so rv3028 keeps rtc0. */
		rtc1 = &rtc;
		/* RSCI4 carries the on-module Bluetooth UART (&sci4 below). The
		 * rz-rsci driver takes its tty index from this alias; without it
		 * the port registers as ttySC0 -- colliding with the SCIF debug
		 * console (serial0, e1m-x-evk.dtsi) -- and matches
		 * console=ttySC0, so the kernel console and the serial getty
		 * move onto the BT UART (bench, E1M-V2M103, 2026-09-26). */
		serial4 = &sci4;
	};

	/* On-module Wi-Fi power sequencing for the Murata LBEE5HY2FY-922
	 * (Infineon CYW55513): WL_REG_ON is GD32 bridge line 19 (PE15,
	 * boots OUTPUT LOW at bridge firmware >= 0.2.12 / protocol minor
	 * 11 -- see gpio-gd32-bridge.c). mmc-pwrseq-simple's reset-gpios
	 * is asserted (driven to its ACTIVE level) in .pre_power_on and
	 * deasserted in .post_power_on, so ACTIVE_LOW here reproduces the
	 * required sequence: REG_ON low through card power-up, then high.
	 * mmc_power_up() holds REG_ON low for host->ios.power_delay_ms
	 * between .pre_power_on and .post_power_on -- that MMC-core delay
	 * is the >=10 ms REG_ON-low hold the bring-up notes call for, not
	 * anything set here. post-power-on-delay-ms instead runs AFTER
	 * .post_power_on drives REG_ON high (pwrseq_simple.c:
	 * mmc_pwrseq_simple_post_power_on() deasserts, then sleeps this
	 * many ms) -- a settle time for the module post-power-up, before
	 * the first CMD5. Bench-tuned on E1M-V2M103 (2026-09-26): at 10 ms
	 * a WL_REG_ON power cycle (SDHI2 unbind/bind) re-enumerated only
	 * 11/15 times -- the failing rounds never answer CMD5 -- while cold
	 * boot always worked; at 200 ms it re-enumerated 15/15 (brcmfmac
	 * firmware reloaded each time). */
	wlan_pwrseq: wlan-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gd32_gpio 19 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};
};

/* SoC RTC (RTCA-3, RTXIN/RTXOUT). RTXIN has no discrete 32.768 kHz
 * crystal -- it is fed by SE1 of the on-module 5L35023B clock
 * generator, whose as-shipped OTP image outputs 24.576 MHz on SE1
 * instead of 32.768 kHz. U-Boot corrects this on every boot, before
 * Linux starts (board_late_init() -> alp_clk5l_fixup(),
 * meta-alp-sdk u-boot 0007 patch): a volatile register write that
 * takes effect immediately but REVERTS ON POWER-CYCLE (the OTP itself
 * cannot be re-burned in-system), so it must run every boot -- this DT
 * enablement depends on that fix having already run. rtc_clk below is
 * fixed at the corrected 32.768 kHz.
 *
 * Bench-confirmed 2026-09-24 (E1M-V2M103 board #1): before the fix,
 * probing &rtc timed out ("Failed to setup the RTC!", -ETIMEDOUT);
 * after it, the SoC RTC starts and counts at 32.768 kHz (~+/-100 ppm
 * vs an NTP-slewed reference). The on-module RV-3028-C7 above remains
 * the RTC of record (rtc0 alias) -- this is a second, SoC-internal
 * timebase, not a replacement; production should use a Renesas factory
 * dash code on the clock generator that carries the corrected OTP
 * image instead of relying on this runtime fixup. */
&rtc_clk {
	clock-frequency = <32768>;
};

&rtc {
	status = "okay";
};

/* On-module Wi-Fi: Murata LBEE5HY2FY-922 (Infineon CYW55513) on SDHI2,
 * 4-bit SDIO, non-removable (it is a soldered-down module, not a card
 * slot). Ground truth (bench-derived 2026-06): PB0=CLK, PB1-PB4=DAT0-3,
 * PB5=CMD (RZ/V2N datasheet Table 2.2-2, Func1 -- the ONLY SD2 routing).
 *
 * IOVS (SD_STATUS pad-voltage-mode bit) MUST be set for a 1.8 V-only
 * part like this one: the SoC SDHI2 pads reset into 3.3 V receiver
 * mode, which cannot read the module's 1.8 V SDIO responses at all
 * (CMDTIMEOUT on every CMD5). IOVS is set ONLY when the SDHI's own
 * internal vqmmc-regulator child (sdhi2_vqmmc, from the SoC dtsi) is
 * enabled -- but enabling it NAIVELY re-triggers a real bench-observed
 * boot oops: regulator_late_cleanup -> renesas_sdhi_regulator_
 * is_enabled -> a raw SD_STATUS register read while the controller is
 * runtime-suspended takes a synchronous external abort, which killed
 * the console-input IRQ and put the eMMC rootfs at risk on the exact
 * board this was found on. `regulator-always-on` is the proven-safe
 * fix: it makes regulator_late_cleanup's own early-return trigger
 * (`if (c->always_on) return 0;`) fire BEFORE the crashing read. Do
 * NOT drop regulator-always-on from sdhi2_vqmmc below. A second,
 * independent guard against the same class of read-while-suspended
 * crash (a manual sysfs/debugfs regulator read, which always_on does
 * NOT cover) lives in
 * meta-alp-sdk/recipes-kernel/linux/linux-renesas/
 * 0007-mmc-renesas_sdhi-pm_runtime-guard-the-vqmmc-regulato.patch.
 *
 * mmc-pwrseq drives WL_REG_ON (GD32 bridge line 19) through the
 * required low-then-high sequence (wlan_pwrseq, above). The `wifi@1`
 * child node is the standard brcmfmac SDIO binding; brcmfmac itself
 * matches on the SDIO vendor/device ID the module reports, this node
 * only gives it a DT anchor for future properties (e.g. a host-wake
 * IRQ, not yet routed on this SoM).
 *
 * STATUS: UNVALIDATED on real silicon through this exact node shape --
 * the WLAN blocker chased through 2026-06 bench sessions turned out to
 * be the module's 32.768 kHz LPO (from the on-module 5L35023B clock
 * generator), not anything IOVS/pinctrl/strap-side; see #2293 for that
 * fix (owned there, NOT touched here). This node assumes that fix
 * lands.
 *
 * sd-uhs-sdr50: sdhi2_vqmmc below is a FIXED 1.8 V regulator (min ==
 * max == 1800000), so no voltage switching is involved in reaching UHS
 * here -- the pads are 1.8 V-only from power-up, unlike a card slot
 * that starts at 3.3 V and CMD11-switches. Without this property
 * mmc_sdio_init_uhs_card() (drivers/mmc/core/sdio.c) never tries
 * anything past the legacy "sd high-speed" mode; bench-verified
 * (E1M-V2M103, 2026-09-26): without it mmc2 negotiated "sd
 * high-speed" at 50 MHz, 4-bit. With it, "sd uhs SDR50" at 100 MHz,
 * 4-bit, no errors. sd-uhs-sdr104 is deliberately NOT set: this node
 * is non-removable (soldered-down, not a card slot to fall back to on
 * a bad tuning) and only SDR50 has been bench-verified -- untested
 * 208 MHz tuning risks taking SDIO down on some unit.
 */
&sdhi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sd2_wlan_pins>;
	pinctrl-1 = <&sd2_wlan_pins>;
	pinctrl-names = "default", "state_uhs";
	/* The module's VBAT is the SoM's always-on 3.3 V rail. vmmc-supply
	 * is required even so: without it tmio_mmc_init_ocr() finds no OCR
	 * mask (no regulator, and the RZ SDHI of_data carries no ocr_mask)
	 * and returns -EPROBE_DEFER forever -- the host never probes and
	 * dmesg only repeats "allocated mmc-pwrseq" (bench, E1M-V2M103,
	 * 2026-09-26). */
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&sdhi2_vqmmc>;
	mmc-pwrseq = <&wlan_pwrseq>;
	bus-width = <4>;
	non-removable;
	cap-power-off-card;
	keep-power-in-suspend;
	sd-uhs-sdr50;
	status = "okay";

	sdhi2_vqmmc: vqmmc-regulator {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		status = "okay";
	};

	/* brcm,ccode-map-trivial: without it brcmfmac has no cfg80211
	 * country->firmware country-code map for this module and silently
	 * drops the reg_notifier() country (e.g. "DE" from the
	 * wireless-regdb-static-backed `iw reg set`) -- the firmware never
	 * sees it. The trivial map (ISO code -> the same two ASCII bytes,
	 * revision 0) is enough for this module; bench-verified working on
	 * kernel 6.1.141-cip43 (E1M-V2M103, 2026-09-26). */
	wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
		brcm,ccode-map-trivial;
	};
};

/* On-module Bluetooth: the same CYW55513's BT core, on RSCI4 (UART),
 * P40-P43 -- BT_REG_ON is GD32 bridge line 18 (PE14), driven by hci_bcm
 * through shutdown-gpios before the .hcd patch load. uart-has-rtscts
 * matches the 4-wire P40-43 wiring (TXD/RXD/CTS/RTS); the module will not
 * transmit unless the host's RTS is asserted.
 *
 * compatible = "infineon,cyw55572-bt" with brcm,requires-autobaud-mode is
 * the CYW555xx path in hci_bcm/btbcm, and the only one that brings this
 * module up. Bench, E1M-V2M103, 2026-09-26, each step reproduced on the
 * raw ttySC4 as well as through serdev:
 *  - With max-speed set, bcm_open() copies it into hu->oper_speed and
 *    hci_serdev sends the vendor Update-Baud-Rate command (0xfc18) as the
 *    first byte on the link. The pre-patch ROM wedges on that: 0xfc18
 *    and every later command, HCI_Reset included, time out. It also
 *    ignores 0xfc18 after a Reset, so there is no max-speed and no ramp:
 *    the link stays at the 115200 init speed.
 *  - The ROM also does not answer the vendor Read Controller Features
 *    (0xfc6e), which btbcm_initialize() treats as fatal on the non-
 *    autobaud path. Autobaud mode skips that and Read Local Name.
 * Result: chip id 157, 'brcm/BCM.hcd' patch loaded, hci0 UP+RUNNING
 * (the patch is the Murata 2FY .hcd, installed as BCM.hcd).
 *
 * PFC funcs per the e2 studio PinMux tool (authoritative over the
 * EVK reference dts, which does not populate RSCI4 at all): P40=f2
 * (TXD4), P41=f2 (RXD4), P42=f4 (CTS4), P43=f2 (RTS4) -- note CTS4 is
 * NOT the same function number as the other three; do not "correct"
 * it to f2, that was checked against pin_data.c directly.
 *
 * Naming frame: renesas-peripheral-map.tsv / pinmux/v2n.yaml name the
 * same pads BT_UART.RXD=P40, BT_UART.TXD=P41 -- that is the *module's*
 * (Murata BT core's) own RXD/TXD, i.e. what it receives on / transmits
 * from. The SoC-side name above (P40=TXD4, P41=RXD4) is the RZ/V2N's
 * own transmit/receive role on that same pad -- a host TXD wires to a
 * peripheral's RXD. Same pads, correct crossover, just two different
 * "whose TXD is this" frames; not a discrepancy.
 */
&sci4 {
	pinctrl-0 = <&sci4_bt_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "infineon,cyw55572-bt";
		shutdown-gpios = <&gd32_gpio 18 GPIO_ACTIVE_HIGH>;
		brcm,requires-autobaud-mode;
	};
};

/* On-module xSPI NOR. */
&xspi {
	pinctrl-0 = <&xspi_pins>;
	pinctrl-names = "default";
	assigned-clocks = <&cpg CPG_CORE R9A09G056_SPI_CLK_SPI>;
	assigned-clock-rates = <133333334>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		vcc-supply = <&reg_1p8v>;
		m25p,fast-read;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		/* Layout for the populated 32 MiB MX25U25635F: bl2 (mtd0) +
		 * fip (mtd1, spans the remainder; also carries the CM33
		 * image).  The EVK reference layout this was ported from
		 * assumed a 64 MiB part and declared a third "user"
		 * partition at 0x2000000 -- past the end of this flash, so
		 * the kernel disabled it on every boot ("partition is out
		 * of reach").  Re-cutting fip to free real user space is a
		 * deliberate layout decision (it moves mtd1's bounds for
		 * provisioning and CM33 flashing) -- not done casually here. */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bl2";
				reg = <0x00000000 0x00060000>;
			};

			partition@60000 {
				label = "fip";
				reg = <0x00060000 0x1fa0000>;
			};
		};
	};
};

/* CA55-cluster watchdog (wdt1 -- wdt0 belongs to the CM33, wdt2/3 to
 * the CR8s).  SoC-internal, so enabled at SoM level rather than per
 * carrier.  systemd arms and pets it from early userspace
 * (RuntimeWatchdogSec -- see the alp-watchdog-policy recipe);
 * timeout-sec pins the policy explicitly instead of inheriting the
 * driver default (the HW period itself is fixed ~175 ms; longer
 * timeouts are kernel-emulated).
 * NOTE: the WDT1-underflow -> reset routing (CPG_ERRORRST_SEL2) is
 * programmed by TF-A BL2 on r9a09g056 (this kernel's DT has no
 * renesas,syscon-cpg-error-rst) -- supervision only resets the board
 * when running the ALP/BSP FIP.
 * VALIDATION: pending bench hang-injection on a built image + the
 * deployed FIP -- start the watchdog, stop feeding it, and confirm
 * the board actually resets within timeout-sec; a keepalive-only
 * check (feed succeeds, no starvation attempted) does not prove this
 * (alp-sdk#1153).
 *
 * wdt0 (CM33): NOT enabled anywhere in this tree (alp-sdk#1153).
 * Checked against the exact pinned Zephyr v4.4.0 tag's own upstream
 * SoC devicetree (dts/arm/renesas/rz/rzv/r9a09g056.dtsi, zephyr west
 * module -- not vendored in this repo): it declares no watchdog node
 * and no watchdog driver binds this SoC at all yet, so there is no
 * label to reference from the CM33 board dts and no register base
 * address in this tree to hand-author one from (contrast the MHU-B
 * mbox1 node hand-authored at CM33 board level in
 * alp_e1m_v2n101_m33_sm_r9a09g056n48gbg_cm33.dts -- that one had a
 * real vendored FSP register map, bsp_mhu_b.h, to draw from; no
 * equivalent WDT FSP module is vendored under zephyr/drivers/ here).
 * <alp/wdt.h> on the M33 therefore finds no matching backend
 * (src/wdt_dispatch.c returns ALP_ERR_NOT_PRESENT_ON_THIS_SOC) --
 * NOT the ALP_ERR_NOSUPPORT stub_wdt.c path, which is Yocto/baremetal-
 * only and never compiled into a Zephyr build (zephyr/CMakeLists.txt
 * has no reference to it). */
&wdt1 {
	timeout-sec = <60>;
	status = "okay";
};

/* MCPU DMAC (DMAC0 @ 0x11400000) is OWNED BY THE CM33 firmware (the
 * GD32 supervisor link's SCI7 DMA path drives it through the rzv FSP
 * r_dmac_b).  The upstream SoC dtsi enables it for Linux, whose
 * rz-dmac driver then binds the unit, claims all 8 channel interrupts
 * and resets/owns the channels under the CM33's feet -- the same AMP
 * double-ownership class as the port-9 SD1_CD lesson.  Silicon
 * 2026-06-06: rz-dmac bound + 8 GIC IRQs claimed on the live system
 * while the CM33 FSP was arming the same channels.  The A55 has four
 * other DMAC units; this one is off-limits.
 * (dmac0_aclk is NOT gated by this: bench-verified on the pristine
 * BSP kernel with the node disabled, the cpg driver keeps the clock
 * held -- enable_cnt=1, deviceless -- so the CM33's engine keeps its
 * clock.)
 *
 * OWNERSHIP CONTRACT (alp-sdk#1152, docs/adr/0025-v2n-dmac0-cm33-
 * exclusive-channel-partition.md): DMAC0 is CM33-exclusive, whole
 * unit -- this status="disabled" line IS the enforcement, not a
 * placeholder for a finer-grained one.  Within that exclusive
 * ownership, the CM33 FSP config
 * (zephyr/drivers/spi/spi_renesas_rz_sci_b.c:257-259) reserves ch0
 * (RX, DMAINT0 -> NVIC 89) + ch1 (TX, DMAINT1 -> NVIC 90) for the
 * SCI7 SPI DMA fast path (currently gated off pending #84,
 * ALP_V2N_SCI7_DMAC=0); ch2-7 are unclaimed margin, still CM33-side.
 * No Linux-side per-channel mask/partition mechanism is evidenced in
 * this tree or the upstream rz-dmac binding -- do NOT attempt a
 * partial re-enable without first finding and silicon-verifying one;
 * Linux DMA needs on this SoM route through one of the other four
 * A55 DMAC units instead. */
&dmac0 {
	status = "disabled";
};

&pinctrl {
	/* eMMC/SD0 IO rail select (PA0, eMMC_V_SEL): the rail is
	 * GPIO-selected between 3.3 V (on-module pull-down default) and
	 * 1.8 V, switching the SoC's VDD1833_SD0 pad rail AND the eMMC
	 * VccQ + bus pull-ups together.  Park it HIGH (1.8 V) before the
	 * card is ever initialised: eMMC has no live VccQ-switch
	 * handshake (unlike SD CMD11), so modelling this as a switchable
	 * vqmmc regulator costs a guaranteed mmc_select_hs200 -110 +
	 * retry on every boot (silicon-verified) -- whereas a hog at
	 * pinctrl probe (~1.9 s) has the rail stable at 1.8 V long
	 * before sdhi probes (~3.0 s), the fixed reg_1p8v vqmmc claim is
	 * then TRUE, and HS200 trains first try.  Without this hog the
	 * rail sat at its 3.3 V default while the driver claimed 1.8 V:
	 * 'mmc_select_hs200 failed, error -74' + silent HS-52 fallback
	 * on every cold boot. */
	emmc-v-sel-hog {
		gpio-hog;
		gpios = <RZV2N_GPIO(A, 0) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "emmc_v_sel_1v8";
	};

	sdhi0_emmc_pins: emmc-pins {
		sd0-clk {
			pins = "SD0CLK";
			renesas,output-impedance = <3>;
			slew-rate = <0>;
		};

		sd0-dat-cmd {
			pins = "SD0DAT0", "SD0DAT1", "SD0DAT2", "SD0DAT3", "SD0DAT4",
			       "SD0DAT5", "SD0DAT6", "SD0DAT7", "SD0CMD";
			input-enable;
			renesas,output-impedance = <3>;
			slew-rate = <0>;
		};
	};

	xspi_pins: xspi0 {
		ctrl {
			pins = "XSPI0_RESET0N", "XSPI0_CS0N", "XSPI0_CKP";
			output-enable;
		};

		io {
			pins = "XSPI0_IO0", "XSPI0_IO1", "XSPI0_IO2", "XSPI0_IO3";
			renesas,output-impedance = <3>;
		};
	};

	backlight_pwm_pins: backlight-pwm {
		pinmux = <RZV2N_PORT_PINMUX(A, 5, 9)>; /* PA5 func 9 = GTIOC10B -> on-SoM backlight boost CNTRL */
	};

	/* On-module Wi-Fi SDIO (SDHI2), func1 -- see &sdhi2 above for the
	 * full ground-truth writeup. Split CLK vs CMD/DAT exactly like
	 * sdhi0_emmc_pins above: PB0 (SD2CLK) has NO PIN_CFG_IEN capability
	 * in the pinctrl-rzg2l RZV2H_PB table (a group-wide input-enable
	 * spanning it fails pinctrl_ops.set_mux with -EINVAL, taking the
	 * WHOLE group down, clk included) while PB1-PB5 (SD2DAT0-3, SD2CMD)
	 * all have it and need it enabled for the host to sample the
	 * module's responses at all. */
	sd2_wlan_pins: sd2-wlan {
		sd2-clk {
			pinmux = <RZV2N_PORT_PINMUX(B, 0, 1)>; /* PB0 = SD2CLK */
			renesas,output-impedance = <2>;
			slew-rate = <0>;
		};

		sd2-cmd-dat {
			pinmux = <RZV2N_PORT_PINMUX(B, 1, 1)>, /* PB1 = SD2DAT0 */
				 <RZV2N_PORT_PINMUX(B, 2, 1)>, /* PB2 = SD2DAT1 */
				 <RZV2N_PORT_PINMUX(B, 3, 1)>, /* PB3 = SD2DAT2 (SDIO/gSPI boot strap) */
				 <RZV2N_PORT_PINMUX(B, 4, 1)>, /* PB4 = SD2DAT3 */
				 <RZV2N_PORT_PINMUX(B, 5, 1)>; /* PB5 = SD2CMD */
			input-enable;
			renesas,output-impedance = <2>;
			slew-rate = <0>;
		};
	};

	/* On-module Bluetooth UART (RSCI4), P40-P43. Func numbers per the
	 * e2 studio PinMux tool (pin_data.c) -- NOT uniform (CTS4 is f4,
	 * the other three are f2); see the &sci4 comment above. */
	sci4_bt_pins: sci4-bt {
		pinmux = <RZV2N_PORT_PINMUX(4, 0, 2)>, /* P40 = TXD4 */
			 <RZV2N_PORT_PINMUX(4, 1, 2)>, /* P41 = RXD4 */
			 <RZV2N_PORT_PINMUX(4, 2, 4)>, /* P42 = CTS4 */
			 <RZV2N_PORT_PINMUX(4, 3, 2)>; /* P43 = RTS4 */
	};

	/* CAN-FD: two on-module TCAN1044 transceivers (U15/U16, SoM
	 * rev 2625-R2 schematic sheet "CAN-BUS - Encoder"), each on its own
	 * SoC canfd channel. Mapping is transceiver-to-channel, NOT
	 * connector-to-channel-in-numeric-order:
	 *   - U15 TxD/RxD = CANFD3_CTX3/CANFD3_CRX3 (P86/P87) -> CAN0_H/L
	 *     -> carrier E1M_X_CAN0 (metadata/boards/e1m-x-evk.yaml).
	 *   - U16 TxD/RxD = CANFD2_CTX2/CANFD2_CRX2 (P84/P85) -> CAN1_H/L
	 *     -> carrier E1M_X_CAN1.
	 * i.e. E1M_X_CAN0 is SoC channel3, E1M_X_CAN1 is SoC channel2.
	 *
	 * Linux netdev names: rcar_canfd names netdevs in channel probe
	 * order (channel2 -> can0), which swaps the E1M numbering. The
	 * 0013 kernel patch reports the channel in dev_port and the
	 * alp-canfd-udev rule renames them: channel3 -> can_e1m0
	 * (E1M_X_CAN0), channel2 -> can_e1m1 (E1M_X_CAN1). <alp/can.h>
	 * opens can_e1m<N>.
	 *
	 * Series-0R links R290/R291/R347/R6 are fitted per BOM (not
	 * checkable from this repo), so the PHY path is live. Pin syntax
	 * follows Renesas's own RZ/V2N EVK reference dts (kernel-source
	 * arch/arm64/boot/dts/renesas/r9a09g056n48-rzv2n-evk.dts,
	 * can2_pins/can3_pins). Both transceivers share one STB net,
	 * driven via the gd32_gpio can-stby-hog above -- see that comment
	 * for the standby/normal polarity and the protocol-version gate.
	 * TCAN1044 EN is not driven from Linux; UNCONFIRMED whether it is
	 * strapped high on the SoM (the schematic is not in this repo) --
	 * if a bench bus stays silent with STB low, check EN first. */
	canfd_pins: can_pins {
		can2_pins: can2 {
			pinmux = <RZV2N_PORT_PINMUX(8, 4, 5)>, /* CANFD2_CTX2 (TX) */
				 <RZV2N_PORT_PINMUX(8, 5, 5)>;  /* CANFD2_CRX2 (RX) */
		};

		can3_pins: can3 {
			pinmux = <RZV2N_PORT_PINMUX(8, 6, 5)>, /* CANFD3_CTX3 (TX) */
				 <RZV2N_PORT_PINMUX(8, 7, 5)>;  /* CANFD3_CRX3 (RX) */
		};
	};
};

/* CAN-FD controller: both on-module channels (see the canfd_pins
 * comment above for the transceiver-to-channel mapping and the
 * schematic source). No `phys` (transceiver PHY) property on either
 * channel: the TCAN1044 is not in this kernel's
 * Documentation/devicetree/bindings/phy/ti,tcan104x-can.yaml compatible
 * enum (ti,tcan1042 / ti,tcan1043 only), so claiming one of those
 * compatibles for a TCAN1044 would misrepresent the populated part.
 * The gd32_gpio can-stby-hog above drives the shared STB line instead
 * -- an honest static hog beats a dishonest phy binding.
 *
 * Bit timing is deliberately NOT in the DT. The controller's timing
 * clock (the `can_clk`/`fck` inputs of the RZ/V2N CANFD block, sourced
 * from the SoC's CPG via RZ_CLOCK_CANFD(ch) -- see the SoC dtsi
 * `&canfd` node in the BSP kernel, not this repo) is inherited from the
 * SoC dtsi -- 80 MHz on silicon (`rcar_canfd 12440000.can: can_clk rate
 * is 80000000`, E1M-V2M103 bench 2026-09-30) -- and rcar_canfd derives
 * NBTP/DBTP from it, so the bitrate is
 * an operator step, not a DT property (a fixed `bitrate` here would
 * also force one rate on every deployment). Until it is set the
 * channel stays down and cannot disturb a live bus:
 *   ip link set can_e1m0 type can bitrate 500000 dbitrate 2000000 fd on
 * Let the driver pick the sample points (87.5 % / 75 % at 80 MHz).  Forcing
 * sample-point 0.8 gives phase-seg2 32 and the controller then goes
 * BUS-OFF on tx-dominant-bit-error with a healthy transceiver (E1M-V2M103
 * bench 2026-09-30); the defaults sit at ERROR-PASSIVE (ACK errors only)
 * on a lone node, as they should.
 *   ip link set can_e1m0 up
 * (repeat for can_e1m1). `ip -d link show can_e1m0` prints the clock
 * the kernel is using and the achievable bitrate/sample-point limits.
 *
 * TDC is not a DT property and no kernel patch is needed: the BSP
 * rcar_canfd already enables transmitter delay compensation (TDCE,
 * TDCO = data sample point in clock periods - 1) whenever the data BRP
 * is 1 or 2, and `ip ... tdc-mode auto|manual|off tdco N tdcv N`
 * overrides it (RZ/V2N manual R01UH1071 section 7.9.4.1.5). At 2 Mbit/s
 * the TCAN1044 loop delay (about 100-175 ns) is well inside the 375 ns
 * data sample point, so TDC does not explain a lone-node BRS BUS-OFF; an
 * ACK error alone cannot cause it either (error-passive nodes do not
 * count ACK errors). docs/build-yocto-v2n.md "CAN-FD data phase: TDC and
 * bus-off triage" has the discriminating bench steps.
 * docs/build-yocto-v2n.md "CAN-FD bring-up" has the full procedure. */
&canfd {
	pinctrl-0 = <&canfd_pins>;
	pinctrl-names = "default";
	status = "okay";

	channel2 {
		status = "okay";
	};

	channel3 {
		status = "okay";
	};
};
