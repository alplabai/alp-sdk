From 0f8b4b3e01801a31d8eb7455e7ddf27db70f1559 Mon Sep 17 00:00:00 2001
From: Alp Lab AB <contact@alplab.ai>
Date: Thu, 1 Oct 2026 21:36:12 +0000
Subject: [PATCH] media: rzg2l-cru: add Y10 and Y8 greyscale formats

Bench symptom (E1M-V2M103, kernel 6.1.141-cip43, OV9281 on CSI-2
via the ov9282 driver, which only offers 1280x720 MEDIA_BUS_FMT_Y10_1X10):
media-ctl -V of Y10_1X10 on the rzg2l-csi2 sink pad silently reads
back as UYVY8_1X16, because the CSI-2 receiver has no Y10 entry and
set_fmt falls back to its first table entry. VIDIOC_STREAMON then fails
with -EPIPE (Broken pipe) on the sensor-to-CRU format mismatch.

A greyscale sensor sends plain RAW10 (CSI-2 data type 0x2B), which the
CRU already handles for the Bayer codes: same input data type, raw
bypass (no demosaic or colour conversion) and the packed CR10 output
(64-bit units, six 10-bit pixels per unit).  So:

- rzg2l-csi2: add MEDIA_BUS_FMT_Y10_1X10 (RAW10 rate limits) and
  MEDIA_BUS_FMT_Y8_1X8 (RAW8 rate limits) to both the RZ/G2L and the
  RZ/V2H-family tables, so set_fmt keeps them on both pads.
- rzg2l-ip: map MEDIA_BUS_FMT_Y10_1X10 to the existing CR10 entry
  (V4L2_PIX_FMT_RAW_CRU10, MIPI_CSI2_DT_RAW10, ICnDMR 0).  The
  codes[] array grows from four to five entries for it.  Y8_1X8
  already maps to GREY/RAW8 here; only the CSI-2 side was missing.
- rzg2l-video: accept Y10_1X10 in the CSI-2 link validation (Y8_1X8
  was already accepted).

Other sensors are unaffected: no existing code changes meaning.
---
 drivers/media/platform/renesas/rzg2l-cru/rzg2l-cru.h   | 6 +++---
 drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c  | 8 ++++++++
 drivers/media/platform/renesas/rzg2l-cru/rzg2l-ip.c    | 3 ++-
 drivers/media/platform/renesas/rzg2l-cru/rzg2l-video.c | 1 +
 4 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-cru.h b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-cru.h
index 2d4fd2a6e421..2cb9204a7de4 100644
--- a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-cru.h
+++ b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-cru.h
@@ -314,7 +314,7 @@ struct rzg2l_cru_ip {
 
 /**
  * struct rzg2l_cru_ip_format - CRU IP format
- * @codes: Array of up to four media bus codes
+ * @codes: Array of up to five media bus codes
  * @datatype: MIPI CSI2 data type
  * @format: 4CC format identifier (V4L2_PIX_FMT_*)
  * @icndmr: ICnDMR register value
@@ -323,9 +323,9 @@ struct rzg2l_cru_ip {
 struct rzg2l_cru_ip_format {
 	/*
 	 * RAW output formats might be produced by RAW media codes with any one
-	 * of the 4 common bayer patterns.
+	 * of the 4 common bayer patterns, or by the matching greyscale code.
 	 */
-	u32 codes[4];
+	u32 codes[5];
 	u32 datatype;
 	u32 format;
 	u32 icndmr;
diff --git a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c
index da838a8508fb..fd5eaeb4a301 100644
--- a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c
+++ b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c
@@ -284,6 +284,8 @@ static const struct rzg2l_csi2_format rzg2l_csi2_formats[] = {
 	  .rate = RATE_RANGES(80, 2128)},
 	{ .code = MEDIA_BUS_FMT_SRGGB8_1X8,	.bpp = 8,
 	  .rate = RATE_RANGES(80, 2128)},
+	{ .code = MEDIA_BUS_FMT_Y8_1X8,	.bpp = 8,
+	  .rate = RATE_RANGES(80, 2128)},
 	{ .code = MEDIA_BUS_FMT_SRGGB10_1X10,	.bpp = 10,
 	  .rate = RATE_RANGES(80, 2619)},
 	{ .code = MEDIA_BUS_FMT_SGRBG10_1X10,	.bpp = 10,
@@ -292,6 +294,8 @@ static const struct rzg2l_csi2_format rzg2l_csi2_formats[] = {
 	  .rate = RATE_RANGES(80, 2619)},
 	{ .code = MEDIA_BUS_FMT_SBGGR10_1X10,	.bpp = 10,
 	  .rate = RATE_RANGES(80, 2619)},
+	{ .code = MEDIA_BUS_FMT_Y10_1X10,	.bpp = 10,
+	  .rate = RATE_RANGES(80, 2619)},
 	{ .code = MEDIA_BUS_FMT_SRGGB12_1X12,	.bpp = 12,
 	  .rate = RATE_RANGES(80, 3095)},
 	{ .code = MEDIA_BUS_FMT_SGRBG12_1X12,	.bpp = 12,
@@ -337,6 +341,8 @@ static const struct rzg2l_csi2_format rzv2h_csi2_formats[] = {
 	  .rate = RATE_RANGES(80, 5040)},
 	{ .code = MEDIA_BUS_FMT_SRGGB8_1X8,	.bpp = 8,
 	  .rate = RATE_RANGES(80, 5040)},
+	{ .code = MEDIA_BUS_FMT_Y8_1X8,	.bpp = 8,
+	  .rate = RATE_RANGES(80, 5040)},
 	{ .code = MEDIA_BUS_FMT_SRGGB10_1X10,	.bpp = 10,
 	  .rate = RATE_RANGES(80, 6203)},
 	{ .code = MEDIA_BUS_FMT_SGRBG10_1X10,	.bpp = 10,
@@ -345,6 +351,8 @@ static const struct rzg2l_csi2_format rzv2h_csi2_formats[] = {
 	  .rate = RATE_RANGES(80, 6203)},
 	{ .code = MEDIA_BUS_FMT_SBGGR10_1X10,	.bpp = 10,
 	  .rate = RATE_RANGES(80, 6203)},
+	{ .code = MEDIA_BUS_FMT_Y10_1X10,	.bpp = 10,
+	  .rate = RATE_RANGES(80, 6203)},
 	{ .code = MEDIA_BUS_FMT_SRGGB12_1X12,	.bpp = 12,
 	  .rate = RATE_RANGES(80, 7331)},
 	{ .code = MEDIA_BUS_FMT_SGRBG12_1X12,	.bpp = 12,
diff --git a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-ip.c b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-ip.c
index 79555ff09de0..d8c6898cc5a9 100644
--- a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-ip.c
+++ b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-ip.c
@@ -134,7 +134,8 @@ static const struct rzg2l_cru_ip_format rzg2l_cru_ip_formats[] = {
 			MEDIA_BUS_FMT_SBGGR10_1X10,
 			MEDIA_BUS_FMT_SGBRG10_1X10,
 			MEDIA_BUS_FMT_SGRBG10_1X10,
-			MEDIA_BUS_FMT_SRGGB10_1X10
+			MEDIA_BUS_FMT_SRGGB10_1X10,
+			MEDIA_BUS_FMT_Y10_1X10
 		},
 		.format = V4L2_PIX_FMT_RAW_CRU10,
 		.datatype = MIPI_CSI2_DT_RAW10,
diff --git a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-video.c b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-video.c
index 4d62e5acfd87..fedc1032f7ad 100644
--- a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-video.c
+++ b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-video.c
@@ -1683,6 +1683,7 @@ static int rzg2l_cru_video_link_validate(struct media_link *link)
 		case MEDIA_BUS_FMT_SGRBG10_1X10:
 		case MEDIA_BUS_FMT_SGBRG10_1X10:
 		case MEDIA_BUS_FMT_SBGGR10_1X10:
+		case MEDIA_BUS_FMT_Y10_1X10:
 		case MEDIA_BUS_FMT_SRGGB12_1X12:
 		case MEDIA_BUS_FMT_SGRBG12_1X12:
 		case MEDIA_BUS_FMT_SGBRG12_1X12:
-- 
