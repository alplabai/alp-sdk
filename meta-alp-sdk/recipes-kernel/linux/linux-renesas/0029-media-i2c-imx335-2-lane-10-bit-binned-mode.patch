+/**
+ * imx335_nth_mode() - Get the n-th mode usable at the connected lane count
+ * @imx335: pointer to imx335 device
+ * @n: index among the usable modes
+ *
+ * Return: the mode, or NULL when @n is past the last usable mode.
+ */
+static const struct imx335_mode *imx335_nth_mode(const struct imx335 *imx335,
+						 unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++) {
+		if (!imx335_mode_fits(imx335, &supported_modes[i]))
+			continue;
+		if (!n--)
+			return &supported_modes[i];
+	}
+
+	return NULL;
+}
