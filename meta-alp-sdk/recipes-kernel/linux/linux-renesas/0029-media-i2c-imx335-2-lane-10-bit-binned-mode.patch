+/**
+ * imx335_calc_pixel_rate() - Pixel rate matching the CSI-2 link
+ * @imx335: pointer to imx335 device
+ * @mode: pointer to imx335_mode sensor mode
+ *
+ * The CSI-2 receiver derives the D-PHY rate from this control, so it must
+ * equal what the lanes carry: link frequency * 2 (DDR) * lanes / bpp.
+ *
+ * Return: pixel rate in Hz
+ */
+static u64 imx335_calc_pixel_rate(struct imx335 *imx335,
+				  const struct imx335_mode *mode)
+{
+	return div_u64((u64)link_freq[mode->link_freq_idx] * 2 *
+		       imx335->num_lanes, mode->bpp);
+}
