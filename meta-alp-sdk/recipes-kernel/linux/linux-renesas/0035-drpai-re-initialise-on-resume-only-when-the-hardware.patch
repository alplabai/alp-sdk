From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alp Lab AB <contact@alplab.ai>
Date: Sun, 8 Nov 2026 13:32:31 +0000
Subject: [PATCH] drpai: re-initialise on resume only when the hardware
 was running

drpai_resume_noirq() calls drpai_init_device() whenever the shared
DRP-AI hardware is inactive, including when /dev/drpai0 was never
opened.  open() powers the block up first (drpai_drp_cpg_init());
resume does not, so on a system where nothing has used the DRP-AI
since boot the first register access in R_DRPAI_DRP_Open() hits a
block whose CPG is off and an asynchronous SError panics the resume.

Remember in drpai_suspend_noirq() whether the hardware was running and
stopped, and skip the hardware re-initialisation (and the active-status
record) on resume when it was not.  The software state restore -- status,
IRQ-check flag and the waitqueue wake -- still runs every time, so a
poller woken by the resume never waits on an IRQ that cannot come;
the next open() then brings the block up the same way it does after
boot.

Upstream-Status: Inappropriate [Renesas BSP driver added by meta-rz-drpai, not upstream]
---
 drivers/drpai/drpai-if.c | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/drivers/drpai/drpai-if.c b/drivers/drpai/drpai-if.c
index caca7c5..c7e8a2c 100644
--- a/drivers/drpai/drpai-if.c
+++ b/drivers/drpai/drpai-if.c
@@ -4011,6 +4011,14 @@ end:
 #endif
 }
 
+/*
+ * Whether drpai_suspend_noirq() found the DRP-AI hardware running and stopped it.
+ * drpai_resume_noirq() re-initialises the hardware only in that case: when the
+ * DRP-AI was never opened, its CPG is still off, and the register writes in
+ * drpai_init_device() raise an asynchronous SError that panics the resume.
+ */
+static bool drpai_hw_active_at_suspend;
+
 static int drpai_suspend_noirq(struct device *dev)
 {
     int result = 0;
@@ -4056,11 +4064,13 @@ static int drpai_suspend_noirq(struct device *dev)
     }
 
     dev_info(dev, "suspend: The stopping process has been executed.");
+    drpai_hw_active_at_suspend = true;
 #ifdef ENABLE_DRP_SUPPORT_SHARED_MEMORY
     }
     else
     {
         dev_info(dev, "suspend: The stopping process was skipped because the DRP-AI was already stopped.");
+        drpai_hw_active_at_suspend = false;
     }
 #endif
 
@@ -4135,7 +4145,12 @@ static int drpai_resume_noirq(struct device *dev)
         goto end;
     }
 
-    if(-1 == R_DRPAI_IsDrpaiHwStatusActive(drpai_shared_exclusion))
+    if(!drpai_hw_active_at_suspend)
+    {
+        /* Not running before suspend: leave it stopped, the next open() powers it up. */
+        dev_info(dev, "resume: The initialization process was skipped because the DRP-AI was stopped at suspend.");
+    }
+    else if(-1 == R_DRPAI_IsDrpaiHwStatusActive(drpai_shared_exclusion))
     {
         /* The DRP-AI is initialised only when DRP-AI is stopped. */
 #endif
@@ -4153,9 +4168,12 @@ static int drpai_resume_noirq(struct device *dev)
 
     // Update internal state
 #ifdef ENABLE_DRP_SUPPORT_SHARED_MEMORY
-    R_DRPAI_RecordDrpaiActiveStatus(drpai_shared_exclusion,
-                                    &shared_mem_lock,
-                                    PROCESS_CONTEXT);
+    if(drpai_hw_active_at_suspend)
+    {
+        R_DRPAI_RecordDrpaiActiveStatus(drpai_shared_exclusion,
+                                        &shared_mem_lock,
+                                        PROCESS_CONTEXT);
+    }
 #endif
     spin_lock_irqsave(&priv->lock, flags);
     priv->drpai_status.status = DRPAI_STATUS_IDLE;
