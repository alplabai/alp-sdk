// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/*
 * ALP E1M-X-EVK carrier (45x65) — peripherals on the baseboard.
 *
 * Composes with a SoM dtsi: a board dts includes the SoC dtsi, then the
 * SoM dtsi (e1m-v2n-som.dtsi), then this carrier dtsi. Because we build
 * up from the SoC dtsi and only ENABLE what the carrier populates, there
 * is no "disable the EVK's nodes" pile — the Renesas EVK's HDMI bridge,
 * OV5645 cameras, DA7212 codec and RAA215300 PMIC simply aren't enabled.
 *
 * Ported from the Renesas RZ/V2N EVK reference dts (kernel SHA 6717c06).
 * STATUS: UNVALIDATED through dtc/bitbake.
 *
 * TODO (carrier features to port once exercised on the bench):
 *   - Audio: LANDED below (2026-09-26) -- TAS2563 smart-amp pair on I2C0
 *     @0x4D/0x4E, fed from I2S0 (SSIU1/SSI1 + SSIU2/SSI2) through the
 *     TMUX1574 path-mux.  Carrier-side facts (addresses, channel, mux +
 *     shutdown/fault GPIOs, MCLK) are in metadata/boards/e1m-x-evk.yaml's
 *     `audio:` block.
 *
 *     The four SoC-side values the previous note called DATA-GATED are
 *     now confirmed by reading the actual linux-renesas 6.1.141-cip43
 *     kernel-source tree at the SHA this carrier was ported from
 *     (6717c06):
 *       - binding: `rcar_sound` IS correct for r9a09g056 -- SoC dtsi
 *         `compatible = "renesas,rcar_sound-r9a09g056"`, reg-names
 *         "scu"/"adg"/"ssiu"/"ssi"/"audmapp"/"spdif", node label
 *         `rcar_sound`, SSI channels `ssi0`..`ssi9` (arch/arm64/boot/dts/
 *         renesas/r9a09g056.dtsi).
 *       - PFC function: the stock Renesas RZ/V2N EVK reference dts
 *         (r9a09g056n48-rzv2n-evk.dts, same SHA) pinmuxes its own SSI3/4
 *         + AUDIO_CLKB/C pads as `RZV2N_PORT_PINMUX(port, pin, 7)`, where
 *         (port, pin) is exactly this repo's "P<port><pin>" notation
 *         (e.g. SSIU3_SSI3_SCK/P12 -> RZV2N_PORT_PINMUX(1, 2, 7); AUDIO_
 *         CLKB/P10 -> RZV2N_PORT_PINMUX(1, 0, 7) -- both confirmed
 *         against that dts verbatim). metadata/pinmux/v2n.yaml's e1m_pad
 *         "TBD" column is a separate, still-open gap (the E1M-X module
 *         edge-pad silkscreen crosswalk) -- it does not block writing
 *         kernel pinctrl, which only needs the SoC-side P<port><pin>.
 *       - MCLK source + rate: the same reference dts sets
 *         `&audio_clkb { clock-frequency = <24576000>; };` for the
 *         identical 5L35023B 24.576 MHz feed -- see
 *         metadata/boards/e1m-x-evk.yaml's `audio.mclk` note.
 *       - the SoM-preset crosswalk (metadata/e1m_modules/E1M-V2N103.yaml)
 *         already ties E1M-X logical I2S0/I2S1 to SSIU1+SSIU2 /
 *         SSIU3+SSIU4 respectively; that mapping is unchanged by this
 *         landing (its `driver_status: none` there describes the #655
 *         auto-generation pipeline, not this hand-authored node).
 *
 *     Two TAS2563 MONO amps share one physical I2S bus (one SCLK/WS/SDATA
 *     set), so the card is one audio-graph-card2 `multi` link
 *     (sound/soc/generic/audio-graph-card2.c, built in on this kernel):
 *     ONE cpu port (rcar_sound SSI2 data, SSI1 SCK/WS) fanned out to TWO codec ports in a
 *     single dai_link, so both amps get the same hw_params, format and
 *     DAPM power sequencing. Bench-verified on E1M-V2M103 (2026-09-27):
 *     both amps' PWR_CTL go software-shutdown -> active with the stream
 *     and back afterwards. Why not simple-audio-card: simple-card.c counts
 *     exactly one codec per link and parses a second `codec@N` sibling as
 *     an extra CPU node (a bogus dai_link with a NULL rtd->pcm, which
 *     oopses in dapm_connect_dai_pair()); and `aux-devs` gives the second
 *     amp no dai_link at all, so it never receives hw_params,
 *     set_tdm_slot or the DAC DAPM path.

 *     Each codec endpoint also carries `dai-tdm-slot-*`: rsnd fixes the
 *     SSI system word length at 32 bits, but the TAS2563 only learns its
 *     slot length (TDM_CFG2.RX_SLEN) from set_tdm_slot, so without it the
 *     amp decodes 16-bit slots and the right channel reads the empty low
 *     half of the left slot. The tas2562 driver rejects a zero tx mask,
 *     hence the explicit masks. Which slot an amp actually plays is the
 *     "Left/Right ASI1 Sel" mixer control (Left / Right respectively),
 *     not DT.
 *
 *     shutdown-gpios/interrupts are wired on the LEFT (U27) node only --
 *     board.yaml documents SD_N/IRQ_N as ONE shared net across both
 *     chips, not per-amp, so only one Linux consumer may claim the GPIO
 *     line. Because SD_N therefore does not reset the amps across a warm
 *     reboot, meta-alp-sdk patch 0009 makes the tas2562 driver
 *     software-reset each amp at component probe. The IRQ_N `interrupts`
 *     property documents the wiring only: the 6.1 tas2562 driver never
 *     requests an IRQ, so amp faults are not signalled to Linux.
 *
 *     I2C-address ownership (issue #2331 item 1): landing the kernel
 *     `ti,tas2563` codec nodes below means the kernel binds
 *     i2c0@0x4d/0x4e for ALSA -- the SDK's own userspace chips/tas2563
 *     driver (reachable over alp_i2c_* on this same bus) must not ALSO
 *     be wired up against this board/SoM combination, or the two would
 *     race the same registers. Resolved as a NON-FIGHTING ownership
 *     contract rather than a PACKAGECONFIG lock-out: tas2563_init()
 *     already propagates its bus call's status verbatim (#2077), so
 *     when a kernel driver holds one of these addresses,
 *     `ioctl(I2C_SLAVE)` on `/dev/i2c-0` fails `EBUSY` before any
 *     transaction is even attempted, and that surfaces as
 *     `ALP_ERR_BUSY` out of `tas2563_init()` -- see the @retval
 *     ALP_ERR_BUSY note on that function in
 *     `include/alp/chips/tas2563.h`. A future userspace-driver
 *     enablement on e1m-v2n101/e1m-v2m101 competing with this DT node
 *     gets a clear, distinct refusal rather than a silent register
 *     race or a misleading ALP_ERR_NOT_READY ("no chip present").  No
 *     live conflict today either way (this DT node is the only bound
 *     client at these addresses, and the driver does not fight it).
 *
 *     Kernel config: the mainline ASoC `tas2562` driver covers the
 *     TAS2563; CONFIG_SND_SOC_RCAR is already `=y` in this BSP's
 *     defconfig. tas2563-audio.cfg enables CONFIG_SND_SOC_TAS2562 and pins
 *     CONFIG_SND_AUDIO_GRAPH_CARD2; see tas2563-audio.cfg (re-added; the earlier copy was removed
 *     under #1171 because a codec driver with no DT consumer cannot
 *     bind -- the DT consumer now exists, below).
 *
 *     See chips/tas2563 + issues #25 (codec), #655 (DT/pinctrl
 *     generation from the SoM layer), #1171, #2331 (this landing --
 *     I2C-ownership + E1M-pad-crosswalk follow-ups).
 *   - Display 1 (J6): ported -- rk055hdmipi4ma0 panel on dsi0 (see below).
 *     Display 2 (J28) is permanently unavailable: it requires DSI1 lane
 *     set, which the V2N/V2M family does not populate.
 *     Touch (GT911 on the panel FFC): DEFERRED -- its I2C bus
 *     (DSI1_CSI_I2C) terminates on the GD32 IO-MCU bridge; Linux has no
 *     direct path until the bridge gains an I2C-master proxy.
 *   - 2x MIPI-CSI cameras (two separate, bare CSI connectors -- see
 *     docs/boards/e1m-x-evk.md's "Camera connectors" row).
 *
 *     An OPT-IN, bench-unverified IMX219 placeholder path now exists:
 *     e1m-x-evk-cam0-imx219.dtsi / docs/v2n-camera-csi.md (#1149).
 *
 *     DATA-GATED, and gated on a product decision rather than on a
 *     document.  What the carrier DOES already carry is in tree: the
 *     CAM0 control pads (metadata/boards/e1m-x-evk.yaml -> generated
 *     macros XEVK_PIN_CAM0_MUX_SEL = E1M_X_GPIO_IO16, XEVK_PIN_CAM0_EN
 *     = E1M_X_GPIO_IO18, XEVK_PIN_CAM0_RST = E1M_X_GPIO_IO20
 *     active-low), the camera-side control buses (XEVK_I2C_BUS_DSI_CSI0
 *     = E1M_X_I2C2, XEVK_I2C_BUS_DSI_CSI1 = E1M_X_I2C3), and the CRU +
 *     ISP DMA pools, which e1m-v2n-som.dtsi already reserves
 *     (isp@90000000 and cru_buffer@b4000000).
 *
 *     What is missing is four things, none of them guessable:
 *       1. The SENSOR.  No part is chosen: e1m-x-evk.yaml sets
 *          `ov5640: false` and names none, and the connectors are bare
 *          (the OV5645 pair mentioned in the header above belongs to
 *          the Renesas EVK, not to this carrier).  Without a part there
 *          is no compatible, no CCI address, no lane count, and no
 *          link-frequency -- and inventing a plausible one is how you
 *          get a node that binds to nothing.
 *       2. Which connector lands on which of the SoC's two CSI-2
 *          receivers, and on how many lanes.  The E1M-X edge connector
 *          carries FOUR CSI instances (metadata/e1m/pinout-x-v1.json,
 *          CSI0..CSI3); the RZ/V2N populates two
 *          (metadata/socs/renesas/rzv2n/n44.json, "mipi_csi2": 2).
 *          Nothing in tree maps one onto the other:
 *          metadata/pinmux/v2n.yaml carries no CSI lane row at all.
 *       3. Which rail powers which connector.  The camera LDO enables
 *          are GD32-owned, not Renesas-owned
 *          (metadata/e1m_modules/v2n/gd32-io-mcu-map.csv: CAM_EN_LDO0 =
 *          PC3, CAM_EN_LDO1 = PE8, CAM_EN_LDO2 = PE7, CAM_EN_LDO3 =
 *          PE10), so power-up is a bridge GPIO write, not a
 *          regulator-fixed node -- but the LDO-to-connector pairing is
 *          a schematic fact this repo does not carry.  CAM1_RST is
 *          likewise still TBD (e1m-x-evk.yaml's `partial_hw_config`).
 *       4. For CAM1 specifically, a Linux I2C master.  E1M-X I2C3
 *          (DSI1_CSI_I2C) terminates on the GD32 IO-MCU bridge, so a
 *          sensor whose CCI lands there cannot be configured from
 *          Linux until the bridge gains an I2C-master proxy -- the
 *          same blocker that defers GT911 touch above.
 *
 *     The Zephyr/CM33 side of this is a DIFFERENT and larger gap, not a
 *     mirror of it: upstream Zephyr v4.4.1 ships no Renesas RZ/V CSI-2
 *     receiver driver or binding at all.  Full analysis in
 *     src/backends/camera/v2n_n44_isp.c's DATA-GATED block.
 *
 *     See issue #1149.
 *   - CAN-FD (TCAN1044 x2).  DATA-GATED on the kernel side, same shape as
 *     the audio entry above.  The module bonds out two of the SoC's six
 *     controllers -- CANFD2 (CTX2 = P84, CRX2 = P85) and CANFD3
 *     (CTX3 = P86, CRX3 = P87), per
 *     metadata/e1m_modules/v2n/renesas-peripheral-map.tsv -- but this repo
 *     does not carry the linux-renesas 6.1.x r9a09g056 dtsi, so three
 *     values the nodes need are unverified here: the canfd node's label
 *     and its compatible string in that tree, the RZV2N_PORT_PINMUX
 *     function index for P84..P87 (metadata/pinmux/v2n.yaml still carries
 *     e1m_pad/e1m_function "TBD" on all four CANFD rows), and whether the
 *     BSP defconfig builds a CAN-FD driver at all.  Do not guess any of
 *     them -- read them out of the kernel tree at the SHA this port was
 *     generated against (6717c06).
 *
 *     Two facts that ARE settled and belong in the port when it lands.
 *     First, CAN_STBY is not a Renesas pad: the transceivers' standby line
 *     is owned by the GD32 IO-MCU on PB13 (metadata/pinmux/v2n.yaml,
 *     metadata/e1m_modules/v2n/gd32-io-mcu-map.tsv), so it is reached
 *     through 0005-gpio-add-gd32-bridge-expander-driver.patch's expander,
 *     not through pinctrl.  Second, CANFD2/CANFD3 are unattributed in
 *     metadata/e1m_modules/v2n/core-ownership.yaml, whose "absence means
 *     not attributed" rule means check_amp_pad_claims.py cannot see an
 *     A55-vs-CM33 conflict on these pads until whichever core claims them
 *     is recorded there.
 *
 *     The CM33 side is analysed in alp-sdk#1146 and in this board's
 *     Zephyr dts (upstream ships the RZ CAN-FD driver, but hal_renesas has
 *     no rzv FSP CAN-FD module and the RZ/V2N SoC dtsi has no node); it is
 *     blocked for different reasons, so neither core unblocks the other.
 */

#include <dt-bindings/interrupt-controller/irq.h>

/ {
	aliases {
		ethernet0 = &eth0;
		ethernet1 = &eth1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		mmc1 = &sdhi1;
		serial0 = &scif;
	};

	chosen {
		bootargs = "ignore_loglevel";
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";

		nmi {
			interrupt-parent = <&icu>;
			interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
			linux,code = <0>;
			label = "NMI";
			wakeup-source;
		};
	};

	/* TAS2563 stereo pair (U27 left / U28 right), one shared I2S0 bus:
	 * one audio-graph-card2 `multi` link, SSI2 -> both amps. See this
	 * file's header comment for why not simple-audio-card. */
	sound_card: sound {
		compatible = "audio-graph-card2";
		label = "e1m-x-evk-tas2563";
		links = <&sound_multi_cpu>;

		multi {
			#address-cells = <1>;
			#size-cells = <0>;

			/* CPU side: port@0 is the link itself, port@1 the SSI. */
			ports@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				sound_multi_cpu: port@0 {
					reg = <0>;
					mcpu0_ep: endpoint { remote-endpoint = <&mcodec0_ep>; };
				};

				port@1 {
					reg = <1>;
					mcpu1_ep: endpoint { remote-endpoint = <&rsnd_ep>; };
				};
			};

			/* Codec side: port@0 is the link itself, then one per amp. */
			ports@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					mcodec0_ep: endpoint { remote-endpoint = <&mcpu0_ep>; };
				};

				port@1 {
					reg = <1>;
					mcodec1_ep: endpoint { remote-endpoint = <&tas2563_left_ep>; };
				};

				port@2 {
					reg = <2>;
					mcodec2_ep: endpoint { remote-endpoint = <&tas2563_right_ep>; };
				};
			};
		};
	};
};

/* MCLK reference for the ADG (Audio Digital clock Generator): the
 * on-module 5L35023B SE3 output feeds Audio_CLKB at a fixed 24.576 MHz
 * (metadata/chips/clk_5l35023b.yaml `Audio_CLKB` signal; confirmed
 * against the stock RZ/V2N EVK reference dts -- see this file's header).
 * The TAS2563 has no discrete MCLK pin; the ADG derives the SSI1/SSI2
 * bit-clock from this reference. */
&audio_clkb {
	clock-frequency = <24576000>;
};

/* SoC audio block (SCU/ADG/SSIU/SSI/AUDMAPP).
 *
 * Data direction (#2331): per the SoM + carrier netlists, SSI1's SDATA
 * (P46) reaches E1M pad AQ4 I2S0_SDI -> TMUX1574 U46 -> the TAS2563 SDOUT
 * pins (U27/U28 pin 10), and SSI2's SDATA (P47) reaches AR4 I2S0_SDO ->
 * the TAS2563 SDIN pins (pin 11). Playback therefore leaves on SSI2's
 * data line, while SCK/WS come out of SSI1 (P44/P45). The RZ/V2N SSIU can
 * do that: SSIU_SSI_MODE1.ssi2_pin{2,1,0} = 110b makes SSI1 the pin
 * master and SSI2 its slave (RZ/V2N Group Hardware Manual Additional
 * Document R01UH1072EJ0120, section 8.5.2.3.16; SSICR1.SCKD/SWSD = 1,1,
 * SSICR2.SCKD/SWSD = 0,0). The stock rsnd driver only knows SSI0 as a
 * clock parent, so meta-alp-sdk patch 0014 adds the SSI2-under-SSI1 case,
 * selected by the `alp,shared-pin-ssi1` property on &ssi2 below.
 *
 * P46 (SSI1 SDATA, the amps' SDOUT net) is deliberately NOT muxed: the
 * SoC must never drive it. There is no capture/IV-sense path in this card.
 *
 * STATUS: bench-unverified (no sound heard yet); the card is enabled
 * because playback no longer drives the SDOUT net, but the first bench
 * listen is still pending (see docs/boards/e1m-x-evk.md audio notes). */
&rcar_sound {
	pinctrl-0 = <&sound_pins>;
	pinctrl-names = "default";
	status = "okay";

	#sound-dai-cells = <1>;

	/* Clock list = the SoC dtsi's, minus clk_a (module 0xfb) and clk_c
	 * (0xfd). Audio_CLKA is the AUDIO_EXTAL/AUDIO_XTAL oscillator input and
	 * Audio_CLKC an unfed pad on this SoM/carrier: both stay at 0 Hz, and
	 * the CPG only reports CLK_ON (CPG_CLKMON_7 bits 27/29) once a clock is
	 * actually present, so rzv2h-cpg times out (-110) on the first runtime
	 * resume of the card. rsnd falls back to a null clock for a clock name
	 * that is absent (rsnd_adg_get_clkin), so dropping them is safe; the
	 * card runs from Audio_CLKB (clk_b) only. Bench-confirmed on E1M-V2M103
	 * (no -110; 2 s of 48 kHz audio plays in 2.06 s). Re-sync this list from
	 * r9a09g056.dtsi's rcar_sound node on a BSP bump. */
	clocks = <&cpg CPG_MOD 0xf5>,
		 <&cpg CPG_MOD 0x18a>,
		 <&cpg CPG_MOD 0x189>,
		 <&cpg CPG_MOD 0x188>,
		 <&cpg CPG_MOD 0x187>,
		 <&cpg CPG_MOD 0x186>,
		 <&cpg CPG_MOD 0x185>,
		 <&cpg CPG_MOD 0x184>,
		 <&cpg CPG_MOD 0x183>,
		 <&cpg CPG_MOD 0x182>,
		 <&cpg CPG_MOD 0x181>,
		 <&cpg CPG_MOD 0x180>,
		 <&cpg CPG_MOD 0xf6>,
		 <&cpg CPG_MOD 0xf7>,
		 <&cpg CPG_MOD 0x17d>,
		 <&cpg CPG_MOD 0x17c>,
		 <&cpg CPG_MOD 0x17b>,
		 <&cpg CPG_MOD 0x17a>,
		 <&cpg CPG_MOD 0x179>,
		 <&cpg CPG_MOD 0x178>,
		 <&cpg CPG_MOD 0x177>,
		 <&cpg CPG_MOD 0x176>,
		 <&cpg CPG_MOD 0x175>,
		 <&cpg CPG_MOD 0x174>,
		 <&cpg CPG_MOD 0x17e>,
		 <&cpg CPG_MOD 0x173>,
		 <&cpg CPG_MOD 0x172>,
		 <&cpg CPG_MOD 0x173>,
		 <&cpg CPG_MOD 0x172>,
		 <&cpg CPG_MOD 0x170>,
		 <&cpg CPG_MOD 0x171>,
		 <&cpg CPG_MOD 0xf8>,
		 <&cpg CPG_MOD 0xf9>,
		 <&cpg CPG_MOD 0xfc>,
		 <&cpg CPG_MOD 0xfa>,
		 <&cpg CPG_MOD 0x169>,
		 <&cpg CPG_MOD 0x168>,
		 <&cpg CPG_MOD 0x167>,
		 <&cpg CPG_MOD 0x166>,
		 <&cpg CPG_MOD 0x165>,
		 <&cpg CPG_MOD 0x164>,
		 <&cpg CPG_MOD 0x163>,
		 <&cpg CPG_MOD 0x162>,
		 <&cpg CPG_MOD 0x161>,
		 <&cpg CPG_MOD 0x160>,
		 <&cpg CPG_MOD 0xfe>,
		 <&cpg CPG_MOD 0xff>,
		 <&cpg CPG_MOD 0x100>,
		 <&cpg CPG_MOD 0x16a>,
		 <&cpg CPG_MOD 0x16b>,
		 <&cpg CPG_MOD 0x16c>;
	clock-names = "ssi-all",
		      "ssi.9",
		      "ssi.8",
		      "ssi.7",
		      "ssi.6",
		      "ssi.5",
		      "ssi.4",
		      "ssi.3",
		      "ssi.2",
		      "ssi.1",
		      "ssi.0",
		      "ssif_supply_clk",
		      "scu_clk",
		      "scu_clkx2",
		      "src.9",
		      "src.8",
		      "src.7",
		      "src.6",
		      "src.5",
		      "src.4",
		      "src.3",
		      "src.2",
		      "src.1",
		      "src.0",
		      "scu_supply_clk",
		      "mix.1",
		      "mix.0",
		      "ctu.1",
		      "ctu.0",
		      "dvc.0",
		      "dvc.1",
		      "audmac-pp",
		      "adg_clk",
		      "clk_b",
		      "clk_i",
		      "adg.ssi.9",
		      "adg.ssi.8",
		      "adg.ssi.7",
		      "adg.ssi.6",
		      "adg.ssi.5",
		      "adg.ssi.4",
		      "adg.ssi.3",
		      "adg.ssi.2",
		      "adg.ssi.1",
		      "adg.ssi.0",
		      "spdif.0",
		      "spdif.1",
		      "spdif.2",
		      "adg.spdif.0",
		      "adg.spdif.1",
		      "adg.spdif.2";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			/* SoC is bit- and frame-clock provider (ADG from Audio_CLKB). */
			rsnd_ep: endpoint {
				remote-endpoint = <&mcpu1_ep>;
				dai-format = "i2s";
				bitclock-master;
				frame-master;
				playback = <&ssi2>;
			};
		};
	};
};

/* SSI2 plays out of P47; its SCK/WS come from SSI1 (P44/P45), see above. */
&ssi2 {
	alp,shared-pin-ssi1;
};

/* TAS2563 smart-amp pair (I2C0 @0x4D/0x4E). SD_N (shutdown) and IRQ_N
 * (fault) are ONE shared net each across both chips (board.yaml's
 * `audio.shutdown`/`audio.fault_irq`) -- wired on the LEFT node only so
 * a single Linux GPIO consumer owns each line. imon/vmon-slot-no give
 * each amp distinct SDOUT slots (I: 0/1, V: 2/3) for I-V sense telemetry
 * (ti,vmon-slot-no is read by the 6.1 driver but is not in the upstream
 * ti,tas2562 binding, so dtbs_check flags it);
 * the driver's default vmon slot is 2 for every instance, which would
 * collide. Playback slots are set on the codec endpoints (header
 * comment). */
&i2c0 {
	tas2563_left: codec@4d {
		compatible = "ti,tas2563";
		reg = <0x4d>;
		sound-name-prefix = "Left";
		#sound-dai-cells = <0>;
		/* AMP.ENABLE (\SD_N), shared -- see header comment. SSIU3_SSI3_SCK
		 * / P12 (E1M-X I2S1_SCLK repurposed as plain GPIO, not an SSI
		 * function here). */
		/* The 6.1 tas2562 driver drives shutdown-gpios to logical 1 to power the
		 * amp up (SDZ is active-low shutdown), so the line is ACTIVE_HIGH:
		 * ACTIVE_LOW held both amps in shutdown (they NACK I2C while SDZ is low). */
		shutdown-gpios = <&pinctrl RZV2N_GPIO(1, 2) GPIO_ACTIVE_HIGH>;
		/* AMP.FAULT (IRQ_N), shared -- see header comment. SSIU3_SSI3_
		 * SDATA / P04, pad AR10 (E1M-X I2S1_SDI repurposed as plain GPIO;
		 * NOT P15, which is I2S1_SDO). */
		interrupt-parent = <&pinctrl>;
		interrupts = <RZV2N_GPIO(0, 4) IRQ_TYPE_EDGE_FALLING>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;

		port {
			/* 2 x 32-bit slots to match rsnd's fixed 32-bit SSI word;
			 * see this file's header comment. */
			tas2563_left_ep: endpoint {
				remote-endpoint = <&mcodec1_ep>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
			};
		};
	};

	tas2563_right: codec@4e {
		compatible = "ti,tas2563";
		reg = <0x4e>;
		sound-name-prefix = "Right";
		#sound-dai-cells = <0>;
		ti,imon-slot-no = <1>;
		ti,vmon-slot-no = <3>;

		port {
			tas2563_right_ep: endpoint {
				remote-endpoint = <&mcodec2_ep>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
			};
		};
	};
};

&qextal_clk {
	clock-frequency = <24000000>;
};

/* RTXIN/rtc_clk/&rtc are intentionally left untouched here: the SoC
 * RTC is enabled and rtc_clk fixed at 32.768 kHz at the SoM layer
 * (e1m-v2n-som.dtsi, which composes before this carrier dtsi) -- do not
 * add an &rtc/&rtc_clk override here, it would silently fight that
 * setting. RTXIN has no discrete 32.768 kHz crystal; it is fed by SE1
 * of the on-module 5L35023B clock generator instead, corrected from
 * its as-shipped 24.576 MHz by U-Boot on every boot (see
 * e1m-v2n-som.dtsi's own comment and the meta-alp-sdk u-boot 0007
 * patch). The on-module RV-3028-C7 remains the RTC of record (rtc0
 * alias) -- the SoC RTC is a second, SoC-internal timebase, not a
 * replacement. Per this file's own convention ("only ENABLE what the
 * carrier populates"), a carrier has nothing to enable here either
 * way. */

/* Carrier microSD slot (SDHI1). The bench dev image roots from this card
 * (root=/dev/mmcblk1p2); on-module eMMC (SDHI0) is the production boot.
 *
 * cd-gpios: SD1_SD1CD/PA1 runs straight to the socket's card-detect
 * switch to GND (not through the carrier SDIO mux), pulled up to the
 * switched card rail. Active-low: 0 = card present.
 *
 * vqmmc: vqmmc_sdhi1 (e1m-v2n-som.dtsi) switches the SD1 IO rail to
 * 1.8 V for UHS. The SD1 pads run at output-impedance 2, one step weaker
 * than the eMMC: at 3 (strongest) SDR104 through the carrier SDIO mux
 * fails the data phase with CRC errors (-84); at 2 it is clean.
 *
 * Capped at SDR50 (100 MHz, 1.8 V), no sd-uhs-sdr104: SDR104 reads are
 * fine (~85 MB/s), but host-to-card writes at 208 MHz never complete --
 * "mmc1: Card stuck being busy!" with 4 KiB requests, a hung request with
 * 256 KiB ones (#2357). Tuning only calibrates the host's read sampling,
 * not its outgoing data. SDR50 writes 512 MiB in 20 s (E1M-V2M103, bench
 * 2026-09-27, with kernel patch 0010).
 *
 * vmmc: card power (PA3/SD1_SD1PWEN) is an always-on hog, not a
 * regulator the MMC core may switch off. The card-detect pull-up sits on
 * that same switched rail, so cutting card power would make an empty
 * slot read as "card present".
 *
 * SDCARD_RST (PA4) is not a microSD signal: it is the M.2 E-key Wi-Fi
 * SDIO reset carried through the carrier SDIO mux, so it is left
 * undriven here.
 *
 * The carrier SDIO mux (TMUX1574 U38/U39) selects microSD vs M.2 Wi-Fi
 * SDIO. On the E1M-X EVK V2 its SEL (MUX_SEL.SDIO) is not a GPIO: R239
 * (100k) pulls it low (= microSD) and header P6 ties it to +3V3 (= M.2);
 * E1M IO27 is unconnected. Its active-low EN (SD_MUX_EN) is E1M IO29,
 * with no external pull-down. See docs/boards/e1m-x-evk.md. */
&sdhi1 {
	pinctrl-0 = <&sdhi1_pins>;
	pinctrl-1 = <&sdhi1_pins>;
	pinctrl-names = "default", "state_uhs";
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&vqmmc_sdhi1>;
	bus-width = <4>;
	sd-uhs-sdr50;
	cd-gpios = <&pinctrl RZV2N_GPIO(A, 1) GPIO_ACTIVE_LOW>;
	/* The RZ/V2N ICU has no both-edge TINT mode, so the card-detect GPIO
	 * cannot be an interrupt (the MMC core asks for both edges and the request
	 * failed with "Setting trigger mode 3 ... failed"). broken-cd sets
	 * MMC_CAP_NEEDS_POLL: no interrupt is requested and the core polls the
	 * cd-gpios line about once a second, so insertion and removal are still
	 * detected within about a second. */
	broken-cd;
	status = "okay";
};

&gpu {
	status = "okay";
	mali-supply = <&reg_0p8v>;
};

/* Display 1 (J6): RK055HDMIPI4MA0 720x1280 MIPI-DSI panel.
 * The V2N's single DSI feeds the connector DSI0 lane set -> J6 directly
 * (no bridge/mux on this carrier). Display 2 (J28) sits on the DSI1
 * lane set, which the V2N family does not populate -- permanently
 * unavailable on V2N/V2M.
 * Panel rails are always-on; VIO is modeled here as the carrier's
 * default 3V3 setting. LCD1_PWR_EN (IO15) is pulled high on the carrier
 * and IO15 is unrouted on V2N -- no power GPIO needed. Panel reset =
 * E1M-X IO13 via bridge GPIO line 5.
 * Touch (GT911 on the panel FFC) is NOT wired here: its bus
 * (DSI1_CSI_I2C = E1M-X I2C3) has no Linux master today, so Linux has
 * no path to it until
 * the bridge gains an I2C-master proxy. Tracked as a follow-up; the
 * goodix polled-mode patch already ships dormant for that stack.
 */
&du {
	status = "okay";
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "rocktech,rk055hdmipi4ma0";
		reg = <0>;
		reset-gpios = <&gd32_gpio 5 GPIO_ACTIVE_LOW>;
		vcc-supply = <&reg_3p3v>;
		iovcc-supply = <&reg_3p3v>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};

	/* port@1 merges with the SoC dtsi's existing dsi0/ports/port@1
	 * node (which carries the dsi0_out label).  The label is NOT
	 * re-declared here to avoid a duplicate-label dtc error; the
	 * panel_in remote-endpoint above resolves via the SoC label. */
	ports {
		port@1 {
			endpoint {
				remote-endpoint = <&panel_in>;
				data-lanes = <1 2>;
			};
		};
	};
};

/* Dual GbE — MACs on the carrier RJ45s; PHYs are on-module (SoM dtsi). */
&eth0 {
	pinctrl-0 = <&eth0_pins>;
	pinctrl-names = "default";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&eth1 {
	pinctrl-0 = <&eth1_pins>;
	pinctrl-names = "default";
	phy-handle = <&phy1>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	/* 100 kHz: on-module EEPROM bus on internal pull-ups (weak ~50k). */
	clock-frequency = <100000>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

/* No &i2c6/&i2c7: P44-P47 are the E1M_X_I2S0 pads (SSIU1_SSI1 SCK/WS/SDATA +
 * SSIU2_SSI2_SDATA, function 7, renesas-peripheral-map.csv:112-115) wired to the
 * TAS2563 pair through the carrier's TMUX1574. RZ/V2N has no RIIC6/RIIC7 on those
 * pins in this SoM's pin map, and nothing on the carrier sits on them. */

&i2c8 {
	pinctrl-0 = <&i2c8_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

&scif {
	pinctrl-0 = <&scif_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* USB 2.0 host (OTG) + USB 3.0.  The carrier's OVC sense wiring is not
 * usable (errata E3).  P9.6 (usb20) can no longer be parked as a GPIO:
 * it is SCK7 of the CM33-owned GD32 supervisor SPI, and the CM33 is
 * started by BL2 PRE-Linux -- so the old hog actually clobbered the
 * live SCK7 mux at every Linux boot (~1.9 s, PMC9 byte-RMW; same
 * clobber class as SD1_CD below) until the CM33's own pin re-init took
 * the pad back, which is also why usb20 OVC suppression was lost.  The
 * usb20 channel is instead suppressed at the controller: spurious-oc on
 * the EHCI (generic binding, in-tree) and on the OHCI (kernel patch
 * 0003 adds the same property).  OC processing is fully off for usb20
 * -- correct here because VBUS is hardwired always-on with no per-port
 * switching to protect.
 *
 * usb30 has no VBUS pinmux and no OVC-disable GPIO hog: PB0 (VBUS,
 * func14) and PB1 (usb30 OVC) are on-module WLAN_SDIO.CLK and
 * WLAN_SDIO.D0 (e1m-v2n-som.dtsi's sd2_wlan_pins, &sdhi2) -- on-module
 * nets that never reach the E1M connector, so this carrier cannot claim
 * either pin. The old usb30_pins/hog pair was copied from the Renesas
 * EVK reference dts without checking the ALP module's netlist. usb30 OC
 * processing is left at its EHCI/xHCI default (not yet suppressed at
 * the controller); BENCH TODO: verify xHCI reports no spurious
 * over-current with PB1 now muxed as SD2DAT0 instead of a parked GPIO
 * input -- if it does, suppress usb30 OC at the controller the same way
 * usb20 is suppressed above. */
&ehci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	spurious-oc;
	status = "okay";
};

&ohci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	spurious-oc;
	status = "okay";
};

&hsusb {
	dr_mode = "otg";
	status = "okay";
};

&usb20phyrst {
	status = "okay";
};

&usb2_phy0_vbus_otg {
	status = "okay";
};

&usb2_phy0 {
	/* USB2.0 VBUS is always-on (hardwired) on the E1M-X carrier, so no
	 * VBUS GPIO/pinmux is needed. The old usb20_pins hogged P95 (func 14),
	 * which is the DEEPX PCIe mux-sel on V2M and MUST stay a GPIO (U-Boot
	 * drives it; no Linux hog or pinctrl claim). Dropped. */
	vbus-supply = <&usb2_phy0_vbus_otg>;
	status = "okay";
};

/* USB 3.0 Type-A host VBUS: a carrier power switch whose enable net is
 * USB30_VBUSEN = E1M-X pad AQ10 (I2S1_SDO) = RZ/V2N P15 (SSIU4_SSI4_SDATA,
 * metadata/e1m_modules/v2n/renesas-peripheral-map.tsv).  Bench-proven
 * 2026-10-01: with P15 unclaimed the port is unpowered and nothing
 * enumerates; driving it high enumerates a stick on xhci.  Nothing else in
 * the carrier/SoM/DEEPX dtsi claims P15 (the TAS2563 pair uses P12 and P04
 * from the same I2S1 group).
 *
 * The 6.1 renesas usb3 PHY (phy-rz-usb3.c) and rzv2h xHCI driver consume no
 * vbus supply, so there is no phy/xhci property to hang this on: the
 * regulator is regulator-always-on + regulator-boot-on, which makes the
 * regulator core drive the GPIO high at boot.  No OVC feedback is wired
 * (see the usb30 note above).  The USB 2.0 VBUS enable (USB20_VBUSEN, pad
 * AQ11 / P13) feeds an unused switch output on this carrier and is left
 * alone. */
/ {
	reg_usb30_vbus: regulator-usb30-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb30-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&pinctrl RZV2N_GPIO(1, 5) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};
};

&usb3_phy0 {	status = "okay";
};

&xhci0 {
	memory-region = <&global_cma>;
	status = "okay";
};

&pinctrl {
	eth0_pins: eth0 {
		pins = "ET0_TXC_TXCLK";
		output-enable;
	};

	eth1_pins: eth1 {
		pins = "ET1_TXC_TXCLK";
		output-enable;
	};

	/* Unlike the Renesas EVK (external pull-ups on RIIC0/1), external
	 * pull-up population on this ALP module for RIIC0 (on-module EEPROM
	 * bus) or RIIC1 is TBD -- not yet confirmed against the
	 * schematic/BOM. RIIC8 (BRD_I2C) IS populated: external 2.2 kOhm
	 * pull-ups to the 1.8 V rail are fitted, confirmed on the same
	 * bench pass that root-caused the arbitration-lost failure below.
	 * Enable the SoC internal pull-ups on all three regardless, so
	 * SCL/SDA idle high even where population is unconfirmed.
	 * For RIIC8/BRD_I2C the internal pull-up was bench-confirmed
	 * required at the unpatched (faster) RIIC8 clock (E1M-V2M103,
	 * U-Boot bcf29d98) -- without it, reads failed with
	 * arbitration-lost (ICSR2 AL) on the very first read, the external
	 * pull-ups above notwithstanding. It is carried alongside the
	 * slower CKS(5) clock now shipped for RIIC8 rather than re-tested
	 * for necessity at that clock. A slower RIIC8 SCL is separately
	 * required for burst reads on this same bus (loaded with ~13
	 * populated branches): see the matching U-Boot fix,
	 * meta-alp-sdk/recipes-bsp/u-boot/u-boot/
	 * 0006-rzv2n-dev-i2c-rzg2l_riic-p06-p07-pullup-clock-fix.patch, and
	 * changelog.d/2045-v2m-deepx-rail-uboot.md for the bench matrix. */
	i2c0_pins: i2c0 {
		pinmux = <RZV2N_PORT_PINMUX(3, 0, 1)>, /* I2C0_SDA */
			 <RZV2N_PORT_PINMUX(3, 1, 1)>; /* I2C0_SCL */
		bias-pull-up;
	};

	i2c1_pins: i2c1 {
		pinmux = <RZV2N_PORT_PINMUX(3, 2, 1)>, /* I2C1_SDA */
			 <RZV2N_PORT_PINMUX(3, 3, 1)>; /* I2C1_SCL */
		bias-pull-up;
	};

	i2c8_pins: i2c8 {
		pinmux = <RZV2N_PORT_PINMUX(0, 6, 1)>, /* I2C8_SDA */
			 <RZV2N_PORT_PINMUX(0, 7, 1)>; /* I2C8_SCL */
		bias-pull-up;
	};

	scif_pins: scif {
		pins = "SCIF_TXD", "SCIF_RXD";
		renesas,output-impedance = <1>;
	};

	/* Audio: I2S0 (SSIU1 SCK/WS/SDATA) -> TAS2563 pair via the TMUX1574
	 * path-mux, + Audio_CLKB (the 5L35023B SE3 24.576 MHz reference into
	 * the ADG). One wrapper node with labeled leaf sub-nodes, referenced
	 * as a single phandle from &rcar_sound's pinctrl-0 -- same shape as
	 * this SoC's own stock RZ/V2N EVK reference dts `sound_pins` node.
	 * Function 7 + P<port><pin> confirmed against that reference dts's
	 * SSI3/4 + AUDIO_CLK pinctrl entries (RZV2N_PORT_PINMUX(port, pin,
	 * 7)) -- see this file's header comment. SSI1's own SDATA (P46) is
	 * left unclaimed on purpose (it is the amps' SDOUT net); playback
	 * uses SSI2's SDATA (P47). See &rcar_sound's comment. */
	sound_pins: sound {
		ssi1_pins: ssi1 { /* SCK/WS from SSI1, data from SSI2 */
			pinmux = <RZV2N_PORT_PINMUX(4, 4, 7)>, /* SSIU1_SSI1_SCK */
				 <RZV2N_PORT_PINMUX(4, 5, 7)>, /* SSIU1_SSI1_WS */
				 <RZV2N_PORT_PINMUX(4, 7, 7)>; /* SSIU2_SSI2_SDATA */
		};

		audio_clkb_pins: audio_clkb {
			pinmux = <RZV2N_PORT_PINMUX(1, 0, 7)>; /* AUDIO_CLKB */
		};
	};

	/* SD1 CLK/CMD/DAT need explicit dedicated-pin config, same as SDHI0
	 * eMMC in e1m-v2n-som.dtsi's sdhi0_emmc_pins -- pinctrl-rzg2l has no
	 * default mapping for dedicated balls without one. Names + bank/pin
	 * per the kernel's pinctrl-rzg2l.c r9a09g056 dedicated-pin table:
	 * SD1CLK (0xb/0), SD1CMD (0xb/1), SD1DAT0-3 (0xc/0-3).
	 *
	 * SD1_CD needs no pin entry: PA1 is read as a plain GPIO through
	 * &sdhi1's cd-gpios. */
	sdhi1_pins: sd1 {
		sd1-clk {
			pins = "SD1CLK";
			renesas,output-impedance = <2>;
			slew-rate = <0>;
		};

		sd1-dat-cmd {
			pins = "SD1DAT0", "SD1DAT1", "SD1DAT2", "SD1DAT3", "SD1CMD";
			input-enable;
			renesas,output-impedance = <2>;
			slew-rate = <0>;
		};
	};

	/* microSD slot power enable (PA3/SD1_SD1PWEN). Always-on by design,
	 * not a placeholder for a PWEN-gated regulator: SD1_CD's pull-up
	 * sits on this same switched rail (see &sdhi1's comment above), so
	 * gating it off from the MMC core would read an absent card as
	 * present whenever power is off. */
	sd1-pwr-en-hog {
		gpio-hog;
		gpios = <RZV2N_GPIO(A, 3) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sd1_pwr_en";
	};

	/* No usb20 (USB2.0 VBUS) pinmux: VBUS is always-on (hardwired) on this
	 * carrier, and P95 is the DEEPX PCIe mux-sel on V2M (kept as GPIO).
	 *
	 * No usb30 pinmux or OVC-disable hog either: PB0 (VBUS, func14) and
	 * PB1 (usb30 OVC) are the on-module WLAN_SDIO.CLK and WLAN_SDIO.D0
	 * nets (see &xhci0's comment above) -- they never reach this
	 * carrier's E1M connector, so no carrier-level pinctrl group may
	 * claim them. */

	/* Audio_CLKB_OE (P67): host-driven output-enable for the on-module
	 * 5L35023B's Audio_CLKB. metadata/chips/clk_5l35023b.yaml: "OTP
	 * defaults + the Audio_CLKB_OE GPIO... cover normal operation -- no
	 * [I2C control] master access [needed]" -- an always-on hog is
	 * sufficient; there is no runtime gating requirement to build a
	 * driver for. */
	audio-clkb-oe-hog {
		gpio-hog;
		gpios = <RZV2N_GPIO(6, 7) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "audio_clkb_oe";
	};
};
