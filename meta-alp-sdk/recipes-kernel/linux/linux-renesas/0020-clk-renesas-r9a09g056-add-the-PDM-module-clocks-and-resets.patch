From: Alp Lab AB <contact@alplab.ai>
Subject: [PATCH] clk: renesas: r9a09g056: add the PDM module clocks and resets

Copyright (c) 2026 Alp Lab AB
SPDX-License-Identifier: GPL-2.0

The RZ/V2N CPG driver has no PDM0/PDM1 entries, so a pdm node cannot
get its clocks or resets. Add them, with the same register positions as
the RZ/V2H driver (CPG_CLKON_16 bits 1-6, CPG_RST_15 bits 2-5, BUS_MSTOP
register 5 bits 6 and 7) and V2N-specific parents taken from the RZ/V2N
hardware manual (R01UH1071EJ0120 Rev.1.20, table 4.4-2, list of clock
signals):

  - PDM_x_PCLK and PDM_x_PCLK_SFR: PLLCM33, dynamic gear, 100 MHz at
    reset. That is the existing .pllcm33_gear divider (CPG_CDDIV0
    DIVCTL1, 200 MHz at reset) divided by two, so add a fixed /2 child.
  - PDM_x_CCLK: main oscillator, 4.8 MHz, so add a fixed /5 child of
    the 24 MHz QEXTAL.

The RZ/V2H parents (CLK_PLLCM33_DIV4_DDIV2_DIV2, CDIV5_MAINOSC) do not
exist in this driver, which is why the V2H entries cannot be copied
as-is. No devicetree node uses these clocks yet.

Upstream-Status: Pending
Signed-off-by: Alp Lab AB <contact@alplab.ai>
---
--- a/drivers/clk/renesas/r9a09g056-cpg.c
+++ b/drivers/clk/renesas/r9a09g056-cpg.c
@@ -50,6 +50,8 @@
 	CLK_SMUX2_XSPI_CLK1,
 	CLK_PLLCM33_XSPI,
 	CLK_PLLCM33_GEAR,
+	CLK_PLLCM33_GEAR_DIV2,
+	CLK_QEXTAL_DIV5,
 	CLK_PLLCM33_ADC_ADCLK,
 	CLK_PLLCM33_ADC_PCLK,
 	CLK_PLLCM33_ADC_PCLK_DIV2,
@@ -208,6 +210,8 @@
 	DEF_CSDIV(".pllcm33_xspi", CLK_PLLCM33_XSPI, CLK_SMUX2_XSPI_CLK1, CSDIV0_DIVCTL3,
 		  dtable_2_16),
 	DEF_DDIV(".pllcm33_gear", CLK_PLLCM33_GEAR, CLK_PLLCM33_DIV4, CDDIV0_DIVCTL1, dtable_2_64),
+	DEF_FIXED(".pllcm33_gear_div2", CLK_PLLCM33_GEAR_DIV2, CLK_PLLCM33_GEAR, 1, 2),
+	DEF_FIXED(".qextal_div5", CLK_QEXTAL_DIV5, CLK_QEXTAL, 1, 5),
 	DEF_CSDIV(".pllcm33_adc_pclk", CLK_PLLCM33_ADC_PCLK, CLK_PLLCM33_DIV2, CSDIV1_DIVCTL0,
 		  dtable_8_10),
 	DEF_FIXED(".pllcm33_adc_pclk_div2", CLK_PLLCM33_ADC_PCLK_DIV2, CLK_PLLCM33_ADC_PCLK, 1, 2),
@@ -655,6 +659,18 @@
 						BUS_MSTOP(1, BIT(10))),
 	DEF_MOD("spdif_2_clkp",			CLK_PLLDTY_DIV16, 16, 0, 8, 0,
 						BUS_MSTOP(1, BIT(11))),
+	DEF_MOD("pdm_0_pclk",			CLK_PLLCM33_GEAR_DIV2, 16, 1, 8, 1,
+						BUS_MSTOP(5, BIT(6))),
+	DEF_MOD("pdm_0_pclk_sfr",		CLK_PLLCM33_GEAR_DIV2, 16, 2, 8, 2,
+						BUS_MSTOP(5, BIT(6))),
+	DEF_MOD("pdm_0_cclk",			CLK_QEXTAL_DIV5, 16, 3, 8, 3,
+						BUS_MSTOP(5, BIT(6))),
+	DEF_MOD("pdm_1_pclk",			CLK_PLLCM33_GEAR_DIV2, 16, 4, 8, 4,
+						BUS_MSTOP(5, BIT(7))),
+	DEF_MOD("pdm_1_pclk_sfr",		CLK_PLLCM33_GEAR_DIV2, 16, 5, 8, 5,
+						BUS_MSTOP(5, BIT(7))),
+	DEF_MOD("pdm_1_cclk",			CLK_QEXTAL_DIV5, 16, 6, 8, 6,
+						BUS_MSTOP(5, BIT(7))),
 	DEF_MOD("adc_pclk",			CLK_PLLCM33_ADC_PCLK_DIV2, 16, 7, 8, 7,
 						BUS_MSTOP(3, BIT(9))),
 	DEF_MOD("adc_adclk",			CLK_PLLCM33_ADC_ADCLK, 16, 8, 8, 8,
@@ -842,6 +858,10 @@
 	DEF_RST(14, 15, 7, 0),		/* SPDIF_0_RST */
 	DEF_RST(15, 0, 7, 1),		/* SPDIF_1_RST */
 	DEF_RST(15, 1, 7, 2),		/* SPDIF_2_RST */
+	DEF_RST(15, 2, 7, 3),		/* PDM_0_PRESETN */
+	DEF_RST(15, 3, 7, 4),		/* PDM_0_CRESETN */
+	DEF_RST(15, 4, 7, 5),		/* PDM_1_PRESETN */
+	DEF_RST(15, 5, 7, 6),		/* PDM_1_CRESETN */
 	DEF_RST(15, 6, 7, 7),		/* ADC_ADRST_N */
 	DEF_RST(15, 7, 7, 8),		/* TSU_0_PRESETN */
 	DEF_RST(15, 8, 7, 9),		/* TSU_1_PRESETN */
