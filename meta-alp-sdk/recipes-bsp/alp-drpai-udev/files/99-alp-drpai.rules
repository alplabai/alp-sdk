#
# RZ/V2N DRP-AI3 NPU node: without this it comes up root-only (0600), so a
# non-root <alp/inference.h> DRP-AI app fails to open it (#2381).  Same policy
# as the DEEPX /dev/dxrt* nodes (dx-driver_%.bbappend): group video, 0660.
KERNEL=="drpai[0-9]*", MODE="0660", GROUP="video"
