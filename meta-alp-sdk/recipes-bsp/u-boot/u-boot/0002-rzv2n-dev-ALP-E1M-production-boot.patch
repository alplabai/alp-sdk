From 023b67a44b2d0fed75c912c6685853a2f3b3a2e6 Mon Sep 17 00:00:00 2001
From: Alp Lab AB <contact@alplab.ai>
Date: Fri, 12 Jun 2026 13:47:22 +0200
Subject: [PATCH] rzv2n-dev: ALP E1M production boot: eMMC 1.8 V rail + pinned
 console

Two build-gated ALP E1M additions:

CONFIG_ALP_E1M_EMMC_1V8 (default y for rzv2n-dev): drive eMMC_V_SEL
(PA0) high in board_init, which runs before initr_mmc/initr_env in
init_sequence_r -- the E1M SoM's eMMC/SD0 IO rail powers up at 3.3 V
from an on-module pull-down, and eMMC defines VccQ as fixed from card
init with no live voltage-switch handshake.  With the rail parked at
1.8 V before the first MMC access, U-Boot's own environment load and
kernel load run the card at its proper signaling voltage and the card
never sees a VccQ transition; Linux re-asserts the same level via a
gpio-hog.  Not enabled for stock Renesas boards whose SD0 channel may
carry a 3.3 V SD card.

CONFIG_ALP_PROD_BOOT (default n, DEV-target only -- the rzv2n-evk.h
config has no override): rebuild the kernel cmdline with the
production settings (console=ttySC0,115200 + quiet loglevel=4,
earlycon dropped); the dev cmdline keeps earlycon but gains the pinned
console=, which stops the kernel replaying the early log across the
console handover.  The cmdline is rebuilt at CONFIG_BOOTCOMMAND rather
than by editing the env block: that block is patched by optional
vendor feature layers (meta-rz-drpai add-ether) and varies per build,
so the stable CONFIG_BOOTCOMMAND line is the only patch-safe hook.

Signed-off-by: Alp Lab AB <contact@alplab.ai>
---
 board/renesas/rzv2n-dev/Kconfig     | 24 ++++++++++++++++++++++++
 board/renesas/rzv2n-dev/rzv2n-dev.c | 11 +++++++++++
 configs/rzv2n-dev_defconfig         |  1 +
 include/configs/rzv2n-dev.h         | 71 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-
 4 files changed, 107 insertions(+), 1 deletion(-)

diff --git a/board/renesas/rzv2n-dev/Kconfig b/board/renesas/rzv2n-dev/Kconfig
index 4ef61be..bfabe66 100644
--- a/board/renesas/rzv2n-dev/Kconfig
+++ b/board/renesas/rzv2n-dev/Kconfig
@@ -30,3 +30,27 @@ config SYS_CONFIG_NAME
 
 endif
 
+
+config ALP_E1M_EMMC_1V8
+	bool "ALP E1M: drive eMMC_V_SEL (PA0) high before MMC init"
+	depends on TARGET_RZV2N_DEV || TARGET_RZV2N_EVK
+	help
+	  On the ALP E1M V2N SoM family the eMMC/SD0 IO rail is
+	  GPIO-selected (PA0, on-module pull-down -> 3.3 V at power-on).
+	  Drive it high in board_init, which runs before initr_mmc and
+	  initr_env in init_sequence_r -- so VccQ is a stable 1.8 V
+	  before the first MMC access (env load, kernel load).  eMMC
+	  defines VccQ as fixed from card init and has no live
+	  voltage-switch handshake.  Do NOT enable on boards whose SD0
+	  channel carries a 3.3 V SD card.
+
+config ALP_PROD_BOOT
+	bool "ALP E1M: production kernel cmdline (quiet, no earlycon)"
+	depends on TARGET_RZV2N_DEV
+	help
+	  Rebuild the kernel cmdline with the production settings:
+	  console=ttySC0,115200 + quiet loglevel=4, earlycon dropped.
+	  Pair with CONFIG_BOOTDELAY=0 and CONFIG_AUTOBOOT_KEYED (the
+	  ALP prod-boot.cfg fragment).  DEV-target only: the cmdline
+	  rebuild lives in include/configs/rzv2n-dev.h; rzv2n-evk.h has
+	  no override, so the symbol would half-apply there.
+
+config ALP_E1M_FDTFILE
+	string "ALP E1M: board dtb filename loaded from the boot partition"
+	depends on TARGET_RZV2N_DEV
+	default "e1m-v2n101-x-evk.dtb"
+	help
+	  Basename of the board device tree CONFIG_BOOTCOMMAND loads from
+	  boot/ on the rootfs partition.  It must match the MACHINE's
+	  KERNEL_DEVICETREE basename, because that is the only dtb the
+	  image actually contains.
+
+	  The default suits the V2N SKUs.  V2M SKUs build
+	  e1m-v2m101-x-evk.dtb and MUST override this -- meta-alp-sdk
+	  injects it per-MACHINE via fdtfile-v2m.cfg.  Getting it wrong
+	  is silent: ext4load of a missing file leaves whatever dtb was
+	  already in RAM, and the board boots the wrong device tree.
+
+	  Set the basename only.  KERNEL_DEVICETREE carries a "renesas/"
+	  prefix that the deploy step strips, so the file lands at
+	  boot/<basename> on the target.
diff --git a/board/renesas/rzv2n-dev/rzv2n-dev.c b/board/renesas/rzv2n-dev/rzv2n-dev.c
index b5f159a..a20ccae 100644
--- a/board/renesas/rzv2n-dev/rzv2n-dev.c
+++ b/board/renesas/rzv2n-dev/rzv2n-dev.c
@@ -378,6 +378,17 @@ int board_init(void)
 	/* address of boot parameters */
 	gd->bd->bi_boot_params = CONFIG_TEXT_BASE + 0x50000;
 
+#ifdef CONFIG_ALP_E1M_EMMC_1V8
+	/* eMMC_V_SEL (PA0): the E1M SoM's eMMC/SD0 IO rail powers up
+	 * at 3.3 V (on-module pull-down).  Park it at 1.8 V here --
+	 * board_init runs before initr_mmc/initr_env in
+	 * init_sequence_r, so the rail is stable before the first MMC
+	 * access: eMMC defines VccQ as fixed from card init and must
+	 * never see a mid-session change.  Linux re-asserts the same
+	 * level via a gpio-hog. */
+	alp_gpio_output(10, 0, 1);
+#endif
+
 	board_usb_init();
 
 	return 0;
diff --git a/configs/rzv2n-dev_defconfig b/configs/rzv2n-dev_defconfig
index 7ced1c5..e04099d 100644
--- a/configs/rzv2n-dev_defconfig
+++ b/configs/rzv2n-dev_defconfig
@@ -97,3 +97,4 @@ CONFIG_USB_GADGET_DOWNLOAD=y
 CONFIG_USB_FUNCTION_MASS_STORAGE=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 
+CONFIG_ALP_E1M_EMMC_1V8=y
diff --git a/include/configs/rzv2n-dev.h b/include/configs/rzv2n-dev.h
index ad8f46a..ac562a9 100644
--- a/include/configs/rzv2n-dev.h
+++ b/include/configs/rzv2n-dev.h
@@ -70,7 +70,76 @@
 	"sd2load=ext4load mmc 1:2 0x48080000 boot/Image;ext4load mmc 1:2 0x48000000 boot/r9a09g056n44-dev.dtb;run prodsdbootargs \0" \
 	"bootcmd_check=if mmc dev 1; then run sd2load; else run emmcload; fi \0"
 
-#define CONFIG_BOOTCOMMAND	"env default -a;run bootcmd_check;run bootimage"
+/* ALP: kernel cmdline base.  console= pinned so the early kernel log
+ * is not replayed across the console handover; the production build
+ * drops earlycon and quiets the console. */
+#ifdef CONFIG_ALP_PROD_BOOT
+#define ALP_BOOTARGS_BASE	"console=ttySC0,115200 rootwait rw quiet loglevel=4"
+#else
+#define ALP_BOOTARGS_BASE	"console=ttySC0,115200 rootwait rw earlycon"
+#endif
+
+/* ALP: bootargs are REBUILT here rather than by editing the env block
+ * above -- that block is patched by optional vendor feature layers
+ * (e.g. meta-rz-drpai add-ether) and its contents vary per build, so
+ * an override at this stable line is the only patch-safe hook.  The
+ * vendor prodsd/prodemmcbootargs still run inside *load but are
+ * deliberately overridden (left untouched for patch safety).  The
+ * sd-vs-emmc root choice mirrors bootcmd_check.
+ *
+ * SD + eMMC dtb: the vendor sd2load env (above, untouched for patch
+ * safety) loads "boot/r9a09g056n44-dev.dtb" -- a name none of our
+ * KERNEL_DEVICETREE builds ever produce (V2N101 and V2N102 both build
+ * renesas/e1m-v2n101-x-evk.dtb today -- see
+ * meta-alp-sdk/conf/machine/e1m-v2n10{1,2}-a55.conf.  V2N102's own
+ * conf HARDCODES this same filename at line 36 (it does not inherit
+ * it -- only one machine conf is parsed per build); that line carries
+ * a TODO to create a V2N102-specific dtb once its DDR map is
+ * confirmed, with its own note that this bootcmd must change in
+ * lockstep if that TODO ever lands); that load silently fails
+ * (";"-chained, non-fatal) and bootimage would then boot the
+ * stale/garbage dtb already in RAM.
+ * The vendor emmcload env has the identical defect.  Its body is not
+ * visible in THIS patch's own diff context (do_patch context lines
+ * stop above line 70), but is confirmed against the unpatched vendor
+ * default in the RZ/V AI SDK BSP source package,
+ * meta-rz-features/meta-rz-codecs/recipes-bsp/u-boot/files/
+ * 0001-Add-OpenCVA-and-Codec-for-V2N.patch (the "-" / pre-patch context
+ * lines, rzv2n-dev.h hunk):
+ *   "emmcload=ext4load mmc 0:2 0x48080000 boot/Image;ext4load mmc 0:2
+ *   0x48000000 boot/r9a09g056n44-dev.dtb;run prodemmcbootargs \0"
+ * -- i.e. Image at 0x48080000, dtb at 0x48000000, partition 2, exactly
+ * mirroring sd2load with the eMMC device index (SDHI0=mmc0 vs SD's
+ * SDHI1=mmc1).  The same vendor patch's "bootimage" line confirms
+ * 0x48000000 is the dtb address independent of which *load ran:
+ * "bootimage=booti 0x48080000 - 0x48000000 \0" -- booti's 3rd arg is
+ * the fdt address, so this is proof by consumer, not just by the
+ * *load producer.  meta-rz-codecs IS in our layer set
+ * (meta-alp-sdk/conf/layer.conf), so its "+" side (which prepends
+ * ${ocaaddr}/${codaddr} OpenCVA/Codec loads to emmcload/sd2load) is
+ * what actually ships, not the pristine form quoted above -- the
+ * 0x48080000/0x48000000/partition-2 values are unchanged by that
+ * rewrite, only extra loads are prepended.  Re-load the correct dtb
+ * on BOTH branches here instead, overwriting whatever sd2load/emmcload
+ * staged before bootimage runs, same address + mmc spec each already
+ * uses (0x48000000, "mmc 1:2" / "mmc 0:2").
+ * alp_root for the SD branch is also corrected: mmc1 is the carrier
+ * microSD (SDHI1, alias mmc1 in e1m-x-evk.dtsi) -> Linux /dev/mmcblk1,
+ * not mmcblk2 (no third controller exists on this SoM).  mmc0 (SDHI0
+ * eMMC) -> mmcblk0 was already correct.
+ * Per-SKU dtb: done, via CONFIG_ALP_E1M_FDTFILE (a Kconfig string
+ * injected per-MACHINE by a .cfg fragment, the same channel
+ * prod-boot.cfg uses).  It is a BUILD-time selection, which is correct
+ * while one MACHINE produces one image.  An EEPROM-manifest-derived
+ * fdtfile -- one image booting on several SKUs -- remains future work
+ * and would have to be set AFTER the leading "env default -a" wipe. */
+/* ALP: the dtb basename is a per-SKU Kconfig string, not a literal.
+ * V2N SKUs build e1m-v2n101-x-evk.dtb and V2M SKUs build
+ * e1m-v2m101-x-evk.dtb (meta-alp-sdk/conf/machine/e1m-v2{n,m}10*-a55.conf,
+ * each of which carries its own "the U-Boot bootcmd must load this
+ * filename" note).  A hardcoded name meant every V2M image asked for a
+ * file it does not contain. */
+
+/* ALP: the loads are now FATAL, and that is the point of this block.
+ * Every load here used to be ';'-chained, i.e. non-fatal: a missing
+ * kernel Image or a missing dtb left whatever those addresses already
+ * held and "run bootimage" then booted it.  On a cold boot that is
+ * garbage; on a warm one it is the PREVIOUS boot's image, which is
+ * worse -- it looks like a successful boot of the wrong software.
+ * Both loads are re-issued here with '&&' so bootimage is reached only
+ * when both landed, and the failure branch stops at the prompt instead.
+ *
+ * Re-loading Image is deliberate even though bootcmd_check's vendor
+ * sd2load/emmcload already tried: those envs are patched by vendor
+ * feature layers (meta-rz-drpai, meta-rz-opencva) and cannot be relied
+ * on to fail loudly.  Same address and same mmc spec each already uses,
+ * so the re-load is idempotent when the vendor path worked. */
+#define CONFIG_BOOTCOMMAND	"env default -a;run bootcmd_check;" \
+	"if mmc dev 1; then " \
+	"setenv alp_mmc 1:2;setenv alp_root /dev/mmcblk1p2; else " \
+	"setenv alp_mmc 0:2;setenv alp_root /dev/mmcblk0p2; fi;" \
+	"if ext4load mmc ${alp_mmc} 0x48080000 boot/Image" \
+	" && ext4load mmc ${alp_mmc} 0x48000000 boot/" CONFIG_ALP_E1M_FDTFILE "; then " \
+	"setenv bootargs " ALP_BOOTARGS_BASE " root=${alp_root};" \
+	"run bootimage; fi;" \
+	"echo ALP: kernel Image or " CONFIG_ALP_E1M_FDTFILE " failed to load" \
+	" from boot/ on mmc ${alp_mmc} -- NOT booting a stale RAM image"
 
 /* For board */
 /* Ethernet RAVB */
-- 
2.34.1

