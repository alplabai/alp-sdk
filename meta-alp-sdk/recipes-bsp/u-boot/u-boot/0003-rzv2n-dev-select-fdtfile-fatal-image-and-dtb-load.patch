From 4e9a2c1b7f6d0834ab55e19c2d6f0a1b8c7d3e5f Mon Sep 17 00:00:00 2001
From: Alp Lab AB <contact@alplab.ai>
Date: Mon, 24 Aug 2026 10:00:00 +0200
Subject: [PATCH] rzv2n-dev: select bootcmd's dtb by SoM family, make Image +
 dtb loads fatal

CONFIG_BOOTCOMMAND hardcoded boot/e1m-v2n101-x-evk.dtb on both the SD and
eMMC branches.  All four V2N/V2M machines (e1m-v2n101/102-a55,
e1m-v2m101/102-a55) share this one u-boot binary/config, but only V2N
machines' KERNEL_DEVICETREE matches that name -- a V2M SKU loaded a
filename that does not exist in its own image (#1252).

The fix reuses the on-module EEPROM manifest read the DEEPX bring-up
(0001) already performs -- alp_som_is_v2n_m1() -- rather than swapping
one hardcoded name for another.  A new alpselectfdt command sets
alp_fdtfile to the matching dtb; it is exposed as a command, not just
called from board_late_init(), because CONFIG_BOOTCOMMAND cannot call C
directly, and any env var board_late_init() set that early would be
wiped by bootcmd's own leading "env default -a" (env_set_default()'s
himport_r() rebuilds the whole hash table from the compiled-in default
block, dropping anything else) -- so alpselectfdt runs from bootcmd
AFTER that wipe instead.  An unreadable manifest makes
alp_som_is_v2n_m1() return false, so alp_fdtfile falls back to the V2N
(non-DEEPX) name -- the same dtb this bootcmd hardcoded before this fix,
so a manifest fault degrades to the old behaviour rather than a new
failure mode.

Separately (#1302), the vendor sd2load/emmcload env (still untouched,
patched by optional vendor feature layers) stages the kernel Image with
a ";"-chained, non-fatal ext4load -- a missing/truncated boot/Image was
silently followed by booti-ing stale RAM content, the same failure
class #1252 fixes for the dtb.  Both the Image and the dtb are now
re-loaded fatally: a failed load prints "ALP FATAL: ..." and bootcmd
simply ends without calling bootimage, leaving U-Boot at the interactive
prompt instead of continuing into booti.  This does not strand the
board -- the dev cmdline's interruptible autoboot (BOOTDELAY/
AUTOBOOT_KEYED) and the U-Boot USB gadget download path
(CONFIG_USB_GADGET_DOWNLOAD + CONFIG_CMD_USB_MASS_STORAGE, already in
rzv2n-dev_defconfig) both still reach the same recovery paths as before.

VALIDATION: applies cleanly (`patch -p1`) on top of 0001+0002 against
the renesas-u-boot-cip rzv2n-family SRCREV this BSP pins (2024.07,
bcf29d98); rebuilt rzv2n-dev_defconfig end to end with the same
aarch64-poky-linux- cross toolchain and STAGING sysroot this recipe
uses (0 warnings, 0 errors) and content-verified the resulting
u-boot.bin: `strings` shows the alpselectfdt command registered
(_u_boot_list_2_cmd_2_alpselectfdt) and the compiled-in default
"bootcmd" environment string matches this patch's CONFIG_BOOTCOMMAND
exactly, both dtb filenames present.  NOT bench-verified: the EEPROM
manifest read, the SD/eMMC branch selection, and the hush "if/then/
else/fi" runtime behaviour (does bootcmd actually stop at the prompt
rather than resetting or looping) all need a real V2N/V2M board on the
serial console -- V2M101 bring-up is currently blocked on separate
hardware issues.

Signed-off-by: Alp Lab AB <contact@alplab.ai>
---
 board/renesas/rzv2n-dev/rzv2n-dev.c |  25 +++++++++
 include/configs/rzv2n-dev.h         | 103 ++++++++++++++++++------------------
 2 files changed, 77 insertions(+), 51 deletions(-)

diff --git a/board/renesas/rzv2n-dev/rzv2n-dev.c b/board/renesas/rzv2n-dev/rzv2n-dev.c
index a20ccae..6f69362 100644
--- a/board/renesas/rzv2n-dev/rzv2n-dev.c
+++ b/board/renesas/rzv2n-dev/rzv2n-dev.c
@@ -27,6 +27,8 @@
 #include <linux/delay.h>
 #include <u-boot/crc.h>
 #include <asm/unaligned.h>
+#include <command.h>
+#include <env.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -360,6 +362,29 @@ static void alp_deepx_pcie_bringup(void)
 	printf("ALP: DEEPX DX-M1 PCIe path enabled (mux on, reset released)\n");
 }
 
+/* ALP: select the kernel devicetree filename (alp_fdtfile) by the
+ * on-module SoM family -- reusing the same EEPROM manifest read as the
+ * DEEPX bring-up above (alp_som_is_v2n_m1()).  Exposed as a command,
+ * not just called from board_late_init() below, because
+ * CONFIG_BOOTCOMMAND cannot call C directly, and any env var
+ * board_late_init() set this early would be wiped by bootcmd's own
+ * leading "env default -a" -- this command is meant to run from
+ * bootcmd AFTER that wipe (see rzv2n-dev.h). */
+static int do_alp_selectfdt(struct cmd_tbl *cmdtp, int flag, int argc,
+			     char *const argv[])
+{
+	const char *fdt = alp_som_is_v2n_m1() ?
+		"e1m-v2m101-x-evk.dtb" : "e1m-v2n101-x-evk.dtb";
+
+	return env_set("alp_fdtfile", fdt) ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	alpselectfdt, 1, 1, do_alp_selectfdt,
+	"set alp_fdtfile to this board's dtb, by on-module SoM family",
+	""
+);
+
 int board_late_init(void)
 {
 	if (alp_som_is_v2n_m1())
diff --git a/include/configs/rzv2n-dev.h b/include/configs/rzv2n-dev.h
index db64fae..f3f40f0 100644
--- a/include/configs/rzv2n-dev.h
+++ b/include/configs/rzv2n-dev.h
@@ -91,59 +91,60 @@
  * deliberately overridden (left untouched for patch safety).  The
  * sd-vs-emmc root choice mirrors bootcmd_check.
  *
- * SD + eMMC dtb: the vendor sd2load env (above, untouched for patch
- * safety) loads "boot/r9a09g056n44-dev.dtb" -- a name none of our
- * KERNEL_DEVICETREE builds ever produce (V2N101 and V2N102 both build
- * renesas/e1m-v2n101-x-evk.dtb today -- see
- * meta-alp-sdk/conf/machine/e1m-v2n10{1,2}-a55.conf.  V2N102's own
- * conf HARDCODES this same filename at line 36 (it does not inherit
- * it -- only one machine conf is parsed per build); that line carries
- * a TODO to create a V2N102-specific dtb once its DDR map is
- * confirmed, with its own note that this bootcmd must change in
- * lockstep if that TODO ever lands); that load silently fails
- * (";"-chained, non-fatal) and bootimage would then boot the
- * stale/garbage dtb already in RAM.
- * The vendor emmcload env has the identical defect.  Its body is not
- * visible in THIS patch's own diff context (do_patch context lines
- * stop above line 70), but is confirmed against the unpatched vendor
- * default in the RZ/V AI SDK BSP source package,
+ * dtb + Image are RE-loaded here, fatally, overwriting whatever the
+ * vendor sd2load/emmcload staged first: those env blocks are also
+ * patched by optional vendor feature layers, and their ext4load calls
+ * are ";"-chained (non-fatal) -- a missing/mismatched file there used
+ * to fall through silently to booti-ing stale or garbage RAM content
+ * instead of failing.  The vendor sd2load/emmcload both load
+ * "boot/r9a09g056n44-dev.dtb", a name none of our KERNEL_DEVICETREE
+ * builds ever produce (confirmed against the unpatched vendor default
+ * in the RZ/V AI SDK BSP source package,
  * meta-rz-features/meta-rz-codecs/recipes-bsp/u-boot/files/
- * 0001-Add-OpenCVA-and-Codec-for-V2N.patch (the "-" / pre-patch context
- * lines, rzv2n-dev.h hunk):
- *   "emmcload=ext4load mmc 0:2 0x48080000 boot/Image;ext4load mmc 0:2
- *   0x48000000 boot/r9a09g056n44-dev.dtb;run prodemmcbootargs \0"
- * -- i.e. Image at 0x48080000, dtb at 0x48000000, partition 2, exactly
- * mirroring sd2load with the eMMC device index (SDHI0=mmc0 vs SD's
- * SDHI1=mmc1).  The same vendor patch's "bootimage" line confirms
- * 0x48000000 is the dtb address independent of which *load ran:
- * "bootimage=booti 0x48080000 - 0x48000000 \0" -- booti's 3rd arg is
- * the fdt address, so this is proof by consumer, not just by the
- * *load producer.  meta-rz-codecs IS in our layer set
- * (meta-alp-sdk/conf/layer.conf), so its "+" side (which prepends
- * ${ocaaddr}/${codaddr} OpenCVA/Codec loads to emmcload/sd2load) is
- * what actually ships, not the pristine form quoted above -- the
- * 0x48080000/0x48000000/partition-2 values are unchanged by that
- * rewrite, only extra loads are prepended.  Re-load the correct dtb
- * on BOTH branches here instead, overwriting whatever sd2load/emmcload
- * staged before bootimage runs, same address + mmc spec each already
- * uses (0x48000000, "mmc 1:2" / "mmc 0:2").
- * alp_root for the SD branch is also corrected: mmc1 is the carrier
- * microSD (SDHI1, alias mmc1 in e1m-x-evk.dtsi) -> Linux /dev/mmcblk1,
- * not mmcblk2 (no third controller exists on this SoM).  mmc0 (SDHI0
- * eMMC) -> mmcblk0 was already correct.
- * FUTURE (V2M / per-SKU dtb): V2M SKUs build e1m-v2m101-x-evk.dtb
- * instead (same shared u-boot binary) -- true per-SKU selection needs
- * an EEPROM-manifest-derived fdtfile, set AFTER the leading
- * "env default -a" wipe, injected per-MACHINE via a Kconfig string +
- * .cfg fragment (same channel as prod-boot.cfg). */
-#define CONFIG_BOOTCOMMAND	"env default -a;run bootcmd_check;" \
+ * 0001-Add-OpenCVA-and-Codec-for-V2N.patch); its "bootimage=booti
+ * 0x48080000 - 0x48000000" confirms 0x48080000/0x48000000 as the
+ * Image/dtb addresses independent of which *load ran.  Re-load both,
+ * fatally, at those same addresses -- same mmc spec each already uses
+ * (mmc 1:2 for SD, mmc 0:2 for eMMC).  alp_root mirrors that same
+ * branch: mmc1 is the carrier microSD (SDHI1, alias mmc1 in
+ * e1m-x-evk.dtsi) -> Linux /dev/mmcblk1, not mmcblk2 (no third
+ * controller exists on this SoM); mmc0 (SDHI0 eMMC) -> mmcblk0.
+ *
+ * The dtb filename is per-SKU now, not hardcoded: all four V2N/V2M
+ * machines (e1m-v2n101/102-a55, e1m-v2m101/102-a55) share this one
+ * u-boot binary/config (UBOOT_CONFIG[rzv2n-evk] = rzv2n-dev_defconfig,
+ * see u-boot_%.bbappend), but only two board dtbs exist --
+ * e1m-v2n101-x-evk.dtb (V2N, no DEEPX) and e1m-v2m101-x-evk.dtb (V2M,
+ * + DEEPX DX-M1) -- with V2N102/V2M102 each aliasing their 101
+ * sibling's dtb (see KERNEL_DEVICETREE in each conf/machine/<MACHINE>.conf).
+ * alpselectfdt (rzv2n-dev.c) sets alp_fdtfile to the matching name by
+ * reading the same on-module EEPROM manifest the DEEPX bring-up
+ * already reads (alp_som_is_v2n_m1()); it runs AFTER "env default -a"
+ * because that wipe drops any variable set earlier in the boot flow
+ * (board_late_init() runs long before autoboot) -- see alpselectfdt's
+ * own comment.  An unreadable manifest makes alp_som_is_v2n_m1()
+ * return false, so alp_fdtfile falls back to the V2N (non-DEEPX) name
+ * -- the same dtb this bootcmd hardcoded before this fix, so a
+ * manifest fault degrades to the old behaviour, not a new failure.
+ *
+ * A failed Image or dtb load now stops the boot at the U-Boot prompt
+ * (an "ALP FATAL:" message, then bootcmd ends without ever calling
+ * bootimage) instead of continuing into booti with stale RAM content.
+ * This does not strand the board: the dev cmdline's interruptible
+ * autoboot (BOOTDELAY/AUTOBOOT_KEYED) already leaves the same serial
+ * console reachable, plus the U-Boot USB gadget download path
+ * (CONFIG_USB_GADGET_DOWNLOAD + CONFIG_CMD_USB_MASS_STORAGE, already
+ * in rzv2n-dev_defconfig) for recovery -- see prod-boot.cfg for the
+ * production-build stop-string story. */
+#define CONFIG_BOOTCOMMAND	"env default -a;alpselectfdt;run bootcmd_check;" \
 	"if mmc dev 1; then " \
-	"ext4load mmc 1:2 0x48000000 boot/e1m-v2n101-x-evk.dtb;" \
-	"setenv alp_root /dev/mmcblk1p2; else " \
-	"ext4load mmc 0:2 0x48000000 boot/e1m-v2n101-x-evk.dtb;" \
-	"setenv alp_root /dev/mmcblk0p2; fi;" \
-	"setenv bootargs " ALP_BOOTARGS_BASE " root=${alp_root};" \
-	"run bootimage"
+	"setenv alp_mmc \"mmc 1:2\"; setenv alp_root /dev/mmcblk1p2; else " \
+	"setenv alp_mmc \"mmc 0:2\"; setenv alp_root /dev/mmcblk0p2; fi;" \
+	"if ext4load ${alp_mmc} 0x48080000 boot/Image; then " \
+	"if ext4load ${alp_mmc} 0x48000000 boot/${alp_fdtfile}; then " \
+	"setenv bootargs " ALP_BOOTARGS_BASE " root=${alp_root};run bootimage;" \
+	"else echo ALP FATAL: failed to load boot/${alp_fdtfile} from ${alp_mmc}; fi;" \
+	"else echo ALP FATAL: failed to load boot/Image from ${alp_mmc}; fi"
 
 /* For board */
 /* Ethernet RAVB */
-- 
