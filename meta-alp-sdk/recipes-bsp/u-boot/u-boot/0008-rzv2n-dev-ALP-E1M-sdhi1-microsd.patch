From d1dc084416d70766b296b4d034b0d379e8dd69e5 Mon Sep 17 00:00:00 2001
From: Alp Lab AB <contact@alplab.ai>
Date: Thu, 24 Sep 2026 18:53:14 +0200
Subject: [PATCH] rzv2n-dev: ALP E1M: enable the carrier microSD on SDHI1 as
 mmc1

The vendor boot flow picks its boot medium with
"bootcmd_check=if mmc dev 1; then run sd2load; else run emmcload; fi",
and ALP's CONFIG_BOOTCOMMAND (patch 0002) makes the same "mmc dev 1"
test.  On the E1M-X EVK the microSD slot is on SDHI1
(mmc@15c10000), but rzv2n-dev.dts aliased mmc1 to SDHI2
(mmc@15c20000) and left SDHI1 disabled, so "mmc dev 1" never saw
the SD card and every boot fell through to the eMMC.

arch/arm/dts/rzv2n-dev.dts (SEL_SD0_SD1 = 0 branch):
- mmc1 = &sdhi1, mmc2 = &sdhi2 (SDHI0 eMMC stays mmc0, so the
  environment device CONFIG_SYS_MMC_ENV_DEV=0 is unchanged).
- &sdhi1: bus-width 4, status okay.  No sd-uhs-* properties: this
  U-Boot has no MMC_IO_VOLTAGE/UHS support.  No cd-gpios: sh_sdhi has
  no get_cd op, so the MMC core treats the slot as populated and an
  empty slot fails "mmc dev 1" by command timeout, which is the
  fallback bootcmd_check already expects.

board/renesas/rzv2n-dev (CONFIG_ALP_E1M_SD1_MICROSD, default y in
rzv2n-dev_defconfig), in board_init() before initr_mmc:
- PA2 (uSD1_V_SEL) low: 3.3 V SD1 IO rail.
- PA3 (SD1_SD1PWEN): low for 20 ms, then high.  The power cycle
  returns a card that Linux left in 1.8 V UHS signalling to 3.3 V
  before U-Boot initialises it after a warm reboot.
- SD1CLK/SD1CMD (bank 0x0b pins 0/1) and SD1DAT0-3 (bank 0x0c pins
  0-3): IOLH = 2, SR = 0, IEN on CMD/DAT.  This is the pad setup Linux
  applies (renesas,output-impedance = <2>, slew-rate = <0>,
  input-enable).  The rzv2n pinctrl driver only understands
  "pinmux", so these dedicated balls are set by register writes, at
  the offsets TF-A names PFC_IOLH0B/0C, PFC_SR0B/0C and
  PFC_IEN0B/0C.

include/configs/rzv2n-dev.h: the ALP CONFIG_BOOTCOMMAND (patch 0002)
takes the SD branch only when "ext4size mmc 1:2 boot/Image" also
succeeds.  Once mmc1 is the microSD, any inserted card passes
"mmc dev 1"; a card with no boot image (e.g. a data card) would
otherwise stop the boot at the prompt instead of booting the eMMC.

Not verified on silicon.

Signed-off-by: Alp Lab AB <contact@alplab.ai>
---
 arch/arm/dts/rzv2n-dev.dts          | 22 ++++++++++-
 board/renesas/rzv2n-dev/Kconfig     | 18 +++++++++
 board/renesas/rzv2n-dev/rzv2n-dev.c | 58 +++++++++++++++++++++++++++++
 configs/rzv2n-dev_defconfig         |  1 +
 include/configs/rzv2n-dev.h         |  7 +++-
 5 files changed, 104 insertions(+), 2 deletions(-)

diff --git a/arch/arm/dts/rzv2n-dev.dts b/arch/arm/dts/rzv2n-dev.dts
index 83b68a3f1..db2f837b5 100644
--- a/arch/arm/dts/rzv2n-dev.dts
+++ b/arch/arm/dts/rzv2n-dev.dts
@@ -48,7 +48,11 @@
 		serial0 = &scif0;
 #if (!SEL_SD0_SD1)
 		mmc0 = &sdhi0;
-		mmc1 = &sdhi2;
+		/* ALP E1M: mmc1 is the carrier microSD (SDHI1), so the
+		 * vendor bootcmd_check "mmc dev 1" probes the SD card.
+		 * SDHI2 moves to mmc2. */
+		mmc1 = &sdhi1;
+		mmc2 = &sdhi2;
 #else
 		mmc1 = &sdhi1;
 #endif
@@ -155,6 +159,22 @@
 	bus-width = <4>;
 	status = "okay";
 };
+
+/* ALP E1M-X EVK carrier microSD on SDHI1 (mmc1).  Coexists with the
+ * SDHI0 eMMC: SW2 selects eMMC, so SD0_PWR_EN is unused and PA1 is
+ * free to be the SD1 card-detect net.  3.3 V default-speed/HS only:
+ * this U-Boot has no MMC_IO_VOLTAGE/UHS support, so no sd-uhs-*
+ * properties.  SD1CLK/CMD/DAT0-3 are dedicated balls (no pinmux
+ * needed); their drive strength, slew rate and input enables, plus
+ * card power (PA3) and the IO-rail select (PA2), are set by
+ * board_init() under CONFIG_ALP_E1M_SD1_MICROSD -- the rzv2n pinctrl
+ * driver only understands "pinmux".  No cd-gpios: sh_sdhi has no
+ * get_cd op, so the MMC core treats the slot as always populated
+ * and an empty slot fails "mmc dev 1" by command timeout. */
+&sdhi1 {
+	bus-width = <4>;
+	status = "okay";
+};
 #else
 &sdhi1 {
 
diff --git a/board/renesas/rzv2n-dev/Kconfig b/board/renesas/rzv2n-dev/Kconfig
index f1807399c..9751e049c 100644
--- a/board/renesas/rzv2n-dev/Kconfig
+++ b/board/renesas/rzv2n-dev/Kconfig
@@ -99,3 +99,21 @@ config ALP_E1M_DEEPX_RAIL
 
 	  Set via meta-alp-sdk's deepx-rail.cfg for the V2M MACHINEs only;
 	  leave off (default) for the V2N base build.
+
+config ALP_E1M_SD1_MICROSD
+	bool "ALP E1M: power and configure the carrier microSD (SDHI1)"
+	depends on TARGET_RZV2N_DEV
+	help
+	  Bring up the E1M-X EVK carrier microSD slot on SDHI1 in
+	  board_init(), before initr_mmc: drive PA3 (SD1_SD1PWEN) high
+	  for card power, drive PA2 (uSD1_V_SEL) low for the 3.3 V SD1
+	  IO rail, and set the SD1CLK/SD1CMD/SD1DAT0-3 dedicated pads to
+	  drive strength (IOLH) 2, slew rate 0 and input-enabled on
+	  CMD/DAT -- the same pad setup Linux applies (sdhi1_pins in
+	  e1m-x-evk.dtsi).  Paired with the rzv2n-dev.dts change that
+	  makes SDHI1 mmc1, so the vendor bootcmd_check
+	  ("if mmc dev 1; then run sd2load; else run emmcload; fi")
+	  boots from the microSD when a card is present.
+
+	  Do NOT enable on a carrier where PA2/PA3 are not the SD1
+	  IO-voltage select and card power enable.
diff --git a/board/renesas/rzv2n-dev/rzv2n-dev.c b/board/renesas/rzv2n-dev/rzv2n-dev.c
index fd4e8e1f7..56a2f6802 100644
--- a/board/renesas/rzv2n-dev/rzv2n-dev.c
+++ b/board/renesas/rzv2n-dev/rzv2n-dev.c
@@ -902,6 +902,60 @@ int board_early_init_f(void)
 	return 0;
 }
 
+#ifdef CONFIG_ALP_E1M_SD1_MICROSD
+/*
+ * SD1 dedicated-pad registers, 64 bits per bank with an 8-bit field per
+ * pin (pins 0-3 in the low 32-bit word).  Bank index = the kernel's
+ * pinctrl-rzg2l r9a09g056 dedicated-pin table: SD1CLK = 0xb/0,
+ * SD1CMD = 0xb/1, SD1DAT0-3 = 0xc/0-3.  Offsets follow the same
+ * reg + bank * 8 layout as PFC_P0_PUPD_H above (PUPD = 0x1C00) and
+ * match TF-A's PFC_IOLH0B/0C, PFC_SR0B/0C, PFC_IEN0B/0C.  None of them
+ * are behind PWPR.
+ */
+#define ALP_PFC_IOLH(b)		((void *)(uintptr_t)(PFC_BASE + 0x1000 + (b) * 8))
+#define ALP_PFC_SR(b)		((void *)(uintptr_t)(PFC_BASE + 0x1400 + (b) * 8))
+#define ALP_PFC_IEN(b)		((void *)(uintptr_t)(PFC_BASE + 0x1800 + (b) * 8))
+#define ALP_SD1_BANK_CLKCMD	0x0b	/* pin0 SD1CLK, pin1 SD1CMD */
+#define ALP_SD1_BANK_DAT	0x0c	/* pins 0-3 SD1DAT0-3 */
+#define ALP_SD1_IOLH		2	/* Linux: renesas,output-impedance = <2> */
+/* ponytail: rail discharge time unmeasured; raise if a warm reboot from a
+ * UHS Linux session still fails "mmc dev 1". */
+#define ALP_SD1_POWER_OFF_MS	20
+
+static void alp_sd1_microsd_init(void)
+{
+	/* PA2 (uSD1_V_SEL) low = 3.3 V SD1 IO rail -- the on-module
+	 * pull-down default, driven explicitly because this U-Boot's host
+	 * has no UHS/1.8 V support. */
+	alp_gpio_output(10, 2, 0);
+	/* PA3 (SD1_SD1PWEN): power-cycle the card, then leave it on.  A
+	 * card Linux switched to 1.8 V signalling (CMD11, UHS) keeps it
+	 * until it loses power, and would then fail 3.3 V init here after
+	 * a warm reboot -- silently falling back to the eMMC boot. */
+	alp_gpio_output(10, 3, 0);
+	mdelay(ALP_SD1_POWER_OFF_MS);
+	alp_gpio_output(10, 3, 1);
+
+	/* Drive strength 2 on CLK/CMD and DAT0-3: at 3 (strongest) the
+	 * carrier SDIO mux path fails SDR104 data with CRC errors in
+	 * Linux; U-Boot runs <= 50 MHz but uses the same pad setting. */
+	clrsetbits_le32(ALP_PFC_IOLH(ALP_SD1_BANK_CLKCMD), 0x00000303,
+			ALP_SD1_IOLH << 0 | ALP_SD1_IOLH << 8);
+	clrsetbits_le32(ALP_PFC_IOLH(ALP_SD1_BANK_DAT), 0x03030303,
+			ALP_SD1_IOLH << 0 | ALP_SD1_IOLH << 8 |
+			ALP_SD1_IOLH << 16 | ALP_SD1_IOLH << 24);
+
+	/* Slew rate 0, as Linux (slew-rate = <0>) and TF-A's SD0 setup. */
+	clrbits_le32(ALP_PFC_SR(ALP_SD1_BANK_CLKCMD), 0x00000101);
+	clrbits_le32(ALP_PFC_SR(ALP_SD1_BANK_DAT), 0x01010101);
+
+	/* Input enable on CMD and DAT0-3 (not CLK), as Linux
+	 * (input-enable) and TF-A's SD0 IEN pattern. */
+	setbits_le32(ALP_PFC_IEN(ALP_SD1_BANK_CLKCMD), 0x00000100);
+	setbits_le32(ALP_PFC_IEN(ALP_SD1_BANK_DAT), 0x01010101);
+}
+#endif
+
 int board_init(void)
 {
 	/* address of boot parameters */
@@ -918,6 +972,10 @@ int board_init(void)
 	alp_gpio_output(10, 0, 1);
 #endif
 
+#ifdef CONFIG_ALP_E1M_SD1_MICROSD
+	alp_sd1_microsd_init();
+#endif
+
 	board_usb_init();
 
 	return 0;
diff --git a/configs/rzv2n-dev_defconfig b/configs/rzv2n-dev_defconfig
index e04099d12..67423d43c 100644
--- a/configs/rzv2n-dev_defconfig
+++ b/configs/rzv2n-dev_defconfig
@@ -98,3 +98,4 @@ CONFIG_USB_FUNCTION_MASS_STORAGE=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 
 CONFIG_ALP_E1M_EMMC_1V8=y
+CONFIG_ALP_E1M_SD1_MICROSD=y
diff --git a/include/configs/rzv2n-dev.h b/include/configs/rzv2n-dev.h
index 85c0e7afa..447f80e9a 100644
--- a/include/configs/rzv2n-dev.h
+++ b/include/configs/rzv2n-dev.h
@@ -149,8 +149,13 @@
  * feature layers (meta-rz-drpai, meta-rz-opencva) and cannot be relied
  * on to fail loudly.  Same address and same mmc spec each already uses,
  * so the re-load is idempotent when the vendor path worked. */
+/* ALP: the SD branch is taken only when the card carries boot/Image on
+ * partition 2.  With mmc1 = SDHI1 (the carrier microSD) any inserted
+ * card makes "mmc dev 1" succeed; a card without a boot image (a
+ * customer data card) must fall back to the eMMC, not stop at the
+ * prompt. */
 #define CONFIG_BOOTCOMMAND	"env default -a;run bootcmd_check;" \
-	"if mmc dev 1; then " \
+	"if mmc dev 1 && ext4size mmc 1:2 boot/Image; then " \
 	"setenv alp_mmc 1:2;setenv alp_root /dev/mmcblk1p2; else " \
 	"setenv alp_mmc 0:2;setenv alp_root /dev/mmcblk0p2; fi;" \
 	"if ext4load mmc ${alp_mmc} 0x48080000 boot/Image" \
-- 
2.34.1

