From 3a9c1a1e2b6d4f708c9a1e5d2f6a7b8c9d0e1f2a Mon Sep 17 00:00:00 2001
From: Alp Lab AB <contact@alplab.ai>
Date: Sat, 26 Sep 2026 09:15:00 +0200
Subject: [PATCH] rzv2n-dev: ALP E1M derive ethaddr/eth1addr from the SoM
 serial

The E1M-V2N/E1M-V2M SoM has two RAVB Ethernet interfaces (Linux
end0/end1) and no per-unit MAC source at all: the RZ/V2N has no MAC
OTP and this SoM carries no MAC EEPROM. Left alone, every unit boots
with whatever CFG_EXTRA_ENV_SETTINGS the enabled feature layers bake
in -- on a DRP-AI build that is meta-rz-features/meta-rz-drpai's
recipes-bsp/u-boot/files/0001-add-ether-setting.patch (NOT a
meta-alp-sdk patch; it lands on include/configs/rzv2n-dev.h AFTER
this whole series, per this board's own u-boot_%.bbappend comment on
patch ordering), which hardcodes
"ethaddr=02:11:22:33:44:55\0" / "eth1addr=02:11:22:33:44:66\0" --
already locally-administered (U/L set), not a purchased IEEE OUI, and
identical on every board either way. Buying an IEEE OUI block is off
the table (maintainer decision), so the only per-unit fact available
at boot is the allocator-guaranteed-unique factory serial
(alp_serial, captured alongside alp_sku above) already sitting in the
validated manifest this board reads on every boot.

Derive both MACs from that serial -- an injective encoding, not a
hash -- into IEEE 802c SLAP locally-administered space: octet0 =
0xA2 (individual, locally administered), then a 40-bit payload (4-bit
Alp Lab prefix 0xC | 6-bit year-2024 | 6-bit week | 20-bit Crockford
base32 index | 2-bit iface | 2 reserved bits). The Python side
(scripts/alp_eth_mac.py) implements the identical bit layout and
carries the same golden vector for serial "2026W38-0001":
end0 A2:C0:A6:00:00:10, end1 A2:C0:A6:00:00:14 -- the two must never
drift apart; see that script's own test suite.

"Already configured" is checked against BOTH a real env value and the
DRP-AI layer's known compiled-in default string -- deliberately, so
this derives correctly whether or not that vendor layer is enabled,
without this repo forking a patch file in a layer it does not own. A
genuine user/production override (anything else, including a value
this same code derived on an earlier boot) is left untouched.

Runs unconditionally in board_late_init(), right after the manifest
read that already captures alp_sku -- a missing/invalid manifest or
an unparseable serial only logs and leaves ethaddr/eth1addr exactly
as every other feature layer left them.
---
 board/renesas/rzv2n-dev/rzv2n-dev.c | 163 +++++++++++++++++++++++++++++++++++
 1 file changed, 163 insertions(+)

diff --git a/board/renesas/rzv2n-dev/rzv2n-dev.c b/board/renesas/rzv2n-dev/rzv2n-dev.c
index 1152ade7..7c3d9f81 100644
--- a/board/renesas/rzv2n-dev/rzv2n-dev.c
+++ b/board/renesas/rzv2n-dev/rzv2n-dev.c
@@ -27,6 +27,8 @@
 #include <linux/delay.h>
 #include <u-boot/crc.h>
 #include <asm/unaligned.h>
+#include <env.h>
+#include <net.h>
 #include <fdt_support.h>
 
 DECLARE_GLOBAL_DATA_PTR;
@@ -346,6 +348,14 @@
  */
 static char alp_sku[25];
 
+/*
+ * Factory serial from the same validated manifest, format
+ * "YYYYWww-IIII" (e.g. "2026W38-0001") -- the sole per-unit uniqueness
+ * source this SoM has, consumed below by alp_eth_mac_bringup() to
+ * derive ethaddr/eth1addr.  Empty under the same conditions alp_sku is.
+ */
+static char alp_serial[25];
+
 static bool alp_som_is_v2n_m1(void)
 {
 	struct udevice *dev;
@@ -379,6 +389,8 @@ static bool alp_som_is_v2n_m1(void)
 
 	memcpy(family, &buf[0x08], 16);
 	family[16] = '\0';
+	memcpy(alp_serial, &buf[0x38], 24);
+	alp_serial[24] = '\0';
 	memcpy(alp_sku, &buf[0x18], 24);
 	alp_sku[24] = '\0';
 	printf("ALP: SoM family \"%s\" sku \"%.24s\"\n", family, &buf[0x18]);
@@ -916,6 +928,154 @@ int ft_system_setup(void *blob, struct bd_info *bd)
 	return 0;
 }
 
+/*
+ * Fleet-unique (NOT globally unique -- that needs a purchased IEEE OUI
+ * block) locally-administered Ethernet MAC derivation from the SoM
+ * serial. Bit-for-bit identical to scripts/alp_eth_mac.py -- keep both
+ * in lockstep. Octet 0 0xA2 = unicast, locally administered, IEEE
+ * 802c SLAP AAI quadrant (Z:Y = 00).
+ */
+#define ALP_ETH_MAC_OCTET0		0xA2u
+#define ALP_ETH_MAC_PREFIX		0xCu
+#define ALP_ETH_YEAR_BASE		2024u
+#define ALP_ETH_YEAR_BITS		6
+#define ALP_ETH_WEEK_BITS		6
+#define ALP_ETH_INDEX_BITS		20
+#define ALP_ETH_IFACE_BITS		2
+#define ALP_ETH_RESERVED_BITS		2
+
+/* Compiled-in defaults meta-rz-features/meta-rz-drpai's add-ether patch
+ * bakes into CFG_EXTRA_ENV_SETTINGS -- see this patch's commit message.
+ * Treated as "unset", same as a real NULL, so this derives correctly
+ * whether or not that vendor layer is in the build. */
+#define ALP_ETH_VENDOR_DEFAULT_ETHADDR	"02:11:22:33:44:55"
+#define ALP_ETH_VENDOR_DEFAULT_ETH1ADDR	"02:11:22:33:44:66"
+
+static bool alp_eth_crockford_decode(const char *chars, u32 *out)
+{
+	static const char alphabet[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+	u32 value = 0;
+	int i;
+
+	/* Strict: case-insensitive, but I/L/O/U are never in the alphabet
+	 * and are never aliased to a look-alike digit -- a mis-typed
+	 * serial must fail loudly, not silently decode to another unit's
+	 * MAC.  Mirrors scripts/alp_eth_mac.py's crockford_decode(). */
+	for (i = 0; i < 4; i++) {
+		char c = chars[i];
+		const char *p;
+
+		if (c >= 'a' && c <= 'z')
+			c = (char)(c - ('a' - 'A'));
+		if (c == '\0')
+			return false;
+		p = strchr(alphabet, c);
+		if (!p)
+			return false;
+		value = value * 32 + (u32)(p - alphabet);
+	}
+	*out = value;
+	return true;
+}
+
+/* Parse "YYYYWww-IIII" (case-insensitive) -- mirrors
+ * scripts/alp_eth_mac.py's parse_serial() field-for-field; keep both in
+ * lockstep.  Never guesses: any malformed field or out-of-range
+ * year/week fails the whole parse. */
+static bool alp_eth_parse_serial(const char *serial, u32 *year_out, u32 *week_out, u32 *index_out)
+{
+	u32 year = 0, week = 0, index;
+	int i;
+
+	if (strlen(serial) != 12)
+		return false;
+	for (i = 0; i < 4; i++) {
+		if (serial[i] < '0' || serial[i] > '9')
+			return false;
+		year = year * 10 + (u32)(serial[i] - '0');
+	}
+	if (serial[4] != 'W' && serial[4] != 'w')
+		return false;
+	for (i = 5; i < 7; i++) {
+		if (serial[i] < '0' || serial[i] > '9')
+			return false;
+		week = week * 10 + (u32)(serial[i] - '0');
+	}
+	if (serial[7] != '-')
+		return false;
+	if (!alp_eth_crockford_decode(&serial[8], &index))
+		return false;
+
+	if (year < ALP_ETH_YEAR_BASE || year > ALP_ETH_YEAR_BASE + (1u << ALP_ETH_YEAR_BITS) - 1)
+		return false;
+	if (week < 1 || week > 53)
+		return false;
+
+	*year_out = year;
+	*week_out = week;
+	*index_out = index;
+	return true;
+}
+
+/* iface: 0 = end0/ethaddr, 1 = end1/eth1addr (2/3 reserved). */
+static void alp_eth_derive_mac(u32 year, u32 week, u32 index, unsigned int iface, u8 mac[6])
+{
+	u64 value = ALP_ETH_MAC_PREFIX;
+
+	value = (value << ALP_ETH_YEAR_BITS) | (year - ALP_ETH_YEAR_BASE);
+	value = (value << ALP_ETH_WEEK_BITS) | week;
+	value = (value << ALP_ETH_INDEX_BITS) | index;
+	value = (value << ALP_ETH_IFACE_BITS) | (iface & 0x3u);
+	value = (value << ALP_ETH_RESERVED_BITS) | 0u;
+
+	mac[0] = ALP_ETH_MAC_OCTET0;
+	mac[1] = (u8)(value >> 32);
+	mac[2] = (u8)(value >> 24);
+	mac[3] = (u8)(value >> 16);
+	mac[4] = (u8)(value >> 8);
+	mac[5] = (u8)(value >> 0);
+}
+
+static void alp_eth_mac_bringup(void)
+{
+	u32 year, week, index;
+	u8 mac0[6], mac1[6];
+	const char *cur0, *cur1;
+	bool set0, set1;
+
+	if (!alp_serial[0]) {
+		printf("ALP: no validated SoM serial -- ethaddr/eth1addr left as-is\n");
+		return;
+	}
+
+	if (!alp_eth_parse_serial(alp_serial, &year, &week, &index)) {
+		printf("ALP: SoM serial \"%s\" does not parse as YYYYWww-IIII -- "
+		       "ethaddr/eth1addr left as-is\n", alp_serial);
+		return;
+	}
+
+	alp_eth_derive_mac(year, week, index, 0, mac0);
+	alp_eth_derive_mac(year, week, index, 1, mac1);
+
+	cur0 = env_get("ethaddr");
+	cur1 = env_get("eth1addr");
+	set0 = !cur0 || !strcmp(cur0, ALP_ETH_VENDOR_DEFAULT_ETHADDR);
+	set1 = !cur1 || !strcmp(cur1, ALP_ETH_VENDOR_DEFAULT_ETH1ADDR);
+
+	if (set0)
+		eth_env_set_enetaddr_by_index("eth", 0, mac0);
+	if (set1)
+		eth_env_set_enetaddr_by_index("eth", 1, mac1);
+
+	if (!set0 && !set1) {
+		printf("ALP: ethaddr/eth1addr already configured -- leaving as-is\n");
+		return;
+	}
+
+	printf("ALP: MAC end0 %s end1 %s (serial %s)\n",
+	       env_get("ethaddr"), env_get("eth1addr"), alp_serial);
+}
+
 int board_late_init(void)
 {
 	bool v2n_m1;
@@ -924,6 +1084,7 @@ int board_late_init(void)
 	alp_clk5l_fixup();
 
 	v2n_m1 = alp_som_is_v2n_m1();
+	alp_eth_mac_bringup();
 
 	if (IS_ENABLED(CONFIG_ALP_E1M_DEEPX_RAIL) || v2n_m1)
 		rail_ok = alp_deepx_rail_bringup();
--
2.34.1
 