From 2e5bad424d43d9d768a5b215f23b8574b6a68f64 Mon Sep 17 00:00:00 2001
From: Alp Lab AB <contact@alplab.ai>
Date: Sun, 8 Nov 2026 06:37:36 +0000
Subject: [PATCH] rzv2n-dev: ALP E1M: Mender A/B slot and signed FIT boot

CONFIG_BOOTCOMMAND hard-coded eMMC partition 2 and boot/Image.  Split it
into a rootfs-selection block and a kernel-load block that two opt-in
Kconfig symbols swap, leaving the default command byte for byte as before.

CONFIG_ALP_E1M_MENDER: choose eMMC slot 2 or 3 by comparing the saved
mender_boot_part against a literal; the mmc spec and root= are literals,
nothing from the Linux-writable environment is pasted into them or the
kernel cmdline.  The OpenCV/Codec blobs are re-loaded from that slot and a
failed boot ends in mender_try_to_recover so bootcount / altbootcmd roll
the slot back.  The allowlisted Mender variables get decimal / hex types
so a malformed saved value is dropped on import.

CONFIG_ALP_E1M_FIT: load boot/fitImage and bootm the config node of the
board dtb, eMMC only (no microSD, no vendor bootcmd_check).  bootm
enforces the required signature key in the control dtb; there is no
fallback to an unsigned boot/Image.  The symbol selects FIT_SIGNATURE,
RSA and ENV_WRITEABLE_LIST and the header #errors if they, or
LEGACY_IMAGE_FORMAT, CMD_BOOTI / CMD_BOOTZ / CMD_GO / CMD_ELF / EFI / CMD_NET / CMD_LOADB /
CMD_LOADS / CMD_SOURCE or a BOOTDELAY other
than -2 are not as required.  board_late_init() halts unless the control
dtb carries a key-* node with required = "conf".  A failed boot
resets (no shell); the unverified OpenCV/Codec blobs are not preloaded.

rzv2n-dev_defconfig carries the persistent-environment location
(0x10000 at 0x220000 / 0x230000, boot partition 2) that
uboot-env-emmc.cfg already merges, so meta-mender's pre-merge defconfig
check agrees with the final configuration.
---
 board/renesas/rzv2n-dev/Kconfig     |  33 ++++++
 board/renesas/rzv2n-dev/rzv2n-dev.c |  36 +++++++
 configs/rzv2n-dev_defconfig         |   7 +-
 include/configs/rzv2n-dev.h         | 149 ++++++++++++++++++++++++++--
 4 files changed, 215 insertions(+), 10 deletions(-)

diff --git a/board/renesas/rzv2n-dev/Kconfig b/board/renesas/rzv2n-dev/Kconfig
index 3ccfad27..b80fc949 100644
--- a/board/renesas/rzv2n-dev/Kconfig
+++ b/board/renesas/rzv2n-dev/Kconfig
@@ -44,6 +44,39 @@ config ALP_E1M_EMMC_1V8
 	  voltage-switch handshake.  Do NOT enable on boards whose SD0
 	  channel carries a 3.3 V SD card.
 
+config ALP_E1M_MENDER
+	bool "ALP E1M: boot the Mender A/B rootfs slot"
+	depends on TARGET_RZV2N_DEV
+	help
+	  CONFIG_BOOTCOMMAND selects the rootfs partition from the Mender
+	  saved mender_boot_part / mender_boot_part_hex instead of the fixed
+	  eMMC partition 2 and recovers through Mender's bootcount /
+	  altbootcmd rollback.  Needs meta-mender's env_mender.h in the
+	  default environment, CONFIG_BOOTCOUNT_LIMIT and
+	  CONFIG_BOOTCOUNT_ENV (the ALP mender-boot.cfg fragment, selected
+	  by meta-alp-sdk's mender.inc).  Leave off otherwise.
+
+config ALP_E1M_FIT
+	bool "ALP E1M: boot a signed FIT image (boot/fitImage)"
+	depends on TARGET_RZV2N_DEV && DM
+	select FIT_SIGNATURE
+	select RSA
+	select ENV_WRITEABLE_LIST
+	help
+	  CONFIG_BOOTCOMMAND loads boot/fitImage and runs bootm on the
+	  config node of the board dtb instead of booting boot/Image.  The
+	  public key that must verify the configuration is added to this
+	  U-Boot's control dtb by the build (meta-alp-sdk's ALP_FIT_SIGNED=1
+	  adds fit-signed.cfg, which also turns LEGACY_IMAGE_FORMAT off).
+	  Selects the verification code (FIT_SIGNATURE, RSA) and the
+	  environment allowlist.  The option does NOT embed a key: board
+	  late init halts at run time unless the control dtb carries a
+	  key-* node with required = "conf" (nothing else counts), and
+	  rzv2n-dev.h refuses to build with booti, bootz, go, bootelf, EFI,
+	  the network / serial-download / source commands,
+	  LEGACY_IMAGE_FORMAT or a BOOTDELAY other than -2.  Leave off
+	  otherwise.
+
 config ALP_PROD_BOOT
 	bool "ALP E1M: production kernel cmdline (quiet, no earlycon)"
 	depends on TARGET_RZV2N_DEV
diff --git a/board/renesas/rzv2n-dev/rzv2n-dev.c b/board/renesas/rzv2n-dev/rzv2n-dev.c
index cbb76162..c761c24d 100644
--- a/board/renesas/rzv2n-dev/rzv2n-dev.c
+++ b/board/renesas/rzv2n-dev/rzv2n-dev.c
@@ -1698,11 +1698,47 @@ static void alp_env_check(void)
 		printf("ALP: environment initialised\n");
 }
 
+#ifdef CONFIG_ALP_E1M_FIT
+/*
+ * Signed-boot builds only: bootm verifies a FIT against the keys in this
+ * U-Boot's own control dtb, and only a key marked required = "conf" makes a
+ * FIT whose configuration fails -- or carries no -- signature unbootable
+ * (an "image"-only key would allow mixing signed images from different
+ * FITs, so it does not count; image keys may exist alongside).
+ * The build is supposed to embed one (uboot-sign.bbclass); if it did not,
+ * bootm would accept an unsigned FIT, so refuse to continue (late init runs
+ * before bootcmd, and there is no shell: CONFIG_BOOTDELAY=-2).
+ */
+static void alp_fit_require_key(void)
+{
+	const void *fdt = gd->fdt_blob;
+	int sig = fdt_path_offset(fdt, "/signature");
+	int node;
+
+	if (sig >= 0) {
+		fdt_for_each_subnode(node, fdt, sig) {
+			const char *name = fdt_get_name(fdt, node, NULL);
+			const char *req = fdt_getprop(fdt, node, "required", NULL);
+
+			if (name && !strncmp(name, "key-", 4) && req &&
+			    !strcmp(req, "conf"))
+				return;
+		}
+	}
+
+	printf("ALP: signed-boot build but the control dtb has no key with required = \"conf\" -- halting\n");
+	hang();
+}
+#else
+static inline void alp_fit_require_key(void) {}
+#endif
+
 int board_late_init(void)
 {
 	bool v2n_m1;
 	bool rail_ok = true;
 
+	alp_fit_require_key();
 	alp_env_check();
 	alp_reset_cause_init();
 	alp_gd32_nrst_release();
diff --git a/configs/rzv2n-dev_defconfig b/configs/rzv2n-dev_defconfig
index 2f690723..f50ad256 100644
--- a/configs/rzv2n-dev_defconfig
+++ b/configs/rzv2n-dev_defconfig
@@ -7,8 +7,11 @@ CONFIG_OF_UPSTREAM=n
 CONFIG_MTD=y
 CONFIG_TEXT_BASE=0x50000000
 CONFIG_SYS_LOAD_ADDR=0x58000000
-CONFIG_ENV_SIZE=0x20000
-CONFIG_ENV_OFFSET=0xFFFE0000
+CONFIG_ENV_SIZE=0x10000
+CONFIG_ENV_OFFSET=0x220000
+CONFIG_ENV_OFFSET_REDUND=0x230000
+CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
+CONFIG_SYS_MMC_ENV_PART=2
 CONFIG_DM_GPIO=y
 CONFIG_RCAR_GEN3=y
 CONFIG_R9A09G056=y
diff --git a/include/configs/rzv2n-dev.h b/include/configs/rzv2n-dev.h
index 444bf181..9baf4615 100644
--- a/include/configs/rzv2n-dev.h
+++ b/include/configs/rzv2n-dev.h
@@ -194,26 +194,147 @@
  * failing "Card did not respond to voltage select! : -110". */
 #ifdef CONFIG_ENV_WRITEABLE_LIST
 /* ALP: the only variables read back from the saved environment ("sw" =
- * string, writeable): Mender's U-Boot integration (upgrade_available,
+ * string, "d" decimal, "x" hex, "w" writeable -- a value of the wrong
+ * type is dropped on import): Mender's U-Boot integration (upgrade_available,
  * bootcount, mender_boot_part, mender_boot_part_hex, mender_saveenv_canary)
  * and the alp_envinit first-boot marker.  Everything else -- bootcmd,
  * bootargs, bootdelay, bootstopkey*, preboot, the vendor boot scripts --
  * is rebuilt from the built-in default on every boot. */
 #define CFG_ENV_FLAGS_LIST_STATIC \
-	"alp_envinit:sw,upgrade_available:sw,bootcount:sw," \
-	"mender_boot_part:sw,mender_boot_part_hex:sw,mender_saveenv_canary:sw"
+	"alp_envinit:sw,upgrade_available:dw,bootcount:dw," \
+	"mender_boot_part:dw,mender_boot_part_hex:xw,mender_saveenv_canary:dw"
 #endif
 
 /* ALP: no "env default -a" here any more -- the environment persists in
  * eMMC boot partition 2, but CONFIG_ENV_WRITEABLE_LIST (above) makes the
  * compiled-in default the baseline on every boot, so this command and the
- * vendor scripts it runs can never be replaced by a saved copy. */
-#define CONFIG_BOOTCOMMAND	"alp_eth_mac;" \
-	"alp_fdtfile " CONFIG_ALP_E1M_FDTFILE ";" \
+ * vendor scripts it runs can never be replaced by a saved copy.
+ *
+ * The command is assembled from three blocks that the opt-in images swap:
+ *
+ * ALP_BOOT_SELECT picks the rootfs partition (sets alp_mmc / alp_root).
+ *   Default: the microSD card when it carries boot/<kernel>, else eMMC
+ *   partition 2.  CONFIG_ALP_E1M_FIT (signed boot): eMMC partition 2 only,
+ *   never removable media.  CONFIG_ALP_E1M_MENDER (meta-alp-sdk's
+ *   mender.inc): eMMC slot 2 or 3 by Mender's saved mender_boot_part, always
+ *   from eMMC; "run mender_setup" (Mender's env_mender.h, in the default
+ *   environment) only makes sure the environment was saved once.  The
+ *   vendor emmcload is skipped there because it always reads partition 2,
+ *   and the OpenCV/Codec blobs are re-loaded from the chosen slot.
+ *   Rollback is Mender's own: U-Boot counts boots in "bootcount"
+ *   (CONFIG_BOOTCOUNT_ENV) and, once it passes "bootlimit" with
+ *   upgrade_available=1, runs altbootcmd (mender_altbootcmd flips
+ *   mender_boot_part and clears upgrade_available), then bootcmd again.  A
+ *   slot whose kernel does not load ends in "run mender_try_to_recover" ->
+ *   reset while upgrade_available=1, so during an update a bad slot burns a
+ *   boot count (and is rolled back) instead of stopping at the prompt; with
+ *   no update pending the failure just stops at the prompt, as before.
+ *
+ * ALP_BOOT_KERNEL loads and starts the kernel.  Default: boot/Image +
+ * the board dtb, booti.  CONFIG_ALP_E1M_FIT (ALP_FIT_SIGNED=1): load the
+ * signed boot/fitImage and "bootm <addr>#<config node of this board's
+ * dtb>".  Signature verification (CONFIG_FIT_SIGNATURE, the required
+ * "conf" key in this U-Boot's control dtb) is done by bootm itself; a
+ * configuration that fails it returns here without booting, so the
+ * failure branch resets (no shell: BOOTDELAY -2) and there is NO fallback
+ * to an unsigned boot/Image.  A FIT build packages no Image anyway.  The
+ * config-node name is kernel-fitimage's FIT_CONF_PREFIX ("conf-") +
+ * the basename of KERNEL_DEVICETREE ("renesas/x.dtb" -> "conf-x.dtb"),
+ * for fdtfile and, only on a unit with no usable family, fdtfile_alt. */
+/* ALP: a FIT boot that does not verify its signature is worse than none --
+ * refuse to build it.  The environment allowlist keeps bootcmd and the
+ * vendor scripts out of a saved (Linux-writable) environment; legacy
+ * uImage / raw formats, the raw-image boot commands, "go", bootelf, EFI and
+ * the network / serial-download / source commands must not exist to be
+ * reached around the bootm below; and with BOOTDELAY -2 a keypress
+ * cannot stop autoboot, so there is no shell to type one at.  That a
+ * required key is really in the control dtb is checked at run time
+ * (alp_fit_require_key() in board_late_init(): a key with
+ * required = "conf" -- the configuration signature is what binds kernel and
+ * dtb together, an "image" key does not). */
+#if defined(CONFIG_ALP_E1M_FIT)
+#if !defined(CONFIG_FIT_SIGNATURE) || !defined(CONFIG_RSA) || \
+	!defined(CONFIG_ENV_WRITEABLE_LIST) || defined(CONFIG_LEGACY_IMAGE_FORMAT)
+#error "CONFIG_ALP_E1M_FIT needs FIT_SIGNATURE, RSA and ENV_WRITEABLE_LIST, and no LEGACY_IMAGE_FORMAT"
+#endif
+#if defined(CONFIG_CMD_BOOTI) || defined(CONFIG_CMD_BOOTZ) || defined(CONFIG_CMD_GO) || \
+	defined(CONFIG_CMD_ELF) || defined(CONFIG_CMD_BOOTEFI) || defined(CONFIG_EFI_LOADER) || \
+	defined(CONFIG_BOOTMETH_EFILOADER)
+#error "CONFIG_ALP_E1M_FIT: booti, bootz, go, bootelf and EFI would run unsigned code around the signature check"
+#endif
+#if defined(CONFIG_CMD_NET) || defined(CONFIG_CMD_LOADB) || defined(CONFIG_CMD_LOADS) || \
+	defined(CONFIG_CMD_SOURCE)
+#error "CONFIG_ALP_E1M_FIT: network, serial download and source commands would bring in unsigned code"
+#endif
+#if !defined(CONFIG_BOOTDELAY) || CONFIG_BOOTDELAY != -2
+#error "CONFIG_ALP_E1M_FIT needs CONFIG_BOOTDELAY=-2 (autoboot that a keypress cannot stop)"
+#endif
+#endif
+
+#ifdef CONFIG_ALP_E1M_FIT
+#define ALP_KERNEL_NAME		"fitImage"
+#define ALP_FIT_ADDR		"0x50000000"
+#define ALP_FIT_CONF_PREFIX	"conf-"
+#else
+#define ALP_KERNEL_NAME		"Image"
+#endif
+
+/* Vendor blobs (OpenCV accelerator, codec) staged before the kernel, from the
+ * rootfs chosen above.  Non-fatal, like the vendor emmcload they replace.
+ * NOT in a signed build: they are firmware loaded without a signature check,
+ * so a signed unit runs without the OpenCV accelerator and codec firmware
+ * (ALP_FIT_SIGNED=1 trades them for the verified-boot guarantee). */
+#ifdef CONFIG_ALP_E1M_FIT
+#define ALP_BOOT_BLOBS
+#else
+#define ALP_BOOT_BLOBS \
+	"ext4load mmc ${alp_mmc} ${ocaaddr} boot/${ocabin};" \
+	"ext4load mmc ${alp_mmc} ${codaddr} boot/${codbin};"
+#endif
+
+#if defined(CONFIG_ALP_E1M_MENDER)
+/* The saved environment is writable from Linux (fw_setenv), so NOTHING read
+ * from it reaches the mmc spec or the kernel cmdline: the slot is chosen by
+ * comparing mender_boot_part against a literal and the spec / root device are
+ * literals too.  Anything but "3" (including a corrupted value) boots slot A.
+ * 2 / 3 are MENDER_ROOTFS_PART_A / _B in mender.inc
+ * (tests/scripts/test_uboot_env_layout.py). */
+#define ALP_BOOT_SELECT \
+	"run mender_setup;" \
+	"if test \"${mender_boot_part}\" = 3; then " \
+	"setenv alp_mmc 0:3;setenv alp_root /dev/mmcblk0p3; else " \
+	"setenv alp_mmc 0:2;setenv alp_root /dev/mmcblk0p2; fi;" \
+	ALP_BOOT_BLOBS
+#define ALP_BOOT_RECOVER	";run mender_try_to_recover"
+#elif defined(CONFIG_ALP_E1M_FIT)
+/* Signed boot: eMMC only.  Removable media never supplies the rootfs, the
+ * kernel or the vendor blobs of a verified-boot build, and the vendor
+ * bootcmd_check / sd2load (which probe mmc1) are not run. */
+#define ALP_BOOT_SELECT \
+	"setenv alp_mmc 0:2;setenv alp_root /dev/mmcblk0p2;" \
+	ALP_BOOT_BLOBS
+#define ALP_BOOT_RECOVER
+#else
+#define ALP_BOOT_SELECT \
 	"if alp_sd_present; then run bootcmd_check; else run emmcload; fi;" \
-	"if alp_sd_present && mmc dev 1 && ext4size mmc 1:2 boot/Image; then " \
+	"if alp_sd_present && mmc dev 1 && ext4size mmc 1:2 boot/" ALP_KERNEL_NAME "; then " \
 	"setenv alp_mmc 1:2;setenv alp_root /dev/mmcblk1p2; else " \
-	"setenv alp_mmc 0:2;setenv alp_root /dev/mmcblk0p2; fi;" \
+	"setenv alp_mmc 0:2;setenv alp_root /dev/mmcblk0p2; fi;"
+#define ALP_BOOT_RECOVER
+#endif
+
+#ifdef CONFIG_ALP_E1M_FIT
+#define ALP_BOOT_KERNEL \
+	"if ext4load mmc ${alp_mmc} " ALP_FIT_ADDR " boot/fitImage; then " \
+	"setenv bootargs " ALP_BOOTARGS_BASE " root=${alp_root};" \
+	"bootm " ALP_FIT_ADDR "#" ALP_FIT_CONF_PREFIX "${fdtfile};" \
+	"if test -n \"${fdtfile_alt}\"; then " \
+	"bootm " ALP_FIT_ADDR "#" ALP_FIT_CONF_PREFIX "${fdtfile_alt}; fi; fi;" \
+	"echo ALP: signed fitImage (config " ALP_FIT_CONF_PREFIX "${fdtfile}) " \
+	"failed to load or verify from boot/ on mmc ${alp_mmc} -- NOT booting"
+#define ALP_BOOT_END		";reset"
+#else
+#define ALP_BOOT_KERNEL \
 	"setenv alp_dtb_ok 0;" \
 	"if ext4load mmc ${alp_mmc} 0x48080000 boot/Image; then " \
 	"if ext4load mmc ${alp_mmc} 0x48000000 boot/${fdtfile}; then " \
@@ -228,6 +349,18 @@
 	"run bootimage; fi;" \
 	"echo ALP: kernel Image or dtb (${fdtfile} ${fdtfile_alt}) failed to load" \
 	" from boot/ on mmc ${alp_mmc} -- NOT booting a stale RAM image"
+#endif
+
+#ifndef ALP_BOOT_END
+#define ALP_BOOT_END
+#endif
+
+#define CONFIG_BOOTCOMMAND	"alp_eth_mac;" \
+	"alp_fdtfile " CONFIG_ALP_E1M_FDTFILE ";" \
+	ALP_BOOT_SELECT \
+	ALP_BOOT_KERNEL \
+	ALP_BOOT_RECOVER \
+	ALP_BOOT_END
 
 /* For board */
 /* Ethernet RAVB */
-- 
2.53.0

