 #endif
 
+#if S80K_HYPERRAM_EN
+    /*
+     * UNTESTED ON SILICON (alp-sdk#1970). Runs AFTER the NOR init above on
+     * purpose: OSPI0 is shared, and arming the HyperRAM XIP window is the last
+     * DR-mode-incompatible step. Deliberately not fatal -- a board that still
+     * reaches Linux without its external RAM beats one that stops in BL32.
+     */
+    if (s80k_hyperram_init() != 0) {
+        WARN("S80K HyperRAM unavailable; continuing without external RAM\n");
+    }
+#endif
+
 #if ALIF_SOC_E8
     /* set the NPU-HG in Non-secure, usermode state (E8-only registers) */
