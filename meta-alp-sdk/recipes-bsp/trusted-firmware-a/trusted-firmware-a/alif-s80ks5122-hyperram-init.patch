new file mode 100644
index 0000000..f0bd5c9
--- /dev/null
+++ b/include/plat/alif/common/drivers/s80k_hyperram.h
@@ -0,0 +1,25 @@
+/*
+ * Copyright (c) 2026, Alp Lab AB. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef S80K_HYPERRAM_H
+#define S80K_HYPERRAM_H
+
+/**
+ * @brief Bring up the Infineon/Cypress S80KS5122 HyperRAM on OSPI0 and arm
+ *        its XIP window.
+ *
+ * UNTESTED ON SILICON.  Built only when S80K_HYPERRAM_EN=1.  See the header
+ * comment of s80k_hyperram.c for the sequence, its Alif DFP sources and the
+ * CK/CK# board-revision gate.
+ *
+ * @return 0 on success, negative errno on failure.  -ENODEV means the driver
+ *         deliberately did not touch the device (CK/CK# pair crossed on this
+ *         board revision).  Callers should continue without external RAM
+ *         rather than panic.
+ */
+int s80k_hyperram_init(void);
+
+#endif /* S80K_HYPERRAM_H */
diff --git a/plat/alif/board/devkit_e7/platform.mk b/plat/alif/board/devkit_e7/platform.mk
index 247fed9..0a2726d 100644
--- a/plat/alif/board/devkit_e7/platform.mk
+++ b/plat/alif/board/devkit_e7/platform.mk
@@ -18,6 +18,27 @@ $(eval $(call add_define,MX_FLASH_EN))
 $(eval $(call add_define,AES_EN))
 $(eval $(call add_define,AP_HYPERRAM_EN))
 
+# Infineon/Cypress S80KS5122 HyperRAM on OSPI0 (E1M-AEN803). alp-sdk#1970.
+# UNTESTED ON SILICON -- see plat/alif/common/drivers/ospi/s80k_hyperram.c.
+# Off by default, so E1M-AEN801 (no external memory) and every other build is
+# byte-identical.
+#
+# S80K_HYPERRAM_CLK_PAIR_CROSSED=1 (default) names the E1M-AEN803 2626-r2
+# board bug: CK/CK# are crossed at the HyperRAM, the part answered a bench
+# bit-bang (ID0=0x0F86, ID1=0x0001) only with the pair inverted, and no
+# firmware lever fixes it. While 1 the driver does not touch the device. Set
+# 0 for a board with the pair corrected (R3, or an r2 with the R17/R18 rework).
+S80K_HYPERRAM_EN		?=	0
+S80K_HYPERRAM_CLK_PAIR_CROSSED	?=	1
+S80K_HYPERRAM_SS		?=	0
+S80K_HYPERRAM_DUAL_DIE		?=	1
+$(eval $(call add_define,S80K_HYPERRAM_EN))
+ifeq "1" "${S80K_HYPERRAM_EN}"
+$(eval $(call add_define,S80K_HYPERRAM_CLK_PAIR_CROSSED))
+$(eval $(call add_define,S80K_HYPERRAM_SS))
+$(eval $(call add_define,S80K_HYPERRAM_DUAL_DIE))
+endif
+
 # Ensemble E8 SoC selector. Used to select code blocks that are applicable
 # only on the E8 SoC. Enabled by default. set ALIF_SOC_E8=0 to build for E7.
 ALIF_SOC_E8		?=	1
