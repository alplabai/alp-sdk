 .../devkit_e7/sp_min/devkit_e7_sp_min_setup.c |  15 +
 plat/alif/common/drivers/ospi/s80k_hyperram.c | 414 ++++++++++++++++++
 plat/alif/common/sp_min/alif_sp_min.mk        |   4 +
 5 files changed, 479 insertions(+)
