 *
 * aen-rtc-control2-probe -- app overlay for the E1M-AEN801 (Alif Ensemble
 * E8, M55-HE), bench RAM-run via J-Link.
 *
 * THIS OVERLAY DELIBERATELY CARRIES ONLY THE BENCH ITCM RETARGET.
 *
 * BRD_I2C -- the on-module housekeeping bus this app's RV-3028-C7 sits on
 * (SoC I2C0, portable alias alp-i2c2, pads P7_0/P7_1) -- is a SoM fact, not
 * an app fact: the board layer already enables it (i2c0 status "okay" +
 * pinctrl_i2c0 + the alp-i2c2 alias, metadata/e1m_modules/aen/
 * on-module-links.yaml `brd_i2c` entry, #1848), so every AEN801 app gets it
 * for free. Re-declaring it here would duplicate a SoM fact one layer too
 * high -- see examples/aen/aen-temp-sensor's overlay for the same argument
 * made in full, and examples/aen/aen-brd-i2c-scan's overlay for the history
 * of the bus move down into the board layer.
 */

/*
 * MANDATORY bench RAM-run retarget: run from ITCM so J-Link can loadbin+run
 * without programming MRAM, and drop the MCUboot code-partition fixup.
 */
/ {
	chosen {
		/* PATH-REFERENCE form (&itcm), NOT the <&itcm> phandle-array form:
		 * the phandle-array form yields CONFIG_FLASH_SIZE=0 and the image
		 * overflows the (empty) FLASH region at link time. */
		zephyr,flash = &itcm;
		/delete-property/ zephyr,code-partition;
	};
};
