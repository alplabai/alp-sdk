 *
 * The devicetree half of phase 11's two-switch playback re-enable -- see
 * the SAFETY note in
 * boards/alp_e1m_aen801_m55_he_ae822fa0e5597ls0_rtss_he.overlay for why
 * i2s3 ships "disabled" by default on EVK rev 2626-R2 (U46 has no Hi-Z
 * state, and I2S0_SDO/SCLK/WS on P9_3/4/5 run through it backwards).
 *
 * Apply this ONLY once U46's VCC is on +3V3 (PROVEN on e1m-aen-evk-03,
 * 2026-09-15: re-powering a same-family 3257-type part from +VIO to
 * +3V3 made playback clearly audible; a 3257-type part swap alone, VCC
 * still on +VIO, stays silent -- see include/alp/boards/alp_e1m_evk.h's
 * I2S mux block, including the untested /E-or-S-HIGH caveat at +3V3)
 * -- together with setting AEN_EVKDEMO_SOUND_PLAYBACK to 1 in
 * src/main.c -- both switches, not either alone:
 *
 *   west build -b alp_e1m_aen801_m55_he/ae822fa0e5597ls0/rtss_he \
 *       examples/aen/aen-evk-demo -- \
 *       -DEXTRA_DTC_OVERLAY_FILE=i2s3-enable-post-u46-rework.overlay
 */

&i2s3 {
	status = "okay";
};
