 * Copyright (c) 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * aen-ospi-regcheck overlay for the E1M-AEN801 (Ensemble E8, M55-HE) RAM-run.
 *
 * Enables the Alif OSPI/HexSPI node so it BINDS on silicon:
 *   - ospi0 (snps,designware-ospi @ 0x83000000, IRQ 96, aes-reg 0x83001000,
 *     xip-base 0xA0000000/0x10000000)
 *
 * SCOPE: this proves the ospi0 node BINDS (DT_HAS_SNPS_DESIGNWARE_OSPI_ENABLED
 * + the reg/irq match) and that the flash_ospi_alif.c driver's
 * alif_hal_ospi_initialize() call compiles and links.  XiP setup itself is
 * skipped outright (OSPI_XIP_SER does not exist on AE822, independent of
 * what's on the bus -- see flash_ospi_alif.c and src/main.c).  This app
 * performs no device-level transfer, so nothing here confirms or denies a
 * part on either chip select; see src/main.c's header for the CORRECTED
 * PREMISE note (#2041) on what IS now known about SS1.
 *
 * CORRECTED (#2041): this overlay's pinctrl-0 previously muxed the Alif
 * DevKit's own OSPI0 route (zephyr_alif fork's ensemble-e4-e6-e8-pinctrl.dtsi
 * pinctrl_ospi0 "_B" group -- SCLK/RXDS/SS0 on port 3, D0-D7 on port 2), a
 * pad set that does not exist on the E1M-AEN module at all.  Because
 * flash_ospi_alif.c had no pinctrl support (see that file), pinctrl-0 was
 * also never applied, so this drove nothing regardless.  Both are fixed now:
 * the driver applies pinctrl-0 in its init, and the group below is
 * transcribed from metadata/e1m_modules/aen/alif-ospi.tsv, the E1M-AEN
 * module's actual OSPI0 routing (13 pads on ports 0/2/6/12, all function 1)
 * -- the same routing a silicon JEDEC-ID read used to confirm a populated
 * NOR at SS1 on E1M-AEN803 (see src/main.c).  Pad config
 * (input-enable/drive-strength=12/slew-rate=fast) is unchanged from the
 * prior group -- generic Alif pad electrical settings, not route-specific.
 */
#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>

/*
 * MANDATORY bench RAM-run retarget: run from ITCM so J-Link can loadbin+run
 * without programming MRAM, and drop the MCUboot code-partition fixup.
 */
/ {
	chosen {
		zephyr,flash = &itcm;
		/delete-property/ zephyr,code-partition;
	};
};

&pinctrl {
	pinctrl_ospi0: pinctrl_ospi0 {
		group0 {
			/* metadata/e1m_modules/aen/alif-ospi.tsv -- E1M-AEN module OSPI0
			 * routing, 13 pads, all function 1. */
			pinmux = <PIN_P12_0__OSPI0_SCLK_C>,
				 <PIN_P12_1__OSPI0_SCLKN_C>,
				 <PIN_P12_2__OSPI0_RXDS_C>,
				 <PIN_P12_3__OSPI0_SS0_C>,
				 <PIN_P12_4__OSPI0_SS1_C>,
				 <PIN_P2_0__OSPI0_D0_B>,
				 <PIN_P2_1__OSPI0_D1_B>,
				 <PIN_P6_2__OSPI0_D2_C>,
				 <PIN_P6_3__OSPI0_D3_C>,
				 <PIN_P6_4__OSPI0_D4_C>,
				 <PIN_P6_5__OSPI0_D5_C>,
				 <PIN_P6_6__OSPI0_D6_C>,
				 <PIN_P0_7__OSPI0_D7_A>;
			input-enable;
			drive-strength = <12>;
			slew-rate = "fast";
		};
	};
};

&ospi0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_ospi0>;
	pinctrl-names = "default";
};
