/*
 * Copyright (c) 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * aen-ospi-regcheck overlay for the E1M-AEN801 (Ensemble E8, M55-HE) RAM-run.
 *
 * Enables the Alif OSPI/HexSPI node so it BINDS on silicon:
 *   - ospi0 (snps,designware-ospi @ 0x83000000, IRQ 96, aes-reg 0x83001000,
 *     xip-base 0xA0000000/0x10000000)
 *
 * SCOPE: this proves the ospi0 node BINDS (DT_HAS_SNPS_DESIGNWARE_OSPI_ENABLED
 * + the reg/irq match), that the flash_ospi_alif.c driver's pinctrl_apply_state()
 * + alif_hal_ospi_initialize() calls compile, link, and succeed, and (#2041)
 * that the OSPI0 CS1 NOR (IS25WX256-JHLE, U10 footprint) actually ANSWERS a
 * JEDEC ID read -- see flash_ospi_alif.c's ospi_alif_read_jedec_id() (#915).
 * XiP setup itself is still skipped outright regardless of population:
 * OSPI_XIP_SER does not exist on AE822 -- see flash_ospi_alif.c.
 *
 * Pinctrl group TRANSCRIBED from the E1M-AEN module route
 * (metadata/e1m_modules/aen/alif-ospi.tsv, the "OSPI0_*" rows) -- this is
 * the E1M-AEN carrier's OWN OSPI0 pad set, NOT the Alif DevKit's.  A prior
 * revision of this overlay copied the Apache-2.0 zephyr_alif fork's E4/E6/E8
 * DevKit pinctrl set (SCLK/RXDS/SS0 on port 3 "_B", D0-D7 on port 2 "_B")
 * verbatim; that set does not match how OSPI0 is actually routed on the
 * E1M-AEN carrier (P6/P12/P0, not P2/P3/P1) -- see #2041.  All 13 pads below
 * use pinctrl function 1 (ALIF_PINMUX(port, pin, 1)), matching the TSV's
 * single alif_pad column (no alternate-function ambiguity to resolve).
 * OSPI0_INTn/OSPI1_INTn/OSPI0_RESETn/OSPI1_RESETn (P15_3/P15_2/P15_6/P15_7
 * in the same TSV) are NOT part of the ospi0 controller's pinctrl group --
 * they are separate GPIO-class signals, out of scope here.
 */
#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>

/*
 * MANDATORY bench RAM-run retarget: run from ITCM so J-Link can loadbin+run
 * without programming MRAM, and drop the MCUboot code-partition fixup.
 */
/ {
	chosen {
		zephyr,flash = &itcm;
		/delete-property/ zephyr,code-partition;
	};
};

&pinctrl {
	/*
	 * E1M-AEN carrier OSPI0 route, transcribed VERBATIM from
	 * metadata/e1m_modules/aen/alif-ospi.tsv (function 1 throughout):
	 *   OSPI0_D0     P2_0   OSPI0_D1     P2_1
	 *   OSPI0_D2     P6_2   OSPI0_D3     P6_3
	 *   OSPI0_D4     P6_4   OSPI0_D5     P6_5
	 *   OSPI0_D6     P6_6   OSPI0_D7     P0_7
	 *   OSPI0_SCLK   P12_0  OSPI0_SCLKN  P12_1
	 *   OSPI0_RXDS   P12_2
	 *   OSPI0_SS0    P12_3  OSPI0_SS1    P12_4
	 */
	pinctrl_ospi0: pinctrl_ospi0 {
		group0 {
			pinmux = <PIN_P2_0__OSPI0_D0_B>,
				 <PIN_P2_1__OSPI0_D1_B>,
				 <PIN_P6_2__OSPI0_D2_C>,
				 <PIN_P6_3__OSPI0_D3_C>,
				 <PIN_P6_4__OSPI0_D4_C>,
				 <PIN_P6_5__OSPI0_D5_C>,
				 <PIN_P6_6__OSPI0_D6_C>,
				 <PIN_P0_7__OSPI0_D7_A>,
				 <PIN_P12_0__OSPI0_SCLK_C>,
				 <PIN_P12_1__OSPI0_SCLKN_C>,
				 <PIN_P12_2__OSPI0_RXDS_C>,
				 <PIN_P12_3__OSPI0_SS0_C>,
				 <PIN_P12_4__OSPI0_SS1_C>;
			input-enable;
			drive-strength = <12>;
			slew-rate = "fast";
		};
	};
};

&ospi0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_ospi0>;
	pinctrl-names = "default";

	/*
	 * (#2041/#915) Target OSPI0 CS1 -- the IS25WX256-JHLE NOR footprint
	 * (U10) per metadata/e1m_modules/E1M-AEN803.yaml
	 * on_module.ospi_memories.ospi0.chip_select: 1 -- at the bench-proven
	 * baud: bus-speed=20MHz against the node's clock-frequency=400MHz
	 * gives OSPI_BAUDR = 400000000/20000000 = 20, matching the reporter's
	 * measured register state (ser=0x00000002 i.e. cs-pin=1, BAUDR=20)
	 * for the JEDEC ID read that answered "9d 5b 19 10" on real silicon.
	 * Overrides the SoC dtsi's generic defaults (cs-pin=0, bus-speed=100MHz).
	 */
	cs-pin = <1>;
	bus-speed = <20000000>;
};
