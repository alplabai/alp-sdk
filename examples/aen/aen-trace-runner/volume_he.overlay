/*
 * volume_he.overlay -- TR_HP_SOUND builds, the HE's volume controls (CMakeLists.txt,
 * src/platform/volume_he.c): the EVK's rotary encoder and its push switch, mapped for the
 * portable API.
 *
 *   ENC0_Y (phase A) -> P3_1 = GPIO3 pin 1     ENC0_X (phase B) -> P3_0 = GPIO3 pin 0
 *   encoder push switch = E1M_GPIO_IO4 -> P4_3 = GPIO4 pin 3, active low, 10k pull-up + RC debounce
 * (metadata/e1m_modules/aen/from-alif.tsv, metadata/boards/e1m-evk.yaml). GPIO3 / GPIO4: not the
 * GPIO5 port or the lpgpio island the HP's amps and CC3501E lines use. If a clockwise turn LOWERS
 * the volume on the bench, swap the two `gpios` entries of tr_enc.
 *
 * The pads need their input buffer on (pinctrl `input-enable`, the REN trap): src/platform/
 * volume_he.c applies pinctrl_tr_enc through tr_pads' pinctrl-0 (binding alp,pad-config), since
 * neither gpio_dw nor gpio-qdec applies a pinctrl state itself.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>

&pinctrl {
	pinctrl_tr_enc: pinctrl_tr_enc {
		group0 {
			pinmux = <PIN_P3_0__GPIO>, <PIN_P3_1__GPIO>, <PIN_P4_3__GPIO>;
			input-enable;
		};
	};
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

/ {
	aliases {
		alp-qenc0 = &tr_enc;
	};

	/* No driver: src/platform/volume_he.c applies the state (pinctrl_apply_state). */
	tr_pads: tr-pads {
		compatible = "alp,pad-config";
		pinctrl-0 = <&pinctrl_tr_enc>;
		pinctrl-names = "default";
	};

	/* Software quadrature decode (the SoC's UTIMER QEC block is an edge counter, not a decoder,
	 * #2037): one count per detent. idle-poll-time-us is required, gpio_dw has no both-edge
	 * interrupt (see examples/aen/aen-qenc-readout/boards/*.overlay). */
	tr_enc: tr-enc {
		compatible = "gpio-qdec";
		gpios = <&gpio3 1 GPIO_ACTIVE_HIGH>, <&gpio3 0 GPIO_ACTIVE_HIGH>;
		steps-per-period = <4>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <500>;
		idle-poll-time-us = <2000>;
		idle-timeout-ms = <200>;
	};

	/* alp_gpio_open(pin_id) indexes this array: only index 4 (ALP_E1M_GPIO_IO4) is routed here,
	 * the others are placeholders so the index stays the E1M pad number. Nothing in this image
	 * opens them. */
	alp_pins: alp-pins {
		compatible = "alp,pin-array";
		gpios = <&gpio4 0 GPIO_ACTIVE_HIGH>,
			<&gpio4 1 GPIO_ACTIVE_HIGH>,
			<&gpio4 2 GPIO_ACTIVE_HIGH>,
			<&gpio4 4 GPIO_ACTIVE_HIGH>,
			<&gpio4 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* [4] E1M_GPIO_IO4: encoder switch */
	};
};
