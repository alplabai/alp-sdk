/*
 * volume_he.overlay -- TR_HP_SOUND builds, the HE's volume controls (CMakeLists.txt,
 * src/platform/volume_he.c): the EVK's rotary encoder and its push switch, mapped for the
 * portable API.
 *
 *   ENC0_X (phase A) -> P3_0 = GPIO3 pin 0     ENC0_Y (phase B) -> P3_1 = GPIO3 pin 1
 *   encoder push switch = E1M_GPIO_IO4 -> P4_3 = GPIO4 pin 3, active low, external 10k pull-up
 *   + 0.1 uF debounce (metadata/boards/e1m-evk.yaml, metadata/e1m_modules/aen/from-alif.tsv).
 * GPIO3 / GPIO4: not the GPIO5 port or the lpgpio island the HP's amps and CC3501E lines use.
 * The phase order is the e1m-evk.yaml / aen-qenc-readout one; which way is "clockwise" is
 * UNVERIFIED on the bench -- if a clockwise turn LOWERS the volume, swap the two `gpios` entries
 * of tr_enc.
 *
 * REN. A pad's input buffer is on only once pinctrl sets `input-enable`, and neither gpio_dw nor
 * gpio-qdec applies a pinctrl state (alp-sdk#2808 is the SDK gap). Until that is fixed in the
 * portable layer, the state sits on /zephyr,user and src/platform/volume_he.c applies it with
 * pinctrl_apply_state(): the sanctioned ad hoc pattern, as in
 * examples/aen/aen-camera-firstlight/trigger_gpio.overlay.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>

&pinctrl {
	pinctrl_tr_enc: pinctrl_tr_enc {
		group0 {
			pinmux = <PIN_P3_0__GPIO>, <PIN_P3_1__GPIO>, <PIN_P4_3__GPIO>;
			input-enable;
		};
	};
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

/ {
	aliases {
		alp-qenc0 = &tr_enc;
	};

	zephyr,user {
		pinctrl-0 = <&pinctrl_tr_enc>;
		pinctrl-names = "default";
	};

	/* Software quadrature decode (the SoC's UTIMER QEC block is an edge counter, not a decoder,
	 * #2037): one count per detent. idle-poll-time-us is required, gpio_dw has no both-edge
	 * interrupt (see examples/aen/aen-qenc-readout/boards/*.overlay). */
	tr_enc: tr-enc {
		compatible = "gpio-qdec";
		gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>, <&gpio3 1 GPIO_ACTIVE_HIGH>;
		steps-per-period = <4>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <500>;
		idle-poll-time-us = <2000>;
		idle-timeout-ms = <200>;
	};

	/* alp_gpio_open(pin_id) indexes this array by E1M pad number, so index 4 (IO4, the switch) needs
	 * entries 0..3 before it. Those are the real pads of metadata/e1m_modules/aen/from-alif.tsv
	 * (IO0 P9.1, IO2 P12.5, IO3 P3.2), never a stand-in; IO1 has no SoC pad, so it points at the
	 * disabled GPIO14 controller and an open of it fails (NOT_READY) rather than driving anything.
	 * Nothing in this image opens IO0..IO3. */
	alp_pins: alp-pins {
		compatible = "alp,pin-array";
		gpios = <&gpio9 1 GPIO_ACTIVE_HIGH>,  /* [0] IO0: P9.1 */
			<&gpio14 0 GPIO_ACTIVE_HIGH>, /* [1] IO1: no SoC pad, GPIO14 is disabled */
			<&gpio12 5 GPIO_ACTIVE_HIGH>, /* [2] IO2: P12.5 (the HP's CSI mux select) */
			<&gpio3 2 GPIO_ACTIVE_HIGH>,  /* [3] IO3: P3.2 */
			<&gpio4 3 GPIO_ACTIVE_LOW>;   /* [4] IO4: P4.3, the encoder switch (external pull-up) */
	};
};
