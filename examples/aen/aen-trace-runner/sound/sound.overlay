 * Copyright (c) 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * Trace Runner sound (sound/): shared by the M55-HE and M55-HP targets --
 * the two AEN803 board files differ only in TCM bases (see
 * docs/2026-09-23-sound.md). Transcribed from the bench-proven
 * aen-i2s-tas2563-probe overlay (2026W36-0002 audible playback 2026-09-15) and
 * alp-sdk examples/aen/aen-evk-demo (AEN803): i2s3 on P9_3/4/5, gpio5 for
 * the amps' SD_N (P5_2) / IRQZ (P5_0), and the CC3501E bridge (SPI1 + the
 * LP-GPIO WIFI_EN/nRESET) that drives the I2S0 mux.
 *
 * i2s3 is ENABLED here. On a carrier whose U46 is the stock 74LVC157 that
 * alone contends with U46's outputs on P9_3/4/5 (alp-sdk
 * examples/aen/aen-i2s-amp-alif README, SAFETY). CMakeLists.txt refuses to
 * build without -DTR_SND_REWORKED_U46=ON for that reason.
 */
#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>
#include <zephyr/dt-bindings/clock/alif-ensemble-clocks-ext.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,flash = &itcm; /* RAM-run / SE-load into this core's ITCM */
		/delete-property/ zephyr,code-partition;
	};
	aliases {
		alp-i2s0 = &i2s3;
		alp-spi1 = &cc3501e_spi; /* bus_id 1 in alp_spi_open() */
	};
	/* SoM-internal CC3501E control nets, in cc3501e_bridge.h's
	 * CC3501E_BRIDGE_PIN_* order. Exactly ONE alp,pin-array in the tree. */
	alp_pins: alp-pins {
		compatible = "alp,pin-array";
		gpios = <&lpgpio 5 GPIO_ACTIVE_HIGH>, /* [0] WIFI_EN     (P15_5)      */
			<&lpgpio 1 GPIO_ACTIVE_HIGH>; /* [1] E_WIFI.NRST (P15_1_FLEX) */
	};
};

&pinctrl {
	pinctrl_i2s3: pinctrl_i2s3 {
		group0 {
			pinmux = <PIN_P9_3__I2S3_SDO_A>, <PIN_P9_4__I2S3_SCLK_A>,
				 <PIN_P9_5__I2S3_WS_A>;
		};
	};
	/* SPI1 on P14_6 SCK / P14_5 MOSI / P14_4 MISO + hardware SS0 on P14_7
	 * (the dwc-ssi's own select frames each bridge phase -- no cs-gpios). */
	pinctrl_spi1: pinctrl_spi1 {
		group0 {
			pinmux = <PIN_P14_6__SPI1_SCLK_C>, <PIN_P14_5__SPI1_MOSI_C>,
				 <PIN_P14_7__SPI1_SS0_C>;
		};
		group1 {
			pinmux = <PIN_P14_4__SPI1_MISO_C>;
			input-enable;
		};
	};
};

&{/soc} {
	i2s3: i2s3@49017000 {
		compatible = "snps,designware-i2s";
		reg = <0x49017000 0x1000>;
		interrupts = <144 3>;
		pinctrl-0 = <&pinctrl_i2s3>;
		pinctrl-names = "default";
		clocks = <&clockctrl ALIF_I2S3_76M8_CLK>;
		status = "okay";
	};
	cc3501e_spi: spi@48104000 {
		compatible = "alif,dwc-ssi-spi";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x48104000 0x1000>;
		interrupts = <138 3>;
		clocks = <&clockctrl ALIF_SPI_CLK>;
		clock-frequency = <200000000>;
		dwc-ssi;
		fifo-depth = <16>;
		rx-delay = <2>;
		pinctrl-0 = <&pinctrl_spi1>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&clockctrl {
	status = "okay";
};

&gpio5 {
	status = "okay";
};

&lpgpio {
	status = "okay";
};
