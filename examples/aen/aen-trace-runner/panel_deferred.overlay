/*
 * panel_deferred.overlay -- the HX8394 panel is NOT initialised by the kernel
 * at boot: main() brings it up through src/platform/panel.c, which retries
 * the intermittent init failure that left the backlight off (2026W36-0009) and
 * checks the backlight pin. CMakeLists.txt applies it after the
 * e1m_evk_rk055hdmipi4ma0 shield, which defines lcd_panel.
 */
&lcd_panel {
	zephyr,deferred-init;
};
