/*
 * Copyright (c) 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * aen-power-stop overlay for the E1M-AEN401 (Ensemble E4, M55-HP), MRAM image.
 * BUILT, NOT BENCH-VERIFIED on an Alp Lab bench (a customer ran 14/14 RV-3028
 * countdown wakes with se_service, lptimer0, lpgpio and rtc0 enabled, before the
 * AEN401 board had its alp,som-power node).
 *
 * The HP image must be MRAM-booted (VTOR >= 0x80000000), see the AEN803 HP overlay.
 * ensemble_e4_e6_power.dtsi declares the always-on nodes disabled; this app needs the
 * SE service channel, the LPTIMER wake, the LPRTC and the LPGPIO bank (RV-3028 INT on P15_0).
 * As on the AEN803: the SoM power layer drives the pads of every present domain, and a pad
 * whose GPIO controller is disabled makes the quiesce fail with ALP_ERR_NOT_READY; the
 * stock board tree enables GPIO5 (backlight enable) and GPIO11 (PHY reset).
 */
&se_service {
	status = "okay";
};

&seservice0r {
	status = "okay";
};

&seservice0s {
	status = "okay";
};

&lptimer0 {
	status = "okay";
};

&rtc0 {
	status = "okay";
};

&lpgpio {
	status = "okay";
};
