 * SPDX-License-Identifier: Apache-2.0
 *
 * aen-inference-latency overlay for the E1M-AEN803 (Ensemble E8, M55-HE)
 * bench RAM-run.  Only the NPU half of aen-inference-energy's overlay: the
 * ITCM retarget + itcm/dtcm global_base + the Ethos-U85 node, transcribed from
 * examples/aen/aen-npu-inference-alif (silicon-proven).  There is deliberately
 * no I2C2 / pinctrl half -- this app has no rail monitor.
 */
/*
 * RAM-run: the SoC `select` puts code in XIP; retarget ROM to ITCM so the
 * image links + runs from RAM (J-Link loadbin+go, no reset).  PATH-REFERENCE
 * form (&itcm) -- the phandle-array form <&itcm> makes FLASH_SIZE=0 and the
 * image overflows the (empty) FLASH region at link time.
 */
/ {
	chosen {
		zephyr,flash = &itcm;
		/delete-property/ zephyr,code-partition;
	};
};

/*
 * global_base for hal_alif's local_to_global() (soc_memory_map.h), which the
 * strong ethosu_address_remap in src/main.cpp calls.  The board's upstream
 * itcm/dtcm nodes are compatible "arm,itcm"/"arm,dtcm", whose binding has no
 * global_base, so re-`compatible` them onto the alp-sdk alif,itcm/alif,dtcm
 * bindings (which declare it) and set the E8 RTSS-HE global views, transcribed
 * from the Apache-2.0 zephyr_alif fork
 * (dts/arm/alif/ensemble/common/ensemble_rtss_he.dtsi):
 *     ITCM global_base = 0x58000000, DTCM global_base = 0x58800000.
 * reg / zephyr,memory-region are unchanged, so the linker regions and the
 * RAM-run retarget above are unaffected.
 */
&itcm {
	compatible = "alif,itcm";
	global_base = <0x58000000>;
};

&dtcm {
	compatible = "alif,dtcm";
	global_base = <0x58800000>;
};

&soc {
	/*
	 * Arm Ethos-U85 NPU.  compatible "arm,ethos-u", driven by the Arm
	 * Ethos-U core driver's Zephyr frontend (drivers/misc/ethos_u).
	 * Base 0x49042000, IRQ 366 + secure/privilege flags transcribed
	 * verbatim from the fork node (e4_e6_e8.dtsi ethosu1).  No `clocks`
	 * property: the fork's ethosu85 node carries none, and regcheck already
	 * confirmed the block is clocked (device_is_ready=1, ID=0x20007001).
	 */
	ethosu_npu: ethosu85@49042000 {
		compatible = "arm,ethos-u";
		reg = <0x49042000 0x1000>;
		interrupts = <366 3>;
		interrupt-parent = <&nvic>;
		secure-enable;
		privilege-enable;
		status = "okay";
	};
};
