/*
 * Copyright (c) 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * aen-npu-inference-alp-u55 overlay for the E1M-AEN801 (Ensemble E8, M55-HE).
 * This is the U55 sibling of aen-npu-inference-alp (which runs the U85).  On
 * the E8 the U85 (Alif block name NPU_HG, ethosu85@49042000) is the flagship
 * NPU, but the SoC ALSO carries two Ethos-U55s paired with the M55-HE / M55-HP
 * cores (ethosu55@400e1000, IRQ 55).  This overlay exercises the M55-HE-paired
 * U55.
 *
 * The core Ethos-U driver compiles for exactly ONE accelerator config
 * (CONFIG_ETHOS_U55_256 here; see prj.conf), and binds every status="okay"
 * arm,ethos-u node -- so we ENABLE the U55 node and DISABLE the U85 node, or a
 * U55-configured driver would try to init the U85 hardware (base 0x49042000)
 * and fault.  DMA placement is identical to the U85 path: model + arena live in
 * NPU-reachable global SRAM0 (@0x02000000, the SoC-dtsi sram0 node's linker
 * region); the SDK's strong ethosu_address_remap / ethosu_config_select
 * (src/backends/inference/ethos_u_aen.cpp) are variant-agnostic and route the
 * SRAM0 accesses over the NPU's SRAM AXI port.  CONFIG_DCACHE=n (prj.conf)
 * keeps CPU + NPU coherent with no maintenance calls.
 */

/*
 * global_base for hal_alif soc_memory_map.h local_to_global() -- the itcm/dtcm
 * nodes' upstream bindings carry no global_base, so re-compatible them onto the
 * alp-sdk alif,itcm/alif,dtcm bindings and set the E8 RTSS-HE global views
 * (transcribed from the Apache-2.0 zephyr_alif fork ensemble_rtss_he.dtsi):
 * ITCM global_base = 0x58000000, DTCM global_base = 0x58800000.
 */
&itcm {
	compatible = "alif,itcm";
	global_base = <0x58000000>;
};

&dtcm {
	compatible = "alif,dtcm";
	global_base = <0x58800000>;
};

/* Run the U55 (M55-HE-paired) instead of the U85: enable the ethosu55 node
 * (declared status="disabled" in the SoC peripherals dtsi) and disable the
 * ethosu85 the generated board leaves okay, so the U55-configured Arm driver
 * binds exactly one node -- the U55 at 0x400e1000. */
&ethosu55 {
	status = "okay";
};

&ethosu85 {
	status = "disabled";
};
