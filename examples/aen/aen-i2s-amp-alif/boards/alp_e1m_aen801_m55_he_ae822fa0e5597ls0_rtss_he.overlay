 * Copyright (c) 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * Audio-I2S out overlay for the E1M-AEN801 (E8, M55-HE).
 *
 * The EVK audio I2S is the SoC's **i2s3** (i2s3@49017000) -- per the AUTHORITATIVE
 * SoM pinout metadata/e1m_modules/aen/from-alif.tsv, the board's "I2S0_*" audio
 * signals are wired to I2S3_*_A on P9_2..P9_5:
 *   I2S0_SDI -> I2S3_SDI_A = P9_2 | I2S0_SDO -> I2S3_SDO_A = P9_3
 *   I2S0_SCLK -> I2S3_SCLK_A = P9_4 | I2S0_WS -> I2S3_WS_A = P9_5
 * (NOT i2s0@49014000 -- that was the first cut's wrong instance.) The
 * snps,designware-i2s node + driver (drivers/i2s/i2s_dw.c, CONFIG_I2S_DW) are
 * transcribed from the fork; alias alp-i2s0 -> &i2s3 keeps the portable bus id.
 *
 * DISABLED BY DEFAULT on EVK rev 2626-R2: I2S0_SDO/SCLK/WS (P9_3/4/5) run
 * through U46, a 74LVC157 2:1 mux with NO high-impedance state -- with /E
 * high its Y outputs are forced LOW, not floated. Those Y outputs are wired
 * BACKWARDS for this direction (they drive the SoC's own I2S0_* pads, not
 * the amps or the M.2 slot), so the instant this i2s3 node's pinctrl muxes
 * P9_3/4/5 to the I2S3 alternate function and the controller drives them,
 * the SoC fights U46's forced-low outputs on the same pads -- whether or
 * not U46's /E is ever asserted. Disabling the whole node, not just
 * skipping the app's i2s_configure()/i2s_write() calls, is the point: a
 * disabled node gets no pinctrl-0 applied and no clock enabled at driver
 * init, so nothing drives P9_3/4/5 at all. To exercise this node once U46
 * is a 3257-type bus switch (removes this contention regardless of which
 * rail powers it -- this app never drives EN or SEL and does not test
 * the amps; amp audibility is a separate, stricter condition -- VCC was
 * moved to +3V3 between a silent run and an audible run on
 * e1m-aen-evk-03, not established as the only difference -- see
 * include/alp/boards/alp_e1m_evk.h's I2S mux block):
 * `-DEXTRA_DTC_OVERLAY_FILE=i2s3-enable-post-u46-rework.overlay`
 * (resolved relative to this app's own source dir, examples/aen/aen-i2s-amp-alif;
 * that file just sets `&i2s3 { status = "okay"; };`) -- the single documented
 * switch; nothing else in this app needs to change.
 */
#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>
#include <zephyr/dt-bindings/clock/alif-ensemble-clocks-ext.h>

/ {
	chosen {
		zephyr,flash = &itcm; /* bench RAM/SES-load; path-ref form */
		/delete-property/ zephyr,code-partition;
	};
	aliases {
		alp-i2s0 = &i2s3;
	};
};

&pinctrl {
	pinctrl_i2s3: pinctrl_i2s3 {
		/* TX: SDO + SCLK + WS, the I2S3_*_A route (P9_3/4/5). RX: SDI
		 * (P9_2, I2S3_SDI_A) -- U46's 4Y is the one leg of that mux wired
		 * the correct direction (unlike SDO/SCLK/WS, which contend with
		 * the SoC and are why this node ships disabled -- see the
		 * file-header SAFETY note), feeding the amps' SDOUT/IV-sense back
		 * to the SoC. input-enable sets the pad's REN bit so the input
		 * buffer actually samples; without it the mux alone is not
		 * sufficient to receive (REN defaults off). The original TX-only
		 * scope here was a deliberate choice, not a hazard -- that scope
		 * has since widened. Still inert on its own: this node ships
		 * "disabled" by default, so pinctrl-0 is not applied until
		 * i2s3-enable-post-u46-rework.overlay flips it "okay". */
		group0 {
			pinmux = <PIN_P9_3__I2S3_SDO_A>, <PIN_P9_4__I2S3_SCLK_A>,
				 <PIN_P9_5__I2S3_WS_A>;
		};
		group1 {
			pinmux = <PIN_P9_2__I2S3_SDI_A>;
			input-enable;
		};
	};
};

&{/soc} {
	i2s3: i2s3@49017000 {
		compatible = "snps,designware-i2s";
		reg = <0x49017000 0x1000>;
		interrupts = <144 3>;
		pinctrl-0 = <&pinctrl_i2s3>;
		pinctrl-names = "default";
		clocks = <&clockctrl ALIF_I2S3_76M8_CLK>;
		/* "disabled" by default -- see the file-header SAFETY note above.
		 * -DEXTRA_DTC_OVERLAY_FILE=i2s3-enable-post-u46-rework.overlay
		 * flips this back to "okay" once U46 is a 3257-type bus
		 * switch (any rail -- see the file-header note). */
		status = "disabled";
	};
};
