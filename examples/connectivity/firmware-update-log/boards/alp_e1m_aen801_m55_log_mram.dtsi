/*
 * Copyright 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * Shared MRAM layout for the AEN firmware-update-log HE client and HP owner.
 *
 * The demo images are loaded to each core's ITCM by the SE ATOC package. The
 * audit-log body is the part that lives in MRAM, in alp_ulog_partition below.
 *
 *   0x000000..0x00ffff  boot placeholder
 *   0x010000..0x08ffff  unused by this ITCM-loaded demo
 *   0x090000..0x09ffff  alp_ulog_partition, Zephyr NVS update-log store
 *   0x560000..0x57ffff  reserved for the Alif ATOC package
 *
 * In the hardware-enforced flow, HP owns alp_ulog_partition and HE must be
 * blocked from writing it by the SE/device firewall. Without that firewall
 * policy, MRAM/NVS is persistence only, not application-immutability.
 *
 * alp_ulog_partition ALSO carries the `storage_partition` nodelabel (issue
 * #1101). zephyr/soc-bridge/alif/mpu_regions_e8.c derives its non-MCUboot
 * MRAM_DEVICE window from DT_NODELABEL(storage_partition) -- that is the
 * vendor fork's own contract name (zephyr_alif-ref mpu_regions.c), declared
 * unconditionally at SoC level on every upstream board. A plain rename to
 * `alp_ulog_partition` alone would silently break sw_tier.c's
 * PARTITION_EXISTS(alp_ulog_partition) gate too (src/backends/update_log/
 * sw_tier.c) -- it would just stop finding a *different* name, degrading to
 * the RAM tier with no build error. Two nodelabels on one node is legal DT
 * (see zephyr/boards/st/b_u585i_iot02a/b_u585i_iot02a-common.dtsi's
 * `memc: aps6408l:` for prior art in the pinned toolchain) and resolves both
 * consumers to the same physical node -- do not "simplify" this back to one
 * label.
 *
 * Unlike this board's own default partition map, `storage_partition` here
 * is NOT the last partition in mram_storage -- atoc_reserved_partition sits
 * above it, fixed at 0x560000 by the Alif SE ATOC package. That breaks the
 * vendor model's implicit "storage tiles to top-of-flash" assumption:
 * MRAM_EXEC (0x0..0x90000) + MRAM_DEVICE (0x90000..0xa0000) alone would
 * leave 0xa0000..0x580000 -- ATOC included -- covered by no MPU region, i.e.
 * privileged RW+exec by ARMv8-M default (PRIVDEFENA). mpu_regions_e8.c
 * closes that generically with a conditional fifth "MRAM_RESERVED" RO
 * region that appears only when boot/slot0/storage don't already tile
 * mram_storage (zero-cost on every other board/example, which do tile it);
 * see that file's comment on MRAM_RESERVED_SIZE for the full reasoning.
 */

/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &scratch_partition;
/delete-node/ &storage_partition;

&mram_storage {
	partitions {
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			label = "image-0-unused";
			reg = <0x10000 DT_SIZE_K(512)>;
		};

		alp_ulog_partition: storage_partition: partition@90000 {
			label = "alp-ulog";
			reg = <0x90000 DT_SIZE_K(64)>;
		};

		atoc_reserved_partition: partition@560000 {
			label = "alif-atoc";
			reg = <0x560000 DT_SIZE_K(128)>;
			read-only;
		};
	};
};
