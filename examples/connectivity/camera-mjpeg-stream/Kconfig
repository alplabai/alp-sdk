# Resolution select for this example.  Off (default) keeps the
# bench-proven 640x480@30fps path; on switches src/main.c and
# mjpeg_http.h over to the Stage-A 1280x960@15fps centre-crop path
# (issue #2286) -- see boards/overlay-1280x960-aen803.conf for the
# matching ISP-buffer-count and video-pool-size deltas that resolution
# needs on the E1M-AEN803's 4 MiB SRAM0 bank.

config CAMERA_MJPEG_STREAM_1280X960
	bool "Stream at 1280x960@15fps instead of 640x480@30fps"
	default n
	help
	  Selects the OV5647's existing centre-crop mode (no sensor
	  register-table change) at 1280x960, 15 fps -- see issue #2286
	  Stage A.  Two 1,843,200 B NV12 frames plus two ~160 KiB JPEG
	  output buffers no longer fit alongside a third raw ISP buffer
	  and the synthetic-frame fallback in the AEN's 4 MiB SRAM0 bank,
	  so this build variant also drops the synthetic-frame fallback
	  path entirely (src/main.c) and pairs with
	  boards/overlay-1280x960-aen803.conf, which lowers
	  CONFIG_ALP_SDK_CAMERA_ALIF_ISP_VBUF_COUNT to 2 and resizes the
	  video buffer pool.  1920x1080 and 2592x1944 are out of scope
	  (infeasible per the issue's feasibility note -- two NV12 frames
	  at either size don't fit SRAM0 at all).

source "Kconfig.zephyr"
