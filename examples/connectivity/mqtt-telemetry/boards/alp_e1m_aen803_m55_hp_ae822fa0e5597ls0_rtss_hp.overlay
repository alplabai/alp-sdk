 *
 * E1M-AEN803 M55-HP overlay for mqtt-telemetry (#2363).  This example's only AEN
 * target is the M55-HP, but it shipped no board overlay, so the SPI1 /
 * CC3501E-bridge pads had no DT node or pinmux there and
 * cc3501e_bridge_bringup() (src/cc3501e_bridge.c, bus_id
 * CC3501E_BRIDGE_SPI_BUS_ID = 1, alp_pins WIFI_EN/NRST) returned
 * ALP_ERR_NOT_PRESENT_ON_THIS_SOC.
 *
 * Byte-for-byte the CC3501E bridge wiring of
 * examples/connectivity/iot-dashboard's M55-HP overlay (#2242), itself the
 * bridge subset of examples/peripheral-io/alp-console's bench-validated
 * M55-HE overlay -- the SoM-internal Alif<->CC3501E SPI1 link + the two
 * host-driven control nets, from metadata/e1m_modules/aen/inter-chip.tsv:
 *   SPI1.SCK P14_6  MOSI P14_5  MISO P14_4   WIFI_EN P15_5  NRST P15_1_FLEX
 * SPI1 @0x48104000 and lpgpio @0x42002000 come from the shared
 * zephyr/dts/alif/ensemble_e8_peripherals.dtsi the HP board dts also
 * includes, so the addresses are the same silicon the M55-HE overlays use.
 *
 * IRQ 138 is carried over from the M55-HE overlays; see their BENCH-TBD
 * comment.
 */
#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&pinctrl {
	/* SPI1 master (CC3501E bridge): SCK P14_6 / MOSI P14_5 / MISO P14_4 (alt-2, _C). */
	pinctrl_spi1: pinctrl_spi1 {
		group0 {
			/* SS0 (P14_7) is now peripheral-driven -- the dwc-ssi hardware chip-select,
			 * NOT the old GPIO bodge.  Push-pull output pad like SCLK/MOSI (no input-enable);
			 * the master asserts/deasserts SS0 per transfer (write_ser). */
			pinmux = <PIN_P14_6__SPI1_SCLK_C>, <PIN_P14_5__SPI1_MOSI_C>,
				 <PIN_P14_7__SPI1_SS0_C>;
		};
		group1 {
			pinmux = <PIN_P14_4__SPI1_MISO_C>;
			input-enable;
		};
	};
};

/* P14_7 (CS) is now muxed as SPI1_SS0_C in pinctrl_spi1 -- the dwc-ssi peripheral drives
 * it in hardware per transfer.  The old gpio14 GPIO-bodge controller node is removed: a
 * GPIO claim of P14_7 would fight the SS0 pinctrl mux. */

&clockctrl {
	status = "okay";
};

&soc {
	/* DWC_ssi SPI1 -- the on-SoM CC3501E inter-chip link (NOT the edge SPI0).
	 * 4-wire: SCLK/MOSI/MISO + the hardware SS0 chip-select (P14_7 = SPI1_SS0_C,
	 * declared in pinctrl_spi1 above); clock-frequency = 200 MHz, the real SSI
	 * functional clock (E8 HWRM), so spi_dw_alif skips the failing
	 * clock-control path. */
	cc3501e_spi: spi@48104000 {
		compatible = "alif,dwc-ssi-spi";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x48104000 0x1000>;
		interrupts = <138 3>;          /* BENCH-TBD: SPI1 IRQ */
		clocks = <&clockctrl ALIF_SPI_CLK>;
		/* Real SSI functional clock (E8 HWRM).  Was mis-set to 400000000 here,
		 * which is not a cosmetic error: spi_dw derives BAUDR =
		 * clock-frequency / freq_hz, so a doubled input clock doubles the
		 * divider and HALVES the real SCLK -- this node was running at
		 * 500 kHz while asking for 1 MHz.  Proven via BAUDR scaling and
		 * already corrected in the aen-cc3501e-* overlays. */
		clock-frequency = <200000000>;
		dwc-ssi;
		fifo-depth = <16>;
		/* `rx-delay` IS a real devicetree property
		 * (zephyr/dts/bindings/spi/alif,dwc-ssi-spi.yaml, int, default 0) --
		 * deliberately left UNSET here, not omitted because it doesn't exist.
		 * spi_dw_alif.c writes RX_SAMPLE_DLY (reg 0xF0, ssi_clk cycles at
		 * 200 MHz = 5 ns/cycle) from this property at BOTH init and PM resume
		 * (write_rxdly(dev, info->rx_delay)); spi_dw_configure() never touches
		 * the register outside those two paths. src/cc3501e_bridge.c pokes
		 * RX_SAMPLE_DLY itself once inside cc3501e_bridge_bringup(), after
		 * this node's init already ran, so the unset (0) property here does
		 * not matter today. The overwrite is LATENT, not live: only the
		 * `#if defined CONFIG_PM_DEVICE` resume path (spi_dw_alif.c) would
		 * re-write RX_SAMPLE_DLY from this property, and nothing in this app
		 * enables CONFIG_PM_DEVICE. CC3501E_BRIDGE_RX_SAMPLE_DLY is 4,
		 * silicon-tuned for ~25 MHz on E1M-AEN803 serial 2026W36-0002 --
		 * NOT 6 / ~14.3 MHz, an earlier measurement the header itself
		 * documents as stale and not comparable (see cc3501e_bridge.h's own
		 * correction). */
		pinctrl-0 = <&pinctrl_spi1>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* LP GPIO island: WIFI_EN (P15_5) + E_WIFI.NRST (P15_1_FLEX) as outputs. */
&lpgpio {
	status = "okay";
};

/ {
	aliases {
		alp-spi1 = &cc3501e_spi;   /* bus_id 1 in cc3501e_bridge_bringup() */
	};

	/* SoM-internal CC3501E control nets, in CC3501E_PIN_* index order. */
	alp_pins: alp-pins {
		compatible = "alp,pin-array";
		gpios = <&lpgpio 5 GPIO_ACTIVE_HIGH>,   /* [0] WIFI_EN     (P15_5)      */
			<&lpgpio 1 GPIO_ACTIVE_HIGH>;   /* [1] E_WIFI.NRST (P15_1_FLEX) */
	};
};
