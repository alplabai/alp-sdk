/*
 * Copyright 2026 Alp Lab AB
 * SPDX-License-Identifier: Apache-2.0
 *
 * Real-hardware pin routing for blink on the E1M-AEN801 (Alif Ensemble
 * E8), M55-HE core.  The M55-HP overlay beside this one is identical --
 * the LED pad is a SoM-level route, not a core-level one, so either
 * core can drive it.
 *
 * WHY THIS FILE EXISTS AT ALL.  <alp/peripheral.h>'s portable
 * alp_gpio_open() resolves a pin id through the `alp,pin-array` DT node
 * (src/backends/gpio/zephyr_drv.c, alp_z_gpio_resolve()).  That node is
 * NOT supplied by the board tree under zephyr/boards/alp/ -- every
 * example that touches GPIO on real silicon ships its own.  Without
 * this file the example builds, links, boots, reaches main() and then
 * fails at the first call with ALP_ERR_INVAL, because the array does
 * not exist.  Verified before this overlay was added:
 *
 *     [blink] init led=BOARD_PIN_LED_RED
 *     [blink] failed: open status=-1
 *
 * THE PAD.  BOARD_PIN_LED_RED -> EVK_PIN_LED_RED -> ALP_E1M_GPIO_PWM0,
 * canonical pin id 26.  (Bench-measured 2026-07-28: the RGB LED's
 * RED/GREEN pads were swapped from the internal netlist's wrong
 * LED_R/LED_G net names -- PWM0 is physically red, PWM3 physically
 * green; see metadata/boards/e1m-evk.yaml's `e1m_routes:` comment.
 * Don't "fix" this back toward the netlist.)  The E1M pad -> Alif pad
 * mapping is committed data, not a guess --
 * metadata/e1m_modules/aen/from-alif.tsv:5:
 *
 *     e1m_pad  e1m_function  alif_peripheral  alif_pad
 *     A6       PWM0          UT11_T1_C        P12_7
 *
 * P12_7 is port 12 pin 7 -> `gpio12` (gpio@4900c000,
 * zephyr/dts/alif/ensemble_e8_peripherals.dtsi:222).  Its GPIO function
 * is alt-0 (PIN_P12_7__GPIO = ALIF_PINMUX(12, 7, 0)); the pad's default
 * peripheral function UT11_T1_C is alt-4, which is the PWM path a real
 * PWM fade on this pad would claim instead.  Same silicon -- never
 * hold both at once.
 *
 * WHY THE OTHER 25 ENTRIES POINT AT A DISABLED NODE.  The array is
 * POSITIONAL and the resolver bounds-checks against its length
 * (`if (pin_id >= ARRAY_SIZE(alp_pins)) return false;`), so reaching
 * index 26 means declaring indices 0..25 as well (this overlay in fact
 * declares through index 29, since the RGB GREEN/BLUE channels also
 * have committed Alif mappings).  Only 11 of the E1M GPIO-class pads
 * have a committed Alif mapping in from-alif.tsv (IO0, IO2..IO7,
 * PWM0..PWM4, PWM6) -- IO1 and IO8..IO25 have none.
 *
 * Filling those slots with plausible-looking gpio2 pins would make
 * alp_gpio_open() on any of them DRIVE A REAL PAD on a live board,
 * chosen by guesswork, with whatever else is wired to it.  That is a
 * hardware-contention hazard, not a documentation shortcut.  Instead
 * every unmapped index points at gpio2 pin 31 -- a REAL, ready
 * controller but a pin that does not exist on it (gpio2 has
 * `ngpios = <8>`, so only pins 0..7 are valid).  Zephyr's generic
 * gpio_pin_configure() rejects it against the port pin mask with
 * -EINVAL, so the call fails before any pad is touched.  A disabled
 * sentinel node cannot be used instead: Zephyr only instantiates
 * devices for `status = "okay"` nodes, so DEVICE_DT_GET on a disabled
 * one fails to build (`__device_dts_ord_N undeclared`).
 *
 * So on this board: opening BOARD_PIN_LED_RED works; opening an
 * unmapped E1M pad fails cleanly and loudly.  When a pad gains a real
 * mapping in from-alif.tsv, move its entry off the sentinel.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * No &pinctrl group here on purpose.  GPIO is alt-0 on this SoC and is
 * the pad's default mux, so P12_7 (the LED pad, PWM0) comes up as GPIO
 * without a pinmux entry -- the same reason examples/aen/aen-cc3501e-gpio
 * notes "the LP-GPIO mux (alt-0 default)" for its control nets.  It
 * could not be attached here anyway: gpio12 binds snps,designware-gpio.yaml,
 * which declares no `pinctrl-0` property, so adding one is a devicetree
 * error.  Claiming the pad's alt-4 UT11_T1_C timer function instead is
 * what a real PWM fade on this pad would do.
 */

&gpio12 {
	status = "okay";
};

/*
 * gpio2 backs the RGB LED's GREEN channel (P2_4, PWM3 --
 * metadata/e1m_modules/aen/from-alif.tsv: `B5 PWM3 UT10_T0_A P2_4`,
 * see index [29] below) plus every unmapped sentinel slot in this
 * array (gpio2 pin 31, see the header comment).  This demo doesn't
 * open the green channel, but index 29 still needs a real, enabled
 * controller behind it -- same reasoning as gpio12 above.
 */
&gpio2 {
	status = "okay";
};

/*
 * gpio12 also backs the RGB LED's BLUE channel (P12_6, PWM1 --
 * `B6 PWM1 UT11_T0_C P12_6`, see index [27] below).  Both gpio11..gpio14
 * only became reachable when they were added to
 * ensemble_e8_peripherals.dtsi -- before that these routes resolved to
 * no controller at all.
 */

/ {
	alp_pins: alp-pins {
		compatible = "alp,pin-array";
		gpios = <&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 0] ALP_E1M_GPIO_IO0   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 1] ALP_E1M_GPIO_IO1   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 2] ALP_E1M_GPIO_IO2   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 3] ALP_E1M_GPIO_IO3   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 4] ALP_E1M_GPIO_IO4   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 5] ALP_E1M_GPIO_IO5   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 6] ALP_E1M_GPIO_IO6   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 7] ALP_E1M_GPIO_IO7   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 8] ALP_E1M_GPIO_IO8   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [ 9] ALP_E1M_GPIO_IO9   -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [10] ALP_E1M_GPIO_IO10  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [11] ALP_E1M_GPIO_IO11  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [12] ALP_E1M_GPIO_IO12  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [13] ALP_E1M_GPIO_IO13  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [14] ALP_E1M_GPIO_IO14  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [15] ALP_E1M_GPIO_IO15  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [16] ALP_E1M_GPIO_IO16  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [17] ALP_E1M_GPIO_IO17  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [18] ALP_E1M_GPIO_IO18  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [19] ALP_E1M_GPIO_IO19  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [20] ALP_E1M_GPIO_IO20  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [21] ALP_E1M_GPIO_IO21  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [22] ALP_E1M_GPIO_IO22  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [23] ALP_E1M_GPIO_IO23  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [24] ALP_E1M_GPIO_IO24  -- unmapped */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [25] ALP_E1M_GPIO_IO25  -- unmapped */
			<&gpio12 7 GPIO_ACTIVE_HIGH>,   /* [26] ALP_E1M_GPIO_PWM0  -- THE LED (RGB red channel): E1M pad A6 -> Alif P12_7 */
			<&gpio12 6 GPIO_ACTIVE_HIGH>,   /* [27] ALP_E1M_GPIO_PWM1  -- RGB blue channel:  E1M pad B6 -> Alif P12_6 */
			<&gpio2 31 GPIO_ACTIVE_HIGH>,   /* [28] ALP_E1M_GPIO_PWM2  -- unmapped here */
			<&gpio2          4 GPIO_ACTIVE_HIGH>;   /* [29] ALP_E1M_GPIO_PWM3  -- RGB green channel (unused here): E1M pad B5 -> Alif P2_4 */
	};
};
