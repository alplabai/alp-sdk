prefix=@ALP_SDK_PC_PREFIX@
libdir=@ALP_SDK_PC_LIBDIR@
includedir=@ALP_SDK_PC_INCLUDEDIR@

Name: alp-sdk
Description: Alp SDK static library (Linux/Yocto); Libs forces in the second backends a plain -lalp_sdk would drop
Version: @ALP_SDK_PC_VERSION@
Requires: @ALP_SDK_PC_REQUIRES@
Cflags: -I${includedir}@ALP_SDK_PC_DEFINES@
Libs: -L${libdir}@ALP_SDK_PC_FORCED_FLAGS@ -lalp_sdk@ALP_SDK_PC_LIBS@
