# Auto-generated by `scripts/alp_project.py --emit zephyr-board` from
# metadata/e1m_modules/E1M-AEN801.yaml + metadata/socs/alif/ensemble/e8.json.
# DO NOT EDIT BY HAND -- regenerate.

if BOARD_ALP_E1M_AEN801_M55_HE

# The Ensemble E8 RTSS-HE has CONFIG_NUM_IRQS=480, so the ARMv8-M vector table is
# (16 + 480) * 4 = 1984 bytes and the hardware VTOR must be 2 KiB (0x800) aligned.
# For an MCUboot chain-loaded image the linker therefore places _vector_table at
# slot_base + 0x800, but Zephyr hard-defaults the MCUboot header (ROM_START_OFFSET,
# which is also imgtool --header-size) to 0x200 under BOOTLOADER_MCUBOOT and makes
# it non-promptable. MCUboot then jumps to slot_base + 0x200 (header end) and reads
# a garbage SP/PC from the 0x600 padding gap -> instant HardFault -> reset/reboot
# loop, never reaching the app. Bump the header reservation to match the vector
# alignment so the jump target == _vector_table. (Affects only chain-loaded images;
# MCUboot itself builds with BOOTLOADER_MCUBOOT=n.)
config ROM_START_OFFSET
	default 0x800 if BOOTLOADER_MCUBOOT

# alp-sdk's own chips/tmp112/tmp112.c defines tmp112_init(), and upstream
# Zephyr's zephyr/drivers/sensor/ti/tmp112/tmp112.c defines the SAME symbol
# for the SAME part.  The two only collide at LINK time, and only when an
# app pulls in both -- which CONFIG_SENSOR=y does for free on this board,
# because the ti,tmp112 devicetree node below auto-selects upstream's
# driver regardless of whether the app uses it (#2043).  Board-scope the
# fix instead of leaving every app to rediscover it: default the upstream
# driver OFF here.  This is not a permanent no -- Kconfig.zephyr sources a
# board's Kconfig.defconfig ahead of subsys/Kconfig (see the LOG_MODE
# comment below for the same precedence fact), so this default only
# supplies a value when nothing else assigns the symbol.  An app that
# genuinely wants the upstream driver is therefore expected to win by
# setting CONFIG_TMP112=y explicitly in its own prj.conf -- ordinary
# Kconfig behaviour for a user assignment versus a `default` -- and that
# is exactly why examples/aen/aen-temp-sensor sets it by name.
#
# CONFIRMED ON THE REAL BOARD TARGET, not just by mechanism.  `west build
# -p always -b alp_e1m_aen801_m55_he/ae822fa0e5597ls0/rtss_he
# examples/aen/aen-temp-sensor` links
# zephyr/drivers/sensor/ti/tmp112/libdrivers__sensor__ti__tmp112.a (step
# 139/148), and the resolved .config carries CONFIG_TMP112=y,
# CONFIG_SENSOR=y and CONFIG_DT_HAS_TI_TMP112_ENABLED=y with this board's
# `default n` in force -- the explicit CONFIG_TMP112=y in
# examples/aen/aen-temp-sensor/prj.conf really does win, on silicon-
# targeted Kconfig, not only in theory.  If that build ever fails on
# CONFIG_TMP112, this derivation is what needs revisiting, not the
# build.
config TMP112
	default n

# Logging: default to LOG_MODE_MINIMAL, not Zephyr's inherited
# LOG_MODE_DEFERRED.  Deferred mode needs CONFIG_LOG_PROCESS_THREAD to run,
# and the AEN bench procedure runs apps whose main() never yields (a
# non-yielding busy loop is what keeps the Secure Enclave from gating the
# DAP and the SE-UART -- see docs/debugging-aen.md section 4).  A
# non-yielding main() starves the log thread, and because CONFIG_LOG_PRINTK
# routes printk() through the same queue the Alp SDK banner disappears too:
# a running, fault-free board prints ZERO bytes.  Measured on E1M-AEN801
# silicon (issue #1373) -- PC inside z_impl_k_busy_wait, IPSR = 000,
# CFSR @ 0xE000ED28 = 00000000, and no UART output at all.  Minimal mode
# formats in the calling context, so the same app prints.  An app that
# wants the deferred pipeline (backends, runtime filtering, timestamps)
# overrides this with CONFIG_LOG_MODE_DEFERRED=y in its prj.conf.
choice LOG_MODE
	default LOG_MODE_MINIMAL
endchoice

endif # BOARD_ALP_E1M_AEN801_M55_HE
