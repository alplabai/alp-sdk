# Hand-maintained (NOT generated by `alp_project.py --emit zephyr-board` --
# compare Kconfig.alp_e1m_aen801_m55_he / Kconfig.defconfig in this same
# directory, which ARE generated and carry "DO NOT EDIT BY HAND"). A bare
# `Kconfig` in a board directory is unconditionally osourced by Zephyr's
# hwm_v2.cmake (kconfig_gen("boards" "Kconfig" ...) -> `source "boards/Kconfig"`
# in Kconfig.zephyr) whether or not the file exists, so this survives
# regeneration exactly like board.cmake already does in this directory.
#
# Selects the custom E8 MPU region table (zephyr/soc-bridge/alif/
# mpu_regions_e8.c, wired from the hand-maintained top-level
# zephyr/CMakeLists.txt) in place of Zephyr's generic 2-region FLASH_0/SRAM_0
# fallback (arch/arm/core/mpu/arm_mpu_regions.c) -- see that file's header for
# why the fallback's whole-flash FLASH_0 region is unsafe on this board's Flow
# D (production MRAM boot).

if BOARD_ALP_E1M_AEN801_M55_HE

config CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS
	default y

endif # BOARD_ALP_E1M_AEN801_M55_HE
