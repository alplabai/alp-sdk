 * Auto-generated by `scripts/alp_project.py --emit zephyr-board` from
 * metadata/e1m_modules/E1M-AEN801.yaml + metadata/socs/alif/ensemble/e8.json + metadata/e1m_modules/aen/on-module-links.yaml.
 * DO NOT EDIT BY HAND -- regenerate.
 *
 * E1M-AEN801 (Alif Ensemble E8) Cortex-M55-HP carrier pin control.
 *
 * Console: the E1M edge "UART0" maps to Alif UART5 (P3_4 RX_A / P3_5 TX_A) on
 * the AEN module PCB; the Alp E1M-EVK carrier wires its USB-UART console to it.
 * (In an HE+HP AMP image the two cores share this single physical console;
 * during bring-up each core is flashed/run independently.)  Confirmed against
 * the SoM netlist + metadata/e1m_modules/aen/from-alif.tsv.
 *
 *
 * BRD_I2C (SoC I2C0, function C) is wired here too: it is an ON-MODULE bus
 * carrying SoM-resident parts (RTC + temperature sensor), present on every
 * board built from this SoM -- not a per-app choice, so it belongs in the
 * board layer rather than in each consumer's overlay.  Pads, macros and pad
 * config come from metadata/e1m_modules/aen/on-module-links.yaml.
 *
 * Remaining GPIO / SPI / Ethernet pin groups are added alongside their
 * drivers (the alp-sdk Alif peripheral drivers).
 */

#include <zephyr/dt-bindings/pinctrl/alif-ensemble-pinctrl.h>

&pinctrl {
	pinctrl_uart5: pinctrl_uart5 {
		group0 {
			pinmux = <PIN_P3_4__UART5_RX_A>;
			input-enable;
		};

		group1 {
			pinmux = <PIN_P3_5__UART5_TX_A>;
		};
	};

	/*
	 * BRD_I2C = SoC I2C0 function C: P7_0 SDA / P7_1 SCL,
	 * the on-module housekeeping bus (see the board .dts for the parts on it).
	 *
	 * BOTH pins get input-enable, in one group -- Alif's own DFP sets
	 * PADCTRL_READ_ENABLE on P7_0 AND P7_1.  With it on SDA only, the
	 * i2c_dw controller cannot SENSE SCL (clock-stretch detect / arbitration)
	 * and NACKs every address for a reason that looks electrical but is not.
	 *
	 * bias-pull-up is DSC=1, a REAL pull-up (soc/alif/ensemble/pinctrl_soc.h
	 * encodes bits 19:20 [DSC] as 0=high-Z, 1=pull-up, 2=pull-down,
	 * 3=bus-keeper).  Do NOT copy the I2C2/EEPROM overlay's bias-pull-down:
	 * DSC=2 is a pull-DOWN, harmless there only because that bus has external
	 * carrier pull-ups (R137/R144).  This net has NO external pull-up at all,
	 * so a pull-down would park both lines low and look like a busy bus.
	 *
	 * drive-open-drain is deliberately NOT set, so bit 23 [DRV] stays 0 =
	 * PUSH-PULL: the pad actively drives the high phase instead of relying on
	 * a pull-up this net does not have.  input-schmitt-enable + max
	 * drive-strength/slew-rate cover the resulting slow edges.  Bench-proven
	 * 2026-09-05 on E1M-AEN801 2626-R2: every non-response is a clean rc=-5
	 * (-EIO) NACK, zero -ETIMEDOUT, zero "User Abort".
	 */
	pinctrl_i2c0: pinctrl_i2c0 {
		group0 {
			pinmux = <PIN_P7_0__I2C0_SDA_C>, <PIN_P7_1__I2C0_SCL_C>;
			input-enable;
			bias-pull-up;
			input-schmitt-enable;
			drive-strength = <12>;
			slew-rate = "fast";
		};

		/*
		 * RTC_ALARM: the RV-3028 /INT line on P15_0 (lpgpio bit 0).
		 * Muxed + input-enabled here because snps,designware-gpio has no
		 * pinctrl-0 of its own (see this function's docstring); without it the
		 * pad input buffer stays off and the alarm reads 0 forever.
		 */
		group1 {
			pinmux = <PIN_P15_0__LPGPIO>;
			input-enable;
		};
	};
};
