CONFIG_XIP=n

# CM33 serial console (sci0 = EVK "Pmod USB-UART") DISABLED on this board:
# the only console is the A55's; sci0 is not wired as a CM33 console here, and
# opening it faults on the floating RX (sci0 eri -> Zephyr fatal -> hang before
# main()).  Re-enable UART_CONSOLE (and sci0 in the dts) only with a Pmod
# attached AND once Linux cannot gate the rsci_0_* clocks (audit CM33-05).
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=n

# Enabling sci0 also needs CONFIG_UART_INTERRUPT_DRIVEN=y: the FSP always
# enables the rxi/eri IRQs, and the Zephyr driver only IRQ_CONNECTs them
# under it -- otherwise an unhandled NVIC line goes fatal.  Not set here:
# with sci0 disabled it resolves to n and Kconfig warns.

# RAM console: the CM33 has no UART and no SWD yet, so printk lands in a
# fixed buffer (zephyr,ram-console node in the dts, inside the 0x9f700000
# window Linux reserves) that the A55 reads post-mortem via /dev/mem at
# 0x4f710000.  CONFIG_CONSOLE=y only pulls the RAM console in; with
# UART_CONSOLE=n nothing touches sci0.  Size must equal the dts node's reg.
CONFIG_CONSOLE=y
CONFIG_RAM_CONSOLE=y
CONFIG_RAM_CONSOLE_BUFFER_SIZE=16384

# On-module GD32G553 supervisor bridge transport.  SPI only: RIIC8/
# BRD_I2C is Cortex-A55/Linux-exclusive, so no CONFIG_I2C here.
CONFIG_SPI=y
