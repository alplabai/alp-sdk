if SHIELD_E1M_EVK_MICROSD

# The shield's zephyr,sdmmc-disk "SD" is only reachable through the disk
# access layer, which needs the SD host stack under it.
config DISK_ACCESS
	default y

config SDHC
	default y

endif # SHIELD_E1M_EVK_MICROSD
