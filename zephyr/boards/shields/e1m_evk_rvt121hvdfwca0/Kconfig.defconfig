#
# Everything the Riverdi RVT121HVDFWCA0-B (via a TI SN65DSI83 DSI-to-LVDS
# adapter) display chain needs on an E1M-AEN SoM, so an app only adds the
# shield: the DSI host + D-PHY, the SN65DSI83 bridge driver, and the
# carrier's I2C GPIO expander that carries the bridge's EN pin.  Unlike
# e1m_evk_rk055hdmipi4ma0, DISPLAY_CDC200 is what actually renders here (the
# bridge is init-only, no display API of its own) and there is no panel
# driver or fixed regulator -- the bridge's EN sequencing IS the panel-power
# sequencing (see display_sn65dsi83.c's header comment for why the regulator
# pattern the RK055 shield uses cannot be reused here).
#
# The app must set CONFIG_ALP_SDK=y, as every alp-sdk AEN app does: the Alif
# CDC200 / DesignWare DSI / D-PHY drivers are alp-sdk ADR 0017 Tier-2 copies
# whose symbols are defined under `if ALP_SDK`.  The shield does not default
# ALP_SDK itself -- turning the SDK on is the app's decision.

if SHIELD_E1M_EVK_RVT121HVDFWCA0

config DISPLAY
	default y

config MIPI_DSI
	default y

config I2C
	default y

config GPIO
	default y

config GPIO_PCA_SERIES
	default y

# The panel's ILI2511 touch controller (touch@41 on &i2c1).  Polled: the
# carrier routes the touch INT line to a CC3501E-owned pad, not to the Alif.
config INPUT
	default y

if ALP_SDK

config MIPI_DPHY
	default y

config MIPI_DPHY_DW
	default y

config MIPI_DSI_DW
	default y

config DISPLAY_CDC200
	default y

config SN65DSI83
	default y

endif # ALP_SDK

endif # SHIELD_E1M_EVK_RVT121HVDFWCA0
