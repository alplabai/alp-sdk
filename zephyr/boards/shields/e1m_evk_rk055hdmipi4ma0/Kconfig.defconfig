#
# Everything the RK055HDMIPI4MA0 display chain needs on an E1M-AEN SoM, so an
# app only adds the shield: the display class, the DSI host + D-PHY, the panel
# driver, and the carrier's I2C GPIO expander + fixed regulator that power and
# reset the panel.
#
# The app must set CONFIG_ALP_SDK=y, as every alp-sdk AEN app does: the Alif
# CDC200 / DesignWare DSI / D-PHY drivers are alp-sdk ADR 0017 Tier-2 copies
# whose symbols are defined under `if ALP_SDK`.  The shield does not default
# ALP_SDK itself -- turning the SDK on is the app's decision.

if SHIELD_E1M_EVK_RK055HDMIPI4MA0

config DISPLAY
	default y

config MIPI_DSI
	default y

config HX8394
	default y

config I2C
	default y

config GPIO
	default y

config GPIO_PCA_SERIES
	default y

config REGULATOR
	default y

config REGULATOR_FIXED
	default y

if ALP_SDK

config MIPI_DPHY
	default y

config MIPI_DPHY_DW
	default y

config MIPI_DSI_DW
	default y

config DISPLAY_CDC200
	default y

endif # ALP_SDK

endif # SHIELD_E1M_EVK_RK055HDMIPI4MA0
