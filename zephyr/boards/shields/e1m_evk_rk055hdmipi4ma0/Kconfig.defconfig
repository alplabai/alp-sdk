#
# Everything the RK055HDMIPI4MA0 display chain needs on an E1M-AEN SoM, so an
# app only adds the shield (plus CONFIG_ALP_SDK=y, which every alp-sdk app
# sets): the display class, the DSI host + D-PHY, the panel driver, and the
# carrier's I2C GPIO expander + fixed regulator that power and reset the panel.

if SHIELD_E1M_EVK_RK055HDMIPI4MA0

config DISPLAY
	default y

config MIPI_DSI
	default y

config HX8394
	default y

config I2C
	default y

config GPIO
	default y

config GPIO_PCA_SERIES
	default y

config REGULATOR
	default y

config REGULATOR_FIXED
	default y

# The hx8394 driver allocates its DSI command scratch from the system heap.
# An ADD_SIZE symbol raises the heap to at least this much without lowering a
# larger CONFIG_HEAP_MEM_POOL_SIZE an app sets itself.
config HEAP_MEM_POOL_ADD_SIZE_E1M_EVK_RK055HDMIPI4MA0
	int
	default 4096

# The Alif CDC200 / DesignWare DSI / D-PHY drivers are alp-sdk ADR 0017 Tier-2
# copies, defined under CONFIG_ALP_SDK.
if ALP_SDK

config MIPI_DPHY
	default y

config MIPI_DPHY_DW
	default y

config MIPI_DSI_DW
	default y

config DISPLAY_CDC200
	default y

endif # ALP_SDK

endif # SHIELD_E1M_EVK_RK055HDMIPI4MA0
