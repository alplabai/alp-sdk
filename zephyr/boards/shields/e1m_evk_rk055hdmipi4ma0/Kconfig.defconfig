#
# Everything the RK055HDMIPI4MA0 display chain needs on an E1M-AEN SoM, so an
# app only adds the shield: the display class, the DSI host + D-PHY, the panel
# driver, the carrier's I2C GPIO expander + fixed regulator that power and
# reset the panel, and the panel's GT911 capacitive touch controller (polling
# only -- its INT line terminates on the CC3501E, not on the Alif SoC, and no
# GPIO relay between the two is wired up today).
#
# The app must set CONFIG_ALP_SDK=y, as every alp-sdk AEN app does: the Alif
# CDC200 / DesignWare DSI / D-PHY drivers are alp-sdk ADR 0017 Tier-2 copies
# whose symbols are defined under `if ALP_SDK`.  The shield does not default
# ALP_SDK itself -- turning the SDK on is the app's decision.

if SHIELD_E1M_EVK_RK055HDMIPI4MA0

config DISPLAY
	default y

config MIPI_DSI
	default y

config HX8394
	default y

config I2C
	default y

config GPIO
	default y

config GPIO_PCA_SERIES
	default y

# INPUT_GT911 (drivers/input/Kconfig.gt911) already defaults y once its DT
# node is enabled, but that whole menu lives inside `if INPUT`
# (drivers/input/Kconfig) -- INPUT_GT911 has no visibility, and nothing
# selects it, unless the parent is on.  Because this defaults y, ANY app that
# adds this shield compiles the GT911 driver, whether or not it touches
# input.  That driver requires
# zephyr/patches/zephyr/0004-input-gt911-fall-back-to-polling-without-an-irq.patch
# to compile at all with no irq-gpios property (see that patch's comments) --
# a workspace bootstrapped `scripts/bootstrap.sh --no-patches` fails to
# compile this shield.
config INPUT
	default y

# The overlay's lcd_exp hog drives the panel RESX low, and it only works in the
# window between the two drivers that own that pin's timing:
#
#   GPIO_PCA_SERIES_INIT_PRIORITY (50, = I2C_INIT_PRIORITY)  the expander exists
#   ---> GPIO_HOGS_INIT_PRIORITY (60)                        RESX driven low
#   REGULATOR_FIXED_INIT_PRIORITY (75)                       panel supply on
#   APPLICATION_INIT_PRIORITY (90)                           hx8394 reset pulse
#
# Upstream's default of 41 is below the expander, so gpio_hogs_init() would find
# the port not ready, log an error and configure nothing.  aen-dsi-display
# BUILD_ASSERTs the window, since a Kconfig default cannot.
config GPIO_HOGS_INIT_PRIORITY
	default 60

config REGULATOR
	default y

config REGULATOR_FIXED
	default y

if ALP_SDK

config MIPI_DPHY
	default y

config MIPI_DPHY_DW
	default y

config MIPI_DSI_DW
	default y

config DISPLAY_CDC200
	default y

endif # ALP_SDK

endif # SHIELD_E1M_EVK_RK055HDMIPI4MA0
