# ADR 0017 Tier-1.5 (third-party permissive port of the Apache-2.0 Espressif
# esp-video-components esp_cam_sensor/sensors/ov9281 driver onto the
# upstream Zephyr v4.4 video API), BENCH-VERIFIED 2026-09-21 on an
# E1M-AEN803 on the E1M-EVK. Written fresh for the
# v4.4 video_driver_api / video_ctrl registry (Espressif's Kconfig.ov9281
# targets their own ESP-IDF esp_cam_sensor component model and does not
# translate); the register addresses/values/init tables in ov9281.c are the
# consumed Espressif asset.
# See zephyr/drivers/video/ov9281.c for the source commit + retirement note
# and docs/adr/0017-alp-sdk-over-the-vendor-sdk.md.
#
# Copyright (c) 2026 Alp Lab AB
# SPDX-License-Identifier: Apache-2.0

config VIDEO_OV9281
	bool "OmniVision OV9281 global-shutter mono MIPI CSI-2 sensor"
	default y
	depends on DT_HAS_OVTI_OV9281_ENABLED
	select I2C
	help
	  Enable the OmniVision OV9281 1MP global-shutter monochrome CMOS
	  MIPI CSI-2 image sensor driver (compatible "ovti,ov9281").  Ported
	  onto the Zephyr v4.4 video API from the Apache-2.0 Espressif
	  esp-video-components esp_cam_sensor/sensors/ov9281 driver, keeping
	  its register addresses/values/mode-setting tables verbatim, plus one
	  Alp-derived mode. Supports three modes, all RAW8 mono
	  (VIDEO_PIX_FMT_GREY), 2 MIPI data lanes, 24 MHz XVCLK: the two
	  Espressif ships (1280x720, 640x400) and 1280x800 (the sensor's full
	  array, Alp-derived from the 1280x720 table).
	  Driver: zephyr/drivers/video/ov9281.c.
