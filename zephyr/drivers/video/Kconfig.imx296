# ADR-0017-ADJACENT (authored from the Sony IMX296 datasheet), BENCH-UNVERIFIED.
# No permissive-licence IMX296 driver exists to consume (upstream Zephyr /
# hal_alif / Espressif esp_cam_sensor have none; Linux's is GPL-2.0). See
# zephyr/drivers/video/imx296.c for the datasheet-section citations and
# retirement note, and docs/adr/0017-alp-sdk-over-the-vendor-sdk.md.
#
# Copyright 2026 Alp Lab AB
# SPDX-License-Identifier: Apache-2.0

config VIDEO_IMX296
	bool "Sony IMX296 1.58 MP global-shutter MIPI CSI-2 sensor"
	default y
	depends on DT_HAS_SONY_IMX296_ENABLED
	select I2C
	help
	  Enable the Sony IMX296 1.58 MP global-shutter MIPI CSI-2 image
	  sensor driver (compatible "sony,imx296"), authored from the Sony
	  IMX296 datasheet. All-pixel scan mode only: 1440x1080, RAW10, 1
	  MIPI CSI-2 data lane, 37.125/54/74.25 MHz INCK. Driver:
	  zephyr/drivers/video/imx296.c.
