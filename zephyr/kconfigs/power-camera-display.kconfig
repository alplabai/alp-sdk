# SPDX-License-Identifier: Apache-2.0
#
# <alp/dsp.h> standalone DSP chain, <alp/power.h> system-power surface + its
# Zephyr pm_policy and V2N vendor-extension backends, and the portable
# camera/display backends (Zephyr video, V2N N44 ISP, Alif ISP-Pico, Zephyr
# display).

config ALP_SDK_DSP
	bool "Enable <alp/dsp.h> standalone DSP-chain API"
	default n
	help
	  Compile the DSP registry sources -- src/dsp_dispatch.c plus
	  src/backends/dsp/sw_fallback.c -- and the standalone decimator
	  (src/dsp_decimator.c), which ALP_SDK_AUDIO_IN also compiles on its
	  own for PDM resampling.  Provides the standalone
	  alp_dsp_chain_* surface for in-RAM FIR / IIR / window /
	  FFT processing against int16 mV-scale buffers.  Uses
	  CMSIS-DSP when ALP_HAS_CMSIS_DSP=1; otherwise falls back
	  to a portable-C math kernel set (naive FIR convolution,
	  direct-form-1 biquad cascade, radix-2 Cooley-Tukey FFT).

	  Slice 4d migration: the legacy OS-agnostic body that lived at
	  src/common/dsp_chain.c is now the sw_fallback backend.  There
	  is no separate zephyr_drv backend today -- the V2N GD32G5
	  HW-FFT surfaces via wave-2's alp_adc_filter_t /
	  alp_adc_spectrum_t in <alp/adc.h>, not through this
	  standalone class.  Future HW backends (V2N standalone-FFT,
	  AEN once the wave-2 bridge stabilises) pre-empt the
	  sw_fallback transparently when registered at higher priority.

	  Static cost: ~30 KB for the chain pool (two concurrent
	  chains sized to ALP_DSP_MAX_FIR_TAPS / IIR_SECTIONS /
	  FFT_POINTS).  Pulls in math.h transcendentals (sinf, cosf,
	  sqrtf, lrintf).  Off by default to keep tight firmware
	  images lean.

config ALP_SDK_POWER
	bool "Enable <alp/power.h> system-power-mode surface"
	default y
	help
	  Compile src/power_dispatch.c, the class dispatcher behind the
	  portable alp_power_open / configure_wake_source / request_sleep /
	  close surface (and the sibling alp_power_profile_get / _set
	  surface).  Real backends register over this dispatcher by
	  silicon_ref + priority -- see ALP_SDK_POWER_PM_POLICY (Zephyr
	  pm_policy_* sleep-mode backend, "*" wildcard, priority 100),
	  ALP_SDK_POWER_EXT_RENESAS (V2N GD32G553 supervisor
	  CMD_POWER_MODE_SET vendor extension) and
	  ALP_SDK_POWER_PROFILE_ALIF_SE (Alif SE aiPM operating-point
	  profile, separate "power_profile" class) for what each one
	  actually implements.

	  src/backends/power/zephyr_stub.c is the always-present,
	  priority-0 "*" wildcard fallback: open() returns a valid
	  handle so application setup code keeps linking/running
	  unchanged, but this backend can arm zero real wake sources
	  (alp_power_wake_capabilities() reports 0), so the dispatcher's
	  configure_wake_source() rejects any non-empty bitmap with
	  ALP_ERR_NOSUPPORT at configuration time rather than only at
	  the eventual sleep call (issue #1812); request_sleep() (and
	  both power_profile ops, when no higher-priority profile
	  backend is linked) return ALP_ERR_NOSUPPORT too.  The
	  dispatcher still enforces the INVAL pre-checks (RUN-mode,
	  invalid enum, no-wake-source-and-no-timer) ahead of the
	  backend call.

config ALP_SDK_CAMERA_ZEPHYR_VIDEO
	bool "Compile the real Zephyr drivers/video/ camera backend"
	depends on VIDEO
	default y
	help
	  Compile src/backends/camera/zephyr_video.c, the portable
	  camera backend that wraps Zephyr's drivers/video/ class
	  (video_get_caps + video_set_format + video_buffer_aligned_alloc +
	  video_enqueue / video_dequeue + video_stream_start / _stop)
	  into the alp_camera_* vtable.  Registered at silicon_ref="*"
	  priority 50 so it always wins over the zephyr_stub fallback
	  (priority 0) on builds that link Zephyr's video subsystem;
	  loses to vendor-specific real backends (V2N N44 ISP at
	  priority 100 on its silicon_ref) where present.

	  configure_isp returns ALP_ERR_NOSUPPORT -- the portable
	  Zephyr video class has no in-line ISP surface; vendor
	  backends ride on top to add the configure_isp op.

	  Depends on CONFIG_VIDEO so the video_* symbols are visible
	  at link time.

config ALP_SDK_CAMERA_V2N_N44_ISP
	bool "Compile the Renesas RZ/V2N N44 ISP-aware camera backend"
	depends on VIDEO
	default y if ALP_SOC_RENESAS_RZV2N_N44
	help
	  Compile src/backends/camera/v2n_n44_isp.c, the V2N N44
	  ISP-aware camera backend.  Registered at
	  silicon_ref="renesas:rzv2n:n44" priority 100 -- always
	  wins selection over the wildcard zephyr_video + zephyr_stub
	  on V2N silicon.

	  Sensor pipeline (open / start / stop / capture / release /
	  close) routes through the same Zephyr drivers/video/ API
	  the portable zephyr_video backend uses; configure_isp
	  validates the requested config and returns
	  ALP_ERR_NOSUPPORT -- no ISP register is written (the CM33
	  FSP has no CRU/CSI-2/ISP module and the A55 owns them;
	  RZ/V2N Hardware User's Manual R01UH1071EJ0120 section 9.8).

	  Off on non-V2N builds; the zephyr_video backend remains
	  the default on every other supported SoC.

config ALP_SDK_CAMERA_ZEPHYR_VIDEO_VBUF_COUNT
	int "Frame buffers the zephyr_video camera backend allocates per open"
	depends on VIDEO
	default 2
	range 1 8
	help
	  Number of video_buffer_aligned_alloc() frame buffers
	  src/backends/camera/zephyr_video.c queues at alp_camera_open().
	  If the capture driver's min_vbuf_count is larger, the open fails
	  with ALP_ERR_OUT_OF_RANGE -- the count is not raised for you.
	  Each buffer is pitch x height bytes, rounded up to
	  CONFIG_VIDEO_BUFFER_POOL_ALIGN, and comes from the Zephyr video
	  buffer pool, so keep VBUF_COUNT x ALIGN-padded frame size <=
	  CONFIG_VIDEO_BUFFER_POOL_HEAP_SIZE.
	  Drop to 1 for full-frame sensors whose single frame already
	  fills most of the pool (e.g. the OV9281's 1280x800 GREY8 frame
	  is 1,024,000 bytes).

config ALP_SDK_CAMERA_ALIF_ISP
	bool "Compile the Alif Ensemble ISP-Pico camera backend (OPT-IN)"
	depends on VIDEO
	depends on VIDEO_ISP_VSI
	default n
	help
	  Compile src/backends/camera/alif_isp_pico.c, the Alif Ensemble
	  ISP-Pico-aware camera backend.  Registered at
	  silicon_ref="alif:ensemble:e8" priority 100 -- wins selection
	  over the wildcard zephyr_video + zephyr_stub on E8 silicon when
	  enabled.  Mirrors the V2N N44 ISP backend (sensor pipeline routes
	  through the portable Zephyr v4.4 video API; configure_isp latches
	  the requested config).

	  OPT-IN, default n -- it depends on CONFIG_VIDEO_ISP_VSI, which
	  links the hal_alif libisp Vivante blob.  COMPILES + LINKS + RUNS
	  clean against the pinned hal_alif v2.3.0 wrapper on real silicon
	  (examples/aen/aen-isp-capture) -- the former hal_alif
	  version mismatch is resolved.

config ALP_SDK_CAMERA_ALIF_ISP_VBUF_COUNT
	int "Raw ISP frame buffers the Alif ISP-Pico camera backend queues per open"
	depends on ALP_SDK_CAMERA_ALIF_ISP
	default 3
	range 2 8
	help
	  Number of struct video_buffer slots src/backends/camera/
	  alif_isp_pico.c queues to the ISP MI at alp_camera_open() (was a
	  fixed #define 3 -- see the AE-convergence fix in that file's
	  header for why 3 is the default: with only 2, the buffer an app
	  holds between alp_camera_capture() and alp_camera_release() (or
	  the one this backend holds during an internal RGB565 conversion)
	  leaves just ONE buffer queued to the MI while it is held -- safe
	  only as long as that hold time (an NV12-passthrough app's JPEG
	  encode, plus at most one lower-quality retry -- ~2 ms typical on
	  the Hantro backend, see examples/connectivity/camera-mjpeg-
	  stream's bench run 243) stays MUCH SHORTER than the frame period,
	  so the MI's other queued buffer is refilled and re-queued well
	  before the next capture is due; a hold time that creeps toward
	  the frame period starves the MI and auto-stops the stream.  Each
	  buffer is width x height x 1.5 bytes (NV12/YUV420) or x2
	  (RGB565) from the Zephyr
	  video buffer pool (CONFIG_VIDEO_BUFFER_POOL_HEAP_SIZE) -- at a
	  large enough frame size (e.g. 1280x960 NV12, 1,843,200 B/buffer)
	  3 buffers no longer fit the 4 MiB AEN SRAM0 bank alongside the
	  JPEG output buffers, so a board/app config that (a) never holds a
	  raw buffer for a slow CPU conversion (NV12/YUV420 passthrough,
	  not the RGB565 path) and (b) budgets the pool accordingly may
	  drop this to 2.  Below 2 the MI has nothing queued at all the
	  instant one buffer is held -- range enforces that floor.

config ALP_SDK_DISPLAY_ZEPHYR_DRV
	bool "Compile the real Zephyr display driver-class backend"
	depends on DISPLAY
	default y
	help
	  Compile src/backends/display/zephyr_drv.c, the portable
	  display backend that wraps Zephyr's drivers/display.h class
	  (display_write + display_clear + display_blanking_on /
	  _off + display_get_capabilities + display_set_pixel_format)
	  into the alp_display_* vtable.  Any panel with an upstream
	  Zephyr display driver (SSD1306, SSD1331, ILI9341, ST7789V,
	  dummy-dc, ...) resolves via the alp-display0..3 devicetree
	  aliases.  Registered at silicon_ref="*" priority 50 so it
	  always wins over the zephyr_stub fallback (priority 0) on
	  builds that link Zephyr's display subsystem; loses to future
	  vendor-specific real backends (V2N DSI / parallel-RGB, Alif
	  LCD-IF) at priority 100 on their silicon.

	  Boards without an alp-displayN alias degrade cleanly:
	  alp_display_open returns NULL with ALP_ERR_NOT_READY.

	  Do not point an alp-displayN alias at the panel LVGL owns
	  (the zephyr,display chosen node) when CONFIG_LVGL=y -- two
	  writers on one panel conflict.  See the zephyr_drv.c header.

	  Depends on CONFIG_DISPLAY so the display_* symbols are
	  visible at link time.

config ALP_SDK_POWER_PM_POLICY
	bool "Compile the real Zephyr pm_policy_* power backend"
	depends on ALP_SDK_POWER
	depends on PM
	default y
	help
	  Compile src/backends/power/zephyr_pm_policy.c, which uses
	  Zephyr's pm_policy_state_lock_get / pm_policy_state_lock_put
	  to translate alp_power_request_sleep into a constraint over
	  the active per-SoC pm_state table.  Registered as
	  silicon_ref="*" at priority 100 so it always wins over the
	  zephyr_stub fallback (priority 0) on builds that link the PM
	  subsystem.

	  Off on builds without CONFIG_PM (where the pm_policy_* symbols
	  vanish); the zephyr_stub at priority 0 keeps alp_power_open
	  succeeding so application setup code keeps linking unchanged.

config ALP_SDK_SOM_POWER
	bool "SoM power-domain runtime (quiesce / restore around STOP)"
	depends on ALP_SDK_POWER && GPIO && PINCTRL
	default y if DT_HAS_ALP_SOM_POWER_DOMAIN_ENABLED
	select CRC
	help
	  Compile src/backends/power/som_power.c: the registry of on-module
	  power domains (Wi-Fi/BLE coprocessor, Ethernet PHY, external flash
	  and RAM, temperature sensor, RTC clock-out, backlight) built from the
	  generated `alp,som-power-domain` devicetree nodes, the per-domain
	  policy, the quiesce / restore pair the Alif STOP backend calls, and
	  the early SYS_INIT that restores the domains after a STOP wake.

	  Answers alp_power_domain_policy_set(), alp_power_domain_info() and
	  alp_power_boot_wake_info() through the power-class vtable.  On a plain
	  power-on reset the wake path finds no valid record and touches
	  nothing.  Without this option those three calls return
	  ALP_ERR_NOSUPPORT.  The node's pinctrl-0 state muxes every pad the
	  layer drives, so it also needs CONFIG_GPIO and CONFIG_PINCTRL.

config ALP_SDK_SOM_PD_WIFI_RAIL_OFF
	bool "Allow gating the CC3501E supply (RAIL_OFF policy) around STOP"
	depends on ALP_SDK_SOM_POWER
	help
	  Lets alp_power_domain_policy_set(ALP_POWER_DOMAIN_WIFI_BLE,
	  ALP_POWER_DOMAIN_POLICY_RAIL_OFF) succeed: the quiesce then also pulls
	  WIFI_EN low (after nRESET) and the restore raises it again.  Default
	  off, and it should stay off on activated modules.

	  HAZARD: on a unit with vendor_sbl_container_enable=1 a WIFI_EN cold
	  cycle may never relaunch the CC3501E firmware.  The default Wi-Fi
	  action (hold nRESET low, release it on wake) never touches the supply
	  and has no such risk.  Without this option RAIL_OFF is refused with
	  ALP_ERR_NOSUPPORT.

config ALP_SDK_SOM_PD_WIFI_SETTLE_MS
	int "CC3501E boot settle after nRESET release on a runtime restore (ms)"
	depends on ALP_SDK_SOM_POWER
	default 3500
	help
	  Blind wait, with no SPI clocking, after the default nRESET-release
	  restore of the Wi-Fi/BLE domain.  3500 ms is cc3501e_hard_reset()'s
	  boot settle (Puya double-boot plus crypto init).  The cold-boot wake
	  path never waits; it leaves the settle to the bring-up code.

config ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	bool "Bench-only retention counter in the BKRAM region"
	depends on ALP_SDK_SOM_POWER
	help
	  Adds a small counter cell next to the wake record in the 4 KB Utility
	  SRAM, so a bench image can prove BKRAM survives STOP without owning any
	  of it.  BKRAM is reserved for the SDK; this exists for the bench example
	  only and must stay off in a product build.

config ALP_SDK_POWER_ALIF_SE
	bool "Alif SE STOP / STANDBY power backend (E8 M55-HE / M55-HP, EXPERIMENTAL)"
	depends on ALP_SDK_POWER && ALP_SDK_SOM_POWER
	depends on HAS_ALIF_SE_SERVICES
	depends on SOC_AE822FA0E5597LS0_RTSS_HE || SOC_AE822FA0E5597LS0_RTSS_HP
	default n
	help
	  Compile src/backends/power/alif_se_power.c: alp_power_request_sleep()
	  for STOP and STANDBY on the Alif Ensemble E8 M55-HE.  It builds a
	  complete OFF profile for the Secure Enclave, quiesces the on-module
	  domains, arms the wake source (the on-module RV-3028 on INT -> P15_0,
	  or the LPTIMER for short intervals) and enters the EWIC subsystem-off
	  sleep.  The wake is a COLD BOOT through the Secure Enclave; the call
	  does not return, and the cause is read with alp_power_boot_wake_info().

	  STOP is bench-proven on the E1M-AEN803 M55-HE (U8h: LPTIMER, RV-3028
	  countdown and alarm wakes); STANDBY is not.  The M55-HP is BUILT but NOT
	  bench-verified: it has STOP only (the vendor's SOFT_OFF-class sleep; STANDBY
	  is refused with ALP_ERR_NOSUPPORT), no TCM retention (ALP_ERR_NOSUPPORT) and
	  needs an MRAM-booted image (VTOR >= 0x80000000, else ALP_ERR_NOSUPPORT).
	  Off by default.  An image that gets the entry
	  sequence wrong can stop at the Secure Enclave until the module is
	  power-cycled; keep a way to restore the MRAM image before trying it.

	  SLEEP and DEEP_SLEEP are forwarded to the pm_policy backend when that is
	  built.  Needs CONFIG_DCACHE=n (the cache-clean loop hangs on this
	  silicon); with the D-cache on, STOP is refused with ALP_ERR_NOSUPPORT.

config ALP_SDK_POWER_ALIF_SE_RESTORE_CLOCKS
	bool "Re-apply the RUN profile at boot when the clock tree is not the running one"
	depends on ALP_SDK_POWER_ALIF_SE
	default y if BOARD_ALP_E1M_AEN803_M55_HE
	help
	  Default on for the E1M-AEN803 board only: that is the SoM it was measured on.  The
	  E1M-AEN801 is unmeasured; set it to y there after a bench pass (without it a wake comes
	  up with the SE-left RC clocks).

	  A wake from STOP is a cold boot into whatever clock tree the Secure Enclave left:
	  all-RC, i.e. UART5 at ~1/5 of its baud (23040 instead of 115200) and the kernel tick
	  at half rate (bench U8c / U8d / U8g).  At PRE_KERNEL_1 (priority 46, after the SE
	  service, before every peripheral) the backend checks the hardware state -- PLL not
	  locked, or the PLL clock select not the running tree -- and, only then, calls
	  se_service_set_run_cfg() with a complete explicit RUN profile (the vendor system_off
	  sample does the same).  The profile uses the vendor power domains, names the Utility
	  SRAM (gen2 BACKUP4K) in memory_blocks and re-asserts the BKRAM retention enables; the
	  SDK's BKRAM data sits in a RAM shadow until the block passes a write/readback, and a
	  sleep refuses (bkram_unusable) if it does not (bench U8e).
	  Bench evidence (U8h, E1M-AEN803 on an E1M-EVK, three STOP cycles): on every wake boot
	  the restore ran, BOOT diag w40 = 1 (locked and selected), the UART came up at 115200
	  and BKRAM was live.  Measured on the AEN803 only; another SoM or silicon revision
	  needs its own bench pass.
	  TODO(#2784): evaluate hal_alif's CONFIG_ALIF_SE_DTS_RUN_PROFILE (the aipm-run
	  devicetree node) instead of this hand-rolled profile.

config ALP_SDK_POWER_ALIF_SE_ALLOW_DEBUGGER
	bool "Allow STOP / STANDBY with a debugger attached (bench only)"
	depends on ALP_SDK_POWER_ALIF_SE
	help
	  By default STOP / STANDBY is refused with ALP_ERR_BUSY while
	  DHCSR.C_DEBUGEN is set: a connected debug port keeps PDDEBUG powered, so
	  the subsystem never powers down and the sleep proves nothing (or hangs
	  the probe).  Enable this for a bench run that sleeps under J-Link.

config ALP_SDK_POWER_ALIF_SE_BENCH_LPTIMER_MAX_MS
	int "Bench only: longest wake_after_ms served by the LPTIMER (ms)"
	depends on ALP_SDK_POWER_ALIF_SE && ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	range 1000 60000
	default 1000
	help
	  Longer intervals use the RV-3028 countdown.  Bench variant (iii) raises this so a
	  5000 ms wake can be served by the LPTIMER and the interval compared.

config ALP_SDK_POWER_ALIF_SE_BENCH_FORCE_LFXO
	bool "Bench only: select LFXO as the OFF profile's AON clock even when not confirmed"
	depends on ALP_SDK_POWER_ALIF_SE && ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	help
	  Variant (iv) of the STOP bench: aon_clk_src = LFXO (with XTAL32K_CAP_CONT 63), the
	  vendor sample's choice, instead of the LFRC the SES boot leaves selected.  Changes
	  one thing against the default.  Never for a product build.

config ALP_SDK_POWER_ALIF_SE_BENCH_NO_VTOR_SELF
	bool "Bench only: OFF profile keeps the live vtor_address (ablation)"
	depends on ALP_SDK_POWER_ALIF_SE && ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	help
	  The product default writes vtor_address = SCB->VTOR (the vendor system_off sample's
	  resume vector).  Bench U8h: STOP wakes 3 of 3 without it, so it is optional; it stays the
	  default because the vendor sample does it.  This turns that one field off to ablate it.
	  Default of the runtime knob alp_som_bench_knobs.vtor_self.  Never for a product build.

config ALP_SDK_POWER_ALIF_SE_BENCH_NO_MRAM_SERAM
	bool "Bench only: OFF profile memory_blocks without MRAM and SERAM (ablation)"
	depends on ALP_SDK_POWER_ALIF_SE && ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	help
	  The product default keeps MRAM | SERAM | BKRAM (plus any TCM bank) powered in STOP, the
	  vendor MRAM-boot profile.  Bench U8h: with MRAM | SERAM off the SE reboots through the
	  cold path instead of resuming (empty OFF profile on read-back, RET_CTRL 0x0002aaf0), so
	  they are REQUIRED; this exists only to reproduce that.  A product build can not select it
	  (and the backend refuses to send a profile without them).

config ALP_SDK_POWER_ALIF_SE_BENCH_STBY_76_8
	bool "Bench only: OFF profile stby_clk_freq = 76.8 MHz for STOP too"
	depends on ALP_SDK_POWER_ALIF_SE && ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	help
	  STOP normally carries SCALED_FREQ_RC_STDBY_0_075_MHZ; the vendor system_off sample
	  uses 76.8 MHz.  Default of a runtime knob (alp_som_bench_knobs.stby_76_8).  Never for
	  a product build.

config ALP_SDK_POWER_ALIF_SE_BENCH_FORCE_RESTORE
	bool "Bench only: run the boot-time clock restore even when the clocks are healthy"
	depends on ALP_SDK_POWER_ALIF_SE_RESTORE_CLOCKS && ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	help
	  Reproduces the restore's own side effects on a cold boot that never slept (bench
	  U8e: set_run_cfg disturbed the Utility SRAM).  Never for a product build.

config ALP_SDK_POWER_ALIF_SE_BENCH_RESTORE_LEGACY
	bool "Bench only: restore with the old RUN profile (0x16d, no BACKUP4K, no re-assert)"
	depends on ALP_SDK_POWER_ALIF_SE_RESTORE_CLOCKS && ALP_SDK_SOM_POWER_BKRAM_BENCH_SCRATCH
	help
	  The profile of c6de654ff, kept to reproduce the BKRAM loss of bench U8e.  The
	  default restore uses the vendor power domains (PD_SYST | PD_SSE700_AON), names the
	  Utility SRAM (gen2 BACKUP4K) in memory_blocks and re-asserts RET_CTRL bit 0 and
	  VBAT_ANA_REG1 bit 8 afterwards.  Never for a product build.

config ALP_SDK_POWER_EXT_RENESAS
	bool "Compile the Renesas V2N power vendor-extension body"
	depends on ALP_SDK_POWER
	depends on ALP_SDK_V2N_SUPERVISOR
	default y if ALP_SOC_RENESAS_RZV2N_N44
	help
	  Compile src/backends/ext/renesas/power.c, which implements
	  the alp_renesas_power_supervisor_mode_set vendor-extension
	  surface declared in <alp/ext/renesas/power.h>.  Routes through
	  the GD32G553 supervisor's CMD_POWER_MODE_SET opcode (0x28) via
	  the existing v2n_supervisor singleton mutex; no new bus plumbing
	  introduced.

	  Off on non-V2N builds; the header alone (always installed) is
	  enough for portable apps to compile-test against the symbol.
