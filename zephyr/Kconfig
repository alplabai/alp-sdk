rsource "kconfigs/vendor-alif-peripherals.kconfig"
rsource "kconfigs/video-sensors.kconfig"
rsource "kconfigs/peripherals-handles.kconfig"
rsource "kconfigs/v2n-supervisor.kconfig"
rsource "kconfigs/peripherals-wrappers.kconfig"
rsource "kconfigs/power-camera-display.kconfig"
