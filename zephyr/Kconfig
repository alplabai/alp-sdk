# Alp SDK Kconfig fragment exposed to Zephyr applications.

config ALIF_I2C_HANDOVER
	bool "Alif Ensemble I2C controller handover between cores"
	default y
	depends on DT_HAS_ALP_I2C_HANDOVER_ENABLED
	help
	  Build zephyr/soc-bridge/alif/i2c_handover.c for the alp,i2c-handover
	  node in the devicetree: the core that configures a peripheral over a
	  shared I2C controller at boot releases it, the core that owns the bus
	  afterwards waits for that before it touches it.

config ALP_SDK
	bool "Alp SDK"
	help
	  Enable the Alp SDK on Zephyr.  When set, the SDK's Zephyr
	  backend is compiled and <alp/...> headers are added to the
	  application include path.

if ALP_SDK

# Subsystem fragments (issue #458): each covers one surface/vendor
# grouping and is sourced in the same order the monolith previously
# declared them in, so config ordering, choice/if/menu scoping, and every
# symbol's defaults/deps/help stay byte-for-byte equivalent.
rsource "kconfigs/core.kconfig"
