diff --git a/drivers/isp/isp_wrapper/src/isp_api_wrapper.c b/drivers/isp/isp_wrapper/src/isp_api_wrapper.c
index 8ce0290..7e2ae21 100644
--- a/drivers/isp/isp_wrapper/src/isp_api_wrapper.c
+++ b/drivers/isp/isp_wrapper/src/isp_api_wrapper.c
@@ -186,6 +186,7 @@ static inline int isp_mode_from_fourcc(uint32_t fourcc)
 	case VIDEO_PIX_FMT_GRBG12:
 	case VIDEO_PIX_FMT_RGGB12:
 	case VIDEO_PIX_FMT_Y10P:
+	case VIDEO_PIX_FMT_SBGGR10P:
 		return ISP_MODE_RAW;
 	case VIDEO_PIX_FMT_GREY:
 	case VIDEO_PIX_FMT_Y10:
@@ -207,6 +208,19 @@ static inline int isp_pixelfmt_from_fourcc(uint32_t fourcc)
 	case VIDEO_PIX_FMT_RGGB8:
 		return PIXEL_FORMAT_RGGB8;
 	case VIDEO_PIX_FMT_BGGR10:
+	/*
+	 * VIDEO_PIX_FMT_SBGGR10P (packed) added alongside the pre-existing
+	 * VIDEO_PIX_FMT_BGGR10 (== VIDEO_PIX_FMT_SBGGR10, unpacked) case
+	 * above: a BGGR sensor that only advertises the PACKED fourcc on its
+	 * CSI/parallel wire (VIDEO_PIX_FMT_SBGGR10P, not VIDEO_PIX_FMT_
+	 * BGGR10) previously had no case here at all and fell through to the
+	 * default. Maps to the SAME PIXEL_FORMAT_BGGR10 the existing unpacked
+	 * case already uses -- the packed/unpacked distinction only affects
+	 * memory layout, not Bayer phase. VIDEO_PIX_FMT_Y10P (below) is kept
+	 * mapped to PIXEL_FORMAT_GRBG10 unchanged, for sensors that already
+	 * relied on that mapping.
+	 */
+	case VIDEO_PIX_FMT_SBGGR10P:
 		return PIXEL_FORMAT_BGGR10;
 	case VIDEO_PIX_FMT_GBRG10:
 		return PIXEL_FORMAT_GBRG10;
