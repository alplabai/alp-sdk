+ * table's own .fps/.fullLines/.maxIntLine are this GLOBAL's compile-time
+ * initial values only (#2277) -- isp_vsi_sync_ae_sns_default()
+ * (isp_api_wrapper.c) DOES re-sync fullLinesStd/fullLines/maxIntLine on
+ * this same global at runtime, to the sensor's ACTIVE frame period, on
+ * every isp_apply_ae() call; see that function's own comment and
+ * ov5647_ae_envelope.h's file comment for the full mechanism (the
+ * write-back clamp this sync feeds, not this struct's init values alone,
+ * is what bench run 251 confirmed actually holds the sensor within the
+ * active-mode ceiling).
+ */
+#include "ov5647_ae_envelope.h"
+
 #ifdef __cplusplus
 }
