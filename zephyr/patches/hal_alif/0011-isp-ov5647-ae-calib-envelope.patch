+/*
+ * alp-sdk fix (Alp Lab AB, #2271): OV5647's real AE envelope, shared between
+ * sensor_attributes.h's AE_SNS_DEFAULT_S table (patch 0006) and
+ * isp_param_conf.h's OV5647 .ae calibration block (patch 0011) -- SetCalib()
+ * (isp_vsi_init(), isp_api_wrapper.c) loads isp_param_conf.h's compiled-in
+ * calibration into the ISP library BEFORE isp_apply_ae() (isp_pico.c) ever
+ * runs; runs 211/212's out-of-range writeback decoded exactly against the
+ * stale ARX3A0-derived calibration block, and with this envelope applied
+ * (bench run 213) AE held within the sensor's real envelope (int_time_max
+ * =98000, again_max=65472) with 0 rejected writes -- the exact mechanism by
+ * which the calibration block wins over isp_apply_ae()'s own push is not
+ * established against the closed VSI_MPI_ISP library.
+ *
+ * This header holds ONLY these shared macros, not sensor_attributes.h's
+ * AE_SNS_DEFAULT_S struct (patch 0006's table stays hand-written literals --
+ * see that file's own comment for why): isp_param_conf.h doesn't otherwise
+ * need that struct, and folding the whole struct into isp_param_conf.h's
+ * include chain (by including sensor_attributes.h directly) would land
+ * it in isp_api_wrapper.c's translation
+ * unit even when CONFIG_ISP_LIB_AE_MODULE is off -- that config guards the
+ * struct's only use site (vsi_get_ae_default()'s memcpy), so with the
+ * config off the struct was defined but never referenced, tripping
+ * -Werror=unused-variable. Splitting the macros out here means
+ * isp_param_conf.h only pulls in what its .ae block actually reads.
+ *
+ * #2277 (a rejected first cut): a first cut made OV5647_AE_MAX_INT_
+ * LINE a compile-time function of a Kconfig-selected fps
+ * (CONFIG_VIDEO_ISP_VSI_CALIB_OV5647_FPS). That could only ever match ONE
+ * app's fps choice -- with the Kconfig defaulting to 30 (matching <alp/
+ * camera.h>'s ALP_CAMERA_CONFIG_DEFAULT) every app that actually runs at
+ * OV5647's 10 fps floor (this backend's own fallback,
+ * src/backends/camera/alif_isp_pico.c, and both examples/aen/aen-isp-
+ * ov5647-* apps, all of which pin cfg.fps = 10 for AE/CPU headroom, not 30)
+ * lost roughly two thirds of its real 10 fps exposure headroom to a
+ * compile-time ceiling sized for a rate the app never requested. A
+ * compile-time constant fundamentally cannot serve every app's fps choice.
+ *
+ * #2277 (real fix): OV5647_AE_FPS/OV5647_AE_FULL_LINES/OV5647_AE_MAX_INT_
+ * LINE below are now the CONSERVATIVE BOOT-TIME DEFAULT only -- the value
+ * VSI_MPI_ISP_SetCalib() (isp_vsi_init(), isp_api_wrapper.c) loads before
+ * any app has opened the camera and negotiated a real fps. Fixed at the
+ * sensor's 10 fps floor (its slowest supported rate, the most exposure
+ * headroom of any mode) rather than any particular app's rate, so this
+ * default is never WORSE than what any app that actually runs at 10 fps
+ * needs, only possibly stale for one that doesn't. From the first
+ * isp_apply_ae() call onward (isp_pico.c, on every stream (re)start),
+ * isp_vsi_set_param() (isp_api_wrapper.c) mirrors that call's own video_
+ * get_frmival()-derived, sensor-agnostic exposure-time range into isp_calib_
+ * param.modules.ae.autoAttr directly -- the SAME struct SetCalib() was built
+ * from -- so the compiled-in default here only governs the brief window
+ * before the first stream start, and isp_calib_param stays correct for
+ * whatever fps the app is ACTUALLY running even if a later restart/re-init
+ * reloads it from isp_calib_param again. See isp_api_wrapper.c's
+ * isp_vsi_set_param() for that mirror.
+ */
+#define OV5647_AE_PIXEL_RATE_HZ 58333333u /* ov5647.c's OV5647_PIXEL_RATE() at 25 MHz XVCLK */
+#define OV5647_AE_HTS_640X480   1852u     /* ov5647.c's OV5647_HTS_640X480_BINNED (0x073c) */
+#define OV5647_AE_FULL_LINES    3149  /* VTS at 10 fps -- see sensor_attributes.h's derivation */
+#define OV5647_AE_FPS           10    /* boot-time default only, see file comment above */
+#define OV5647_AE_MAX_INT_LINE  3145  /* VTS - 4 */
+#define OV5647_AE_MIN_AGAIN     1024  /* 1x floor, library units (1x = 1024) */
+#define OV5647_AE_MAX_AGAIN     65472 /* 1023 (OV5647 AGC_GAIN max) * 1024 / 16 */
+#define OV5647_AE_MIN_DGAIN     1024  /* unity -- all headroom flows through again */
+#define OV5647_AE_MAX_DGAIN     1024  /* (see sensor_attributes.h's bench-run-83 note) */
+
+_Static_assert(OV5647_AE_FULL_LINES == 3149, "drifted from sensor_attributes.fullLines");
+_Static_assert(OV5647_AE_MAX_INT_LINE == 3145, "drifted from sensor_attributes.maxIntLine");
+_Static_assert(OV5647_AE_MAX_AGAIN == 65472, "drifted from sensor_attributes.maxAgain");
+_Static_assert(OV5647_AE_MIN_AGAIN == 1024, "drifted from sensor_attributes.minAgain");
+_Static_assert(OV5647_AE_MAX_DGAIN == 1024, "drifted from sensor_attributes.maxDgain");
+_Static_assert(OV5647_AE_MIN_DGAIN == 1024, "drifted from sensor_attributes.minDgain");
+
+/*
+ * Exposure ceiling in MICROSECONDS -- isp_param_conf.h's calib block wants
+ * its ceiling in ISP_AE_RANGE_S.expTimeRange (microseconds), OV5647_AE_MAX_
+ * INT_LINE above is in lines; both must describe the SAME 10 fps ceiling, so
+ * this converts lines -> microseconds via the sensor's own lines-per-second
+ * rate (fullLines lines every 1/fps seconds) -- the inverse of
+ * vsi_get_ae_default()'s own linesPer500ms conversion (isp_api_wrapper.c)
+ * that turns a microsecond exposure request back into lines. Confirmed
+ * against the bench-matched 10 fps figures: (3145 * 1000000) / (3149 * 10)
+ * = 99872, i.e. ~100 ms minus the same margin OV5647_AE_MAX_INT_LINE's own
+ * "VTS - 4" leaves.
+ */
+#define OV5647_AE_EXP_TIME_MAX_US                                                                \
+	((vsi_u32_t)((vsi_u64_t)OV5647_AE_MAX_INT_LINE * 1000000 /                               \
+		      ((vsi_u64_t)OV5647_AE_FULL_LINES * OV5647_AE_FPS)))
+
+_Static_assert((vsi_u64_t)OV5647_AE_MAX_INT_LINE * 16 <= 0xFFFFF,
