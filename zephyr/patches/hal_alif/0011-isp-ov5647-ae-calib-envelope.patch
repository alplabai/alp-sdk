+ * 0006) stay hand-written literals -- a patch that edited them to
+ * reference these macros directly would no longer reverse-apply
+ * independently of 0011, so the two restate the SAME values as separate
+ * literals; keeping them in sync across patches 0006 and 0011 is a
+ * by-hand invariant, not a build-checked one (the macros' own
+ * _Static_assert band only catches the macros drifting from THESE
+ * literals, not this struct silently drifting from either).
+ */
+#include "ov5647_ae_envelope.h"
+
 #ifdef __cplusplus
 }
 #endif
