@@ -374,9 +374,32 @@ static int vsi_get_ae_default(ISP_PORT IspPort, AE_SNS_DEFAULT_S *pAeSnsDft)
 	return 0;
 }
 
+/*
+ * #2277: the closed VSI_MPI_ISP library invokes this callback directly, at whatever cadence its
+ * own AE loop runs, with the per-frame intLine (LINES, not microseconds) it wants to push toward
+ * the sensor -- sns_config.intLine below, *16'd at its VIDEO_CID_EXPOSURE write-back site
+ * (further down this file). Bench run 251 (E1M-AEN803, OV5647, 30 fps): the library's own
+ * request stays pinned at the compiled-in 10 fps boot default (3145) for the whole session --
+ * isp_vsi_sync_ae_sns_default() (below) keeps sensor_attributes.maxIntLine current for the
+ * ACTIVE frame period, but the library never re-pulls it into its own AE state regardless of
+ * how that sync is driven. This clamp is therefore not a defensive backstop but THE enforcement
+ * point: *pIntLine is whatever the closed AE algorithm computed, unclamped -- cap it here, the
+ * LAST touchpoint before sns_config.intLine feeds the sensor write-back, to
+ * sensor_attributes.maxIntLine, so the sensor is held within the active-mode ceiling (VTS - 4)
+ * regardless of what the library's own internal request is. maxIntLine == 0 (no sync has run
+ * yet, e.g. before the first isp_apply_ae() call) skips the clamp rather than pinning every
+ * intLine to 0.
+ */
 static int vsi_int_time_update(ISP_PORT IspPort, vsi_u32_t *pIntLine)
 {
-	sns_config.intLine = *pIntLine;
+	vsi_u32_t clamped = *pIntLine;
+
+	if (sensor_attributes.maxIntLine != 0 && clamped > sensor_attributes.maxIntLine) {
+		clamped = sensor_attributes.maxIntLine;
+	}
+
+	*pIntLine          = clamped;
+	sns_config.intLine = clamped;
 
 	return 0;
 }
@@ -396,6 +419,45 @@ static AE_SNS_FUNC_S aeSnsFunc = {
 };
 #endif /* defined(CONFIG_ISP_LIB_AE_MODULE) */
 
+/*
+ * #2277: keeps sensor_attributes.maxIntLine -- the ceiling vsi_int_time_update() (above) clamps
+ * every per-frame intLine against, the actual enforcement point -- current for the sensor's
+ * ACTIVE frame period instead of the compiled-in 10 fps boot default. Caller derives
+ * full_lines/max_int_line from the sensor's ACTIVE frame period (isp_pico.c's
+ * isp_ae_sns_full_lines_from_frmival(), the OV5647-specific VTS math, same facts as
+ * ov5647_ae_envelope.h's OV5647_AE_PIXEL_RATE_HZ/OV5647_AE_HTS_640X480 -- kept there rather than
+ * duplicated here).
+ *
+ * Bench run 251 (E1M-AEN803, OV5647, 30 fps, dim scene): confirmed the closed library's own
+ * internal AE request stays pinned at the compiled-in boot default (3145) regardless of this
+ * sync -- an earlier cut of this function also re-registered aeSnsFunc with the library
+ * (VSI_MPI_ISP_InitAeSnsFunc()) and, when that alone didn't move the pin, cycled
+ * VSI_MPI_ISP_AeUnRegCallBack()/AeRegCallBack() to force the AE algorithm's own init path to
+ * re-run. Bench run 251 shows neither changes the library's internal request either -- the
+ * write-back clamp in vsi_int_time_update() is what actually holds the sensor within the
+ * active-mode ceiling, independent of whether the library's own AE state is ever synced. Removed
+ * as dead weight rather than kept as inert defense in depth: it added two extra vendor API calls
+ * and a static "last synced" guard for no observed effect.
+ */
+int isp_vsi_sync_ae_sns_default(vsi_u32_t full_lines, vsi_u32_t max_int_line)
+{
+#if defined(CONFIG_ISP_LIB_AE_MODULE)
+	if (full_lines == 0 || max_int_line == 0 || max_int_line >= full_lines) {
+		return -EINVAL;
+	}
+
+	sensor_attributes.fullLinesStd = full_lines;
+	sensor_attributes.fullLines    = full_lines;
+	sensor_attributes.maxIntLine   = max_int_line;
+
+	return 0;
+#else
+	ARG_UNUSED(full_lines);
+	ARG_UNUSED(max_int_line);
+	return -ENOTSUP;
+#endif /* defined(CONFIG_ISP_LIB_AE_MODULE) */
+}
