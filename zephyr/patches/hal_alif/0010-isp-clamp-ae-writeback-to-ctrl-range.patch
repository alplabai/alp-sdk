+/*
+ * alp-sdk fix (Alp Lab AB): the ISP library's own AE algorithm
+ * computes gain/exposure targets in its own fixed-point scale, and nothing
+ * upstream of isp_vsi_bottom_half() clamps the result to what the sensor's
+ * registered video control actually accepts. On E1M-AEN803 + OV5647, AE
+ * settled on a gain writeback out of OV5647's registered
+ * VIDEO_CID_ANALOGUE_GAIN range [0, 1023] -- video_set_ctrl() rejected it
+ * with -EINVAL every single frame (Zephyr drivers/video/video_ctrls.c's
+ * IN_RANGE check), and cached_sns_config only updates on a successful write,
+ * so it never stopped retrying. Saturate into [min, max] before the write.
+ */
+static inline int32_t isp_clamp_ctrl_val(int32_t val, int32_t min, int32_t max)
+{
+	if (val < min) {
+		return min;
+	}
+	if (val > max) {
+		return max;
+	}
+	return val;
+}
 #endif /* defined(CONFIG_ISP_LIB_AE_MODULE) */
 
