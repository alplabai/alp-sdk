 				.aeRunInterval = 1,
 				.aeTarget = CONFIG_VIDEO_ISP_VSI_AE_TARGET,
 				.dampOver = 0x40,
+#elif defined(CONFIG_VIDEO_ISP_VSI_CALIB_IMX296)
