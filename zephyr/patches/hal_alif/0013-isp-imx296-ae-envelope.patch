+				.dgain = IMX296_AE_MIN_DGAIN,
+			},
+			.autoAttr = {
+				.expTimeRange = {
+					.min =  32,
+					.max =  IMX296_AE_EXP_TIME_MAX_US,
+				},
+				.againRange = {
+					.min = IMX296_AE_MIN_AGAIN,
+					.max = IMX296_AE_MAX_AGAIN,
+				},
+				.dgainRange = {
+					.min = IMX296_AE_MIN_DGAIN,
+					.max = IMX296_AE_MAX_DGAIN,
+				},
+				.aeRunInterval = 1,
+				.aeTarget = CONFIG_VIDEO_ISP_VSI_AE_TARGET,
+				.dampOver = 0x40,
 #else /* ARX3A0 (Alif's stock calibration, unchanged) */
 			.manualAttr = {
 				.intTime = 100000,
