diff --git a/drivers/isp/isp_wrapper/inc/imx296_ae_envelope.h b/drivers/isp/isp_wrapper/inc/imx296_ae_envelope.h
new file mode 100644
index 0000000..72f1542
--- /dev/null
+++ b/drivers/isp/isp_wrapper/inc/imx296_ae_envelope.h
@@ -0,0 +1,110 @@
+/*
+ * Copyright (C) 2026 Alif Semiconductor.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#ifndef DRIVERS_ISP_ISP_WRAPPER_INC_IMX296_AE_ENVELOPE_H
+#define DRIVERS_ISP_ISP_WRAPPER_INC_IMX296_AE_ENVELOPE_H
+
+#include "vsios_type.h"
+
+/*
+ * alp-sdk fix (Alp Lab AB, #2287 Stage B unit 3): IMX296's real AE envelope,
+ * shared between sensor_attributes.h's AE_SNS_DEFAULT_S table and
+ * isp_param_conf.h's IMX296 .ae calibration block (patch 0013) -- same
+ * mechanism as ov5647_ae_envelope.h (patch 0011), see that header's own
+ * comment for why SetCalib() loading isp_param_conf.h's compiled-in
+ * calibration before isp_apply_ae() ever runs makes this sharing necessary.
+ * This header follows ov5647_ae_envelope.h's shape deliberately (same macro
+ * names, same _Static_assert round-trip band) so the two sensors' envelopes
+ * stay easy to compare; it is NOT a copy of OV5647's values -- every figure
+ * below is IMX296-specific, derived from the Sony IMX296LQR-C datasheet
+ * (pp.44, 49, 56, 60), the ONLY source used (clean-room -- no other
+ * IMX296 driver or calibration table was consulted for these numbers).
+ *
+ * Sourcing (all-pixel scan mode, master mode, page references to the
+ * datasheet PDF as paginated):
+ *   - fullLines (VMAX, p.49/p.56): 1118 lines/frame at the datasheet's
+ *     master-mode timing example.
+ *   - fps (p.44/p.56): 60.3 frame/s at that VMAX -- ISP_SNS_FPS_ACCU-scaled
+ *     below (*100) for the AE_SNS_DEFAULT_S struct field, same convention
+ *     sensor_attributes.h's other entries use; IMX296_AE_FPS_X10 (this
+ *     header) keeps ONE extra decimal digit (603 = 60.3*10) so the
+ *     microsecond conversion below stays integer-only without losing the
+ *     fractional frame rate OV5647's integer-fps envelope didn't need.
+ *   - minIntLine/maxIntLine: exposure LINES (this library's own unit, VIDEO_CID_EXPOSURE),
+ *     1 and VMAX - 14 = 1104, NOT the sensor's SHS register directly -- SHS is inversely
+ *     related (exposure_lines = VMAX - SHS, p.60) and has its OWN, DIFFERENT legal range;
+ *     the datasheet's own legal floor is SHS=4 (p.60's "Register List of Shutter setting",
+ *     4 <= SHS <= VMAX - 1), which would invert to a 1114-line ceiling -- but bench evidence
+ *     (E1M-AEN803 2026W36-0001, runs 304 vs 306) is SHS=4 produces a completely flat, black
+ *     frame with NO scene content at all (gain held at 0, ruling gain out as the cause),
+ *     while SHS=14 with the SAME ROI/timing produces a real (if still imperfect -- runs
+ *     304-306's own open finding, see isp_apply_ae()'s comment) scene. Cause UNKNOWN --
+ *     the datasheet lists SHS=4 as valid and nothing in it explains the difference. Clamped
+ *     to SHS=14 (IMX296_SHS_DEFAULT, imx296.c -- the sensor's OWN power-on-reset default,
+ *     independently bench-proven to produce an image) as a conservative floor until the
+ *     SHS=4 failure is understood: SHS=VMAX-1 (its CEILING) gives exposure=1, SHS=14 (this
+ *     clamp) gives exposure=VMAX-14=1104.
+ *   - minAgain/maxAgain (p.56, GAIN register 0x3204-0x3205, 0.1 dB/count,
+ *     0-480 = 0.0-48.0 dB): 1024 (0 dB = 1.0x, library units) and
+ *     round(1024 * 10^(480/200)) = 257217 (48.0 dB) -- computed the SAME
+ *     way zephyr/drivers/video/isp_sns_gain_conv.h's isp_gain_db_tenths_
+ *     table[480] is (that table is alp-sdk-side, not reachable from this
+ *     hal_alif header, hence the separate literal here; the two must stay
+ *     in sync by hand, same by-hand-invariant status ov5647_ae_envelope.h's
+ *     own comment documents for ITS struct/macro duplication). ~257216 in
+ *     the #2287 unit-3 design note is the same figure within the rounding
+ *     of 10^2.4.
+ *   - dgain (p.56, no separate digital-gain register documented for
+ *     this sensor): pinned to 1024 (unity), same convention as OV5647's
+ *     envelope -- all headroom flows through the analogue GAIN register.
+ */
+#define IMX296_AE_FULL_LINES 1118 /* VMAX, master-mode timing example */
+#define IMX296_AE_FPS_X10    603  /* 60.3 fps * 10 -- see header comment */
+#define IMX296_AE_MAX_INT_LINE 1104 /* VMAX - 14 (SHS=14 floor, bench-clamped -- SHS=4 is dark, see header comment) */
+#define IMX296_AE_MIN_AGAIN     1024   /* 1x floor, library units (1x = 1024) */
+#define IMX296_AE_MAX_AGAIN     257217 /* 48.0 dB -- see header comment */
+#define IMX296_AE_MIN_DGAIN     1024   /* unity -- no separate digital gain register */
+#define IMX296_AE_MAX_DGAIN     1024   /* unity, matching MIN (see OV5647 envelope's rationale) */
+
+_Static_assert(IMX296_AE_FULL_LINES == 1118, "drifted from sensor_attributes.fullLines");
+_Static_assert(IMX296_AE_MAX_INT_LINE == 1104, "drifted from sensor_attributes.maxIntLine");
+_Static_assert(IMX296_AE_MAX_AGAIN == 257217, "drifted from sensor_attributes.maxAgain");
+_Static_assert(IMX296_AE_MIN_AGAIN == 1024, "drifted from sensor_attributes.minAgain");
+_Static_assert(IMX296_AE_MAX_DGAIN == 1024, "drifted from sensor_attributes.maxDgain");
+_Static_assert(IMX296_AE_MIN_DGAIN == 1024, "drifted from sensor_attributes.minDgain");
+
+/*
+ * Exposure ceiling in MICROSECONDS, same derivation ov5647_ae_envelope.h's
+ * OV5647_AE_EXP_TIME_MAX_US uses (see that header's own comment for the
+ * full round-trip-guard rationale) -- generalised for a NON-integer frame
+ * rate via IMX296_AE_FPS_X10 (fps*10): line-time_us = 1e6 / (fullLines *
+ * fps) = 1e7 / (fullLines * fps_x10), so
+ * exp_time_max_us = maxIntLine * 1e7 / (fullLines * fps_x10).
+ */
+#define IMX296_AE_EXP_TIME_MAX_US                                                                \
+	((vsi_u32_t)((vsi_u64_t)IMX296_AE_MAX_INT_LINE * 10000000 /                              \
+		      ((vsi_u64_t)IMX296_AE_FULL_LINES * IMX296_AE_FPS_X10)))
+
+/*
+ * Round-trip guard, same [ceiling-1, ceiling] band rationale as
+ * ov5647_ae_envelope.h's own (integer truncation only ever rounds the
+ * forward conversion DOWN, so an upper-only check can never fail -- the
+ * lower bound is what actually catches a unit/order slip). Round-trip
+ * formula (inverse of the macro above, fps_x10 cancels its own *10):
+ * lines = exp_time_us * fullLines * fps_x10 / 10000000.
+ */
+_Static_assert(((vsi_u64_t)IMX296_AE_EXP_TIME_MAX_US *
+		 ((vsi_u64_t)IMX296_AE_FULL_LINES * IMX296_AE_FPS_X10) / 10000000) <=
+		       IMX296_AE_MAX_INT_LINE,
+	       "IMX296_AE_EXP_TIME_MAX_US round-trips to more lines than IMX296_AE_MAX_INT_LINE");
+_Static_assert(((vsi_u64_t)IMX296_AE_EXP_TIME_MAX_US *
+		 ((vsi_u64_t)IMX296_AE_FULL_LINES * IMX296_AE_FPS_X10) / 10000000) >=
+		       IMX296_AE_MAX_INT_LINE - 1,
+	       "IMX296_AE_EXP_TIME_MAX_US round-trips to far fewer lines than "
+	       "IMX296_AE_MAX_INT_LINE -- check for a unit or operand-order slip");
+_Static_assert((vsi_u64_t)IMX296_AE_MAX_INT_LINE <= 0xFFFFF,
+	       "IMX296_AE_MAX_INT_LINE (isp_api_wrapper.c's VIDEO_CID_EXPOSURE writeback scale, "
+	       "1 ctrl unit per line for IMX296) overflows the 20-bit video-ctrl exposure field");
+
+#endif /* DRIVERS_ISP_ISP_WRAPPER_INC_IMX296_AE_ENVELOPE_H */
