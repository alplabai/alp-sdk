diff --git a/sim/src/image.rs b/sim/src/image.rs
index 97cddc6..172f0c3 100644
--- a/sim/src/image.rs
+++ b/sim/src/image.rs
@@ -297,6 +297,78 @@ impl ImagesBuilder {
         images
     }

+    /// (alp-sdk#1066) Like make_image(), but the image is a small FIXED size
+    /// instead of maximal()'s hardcoded ImageSize::Largest (see maximal()'s
+    /// own doc comment a few hundred lines down: its size argument is
+    /// ignored -- every existing maker, make_image() included, always fills
+    /// the slot to capacity). That is the opposite of the geometry
+    /// bs->use_scratch (swap_scratch.c) needs to go false: the swapped
+    /// image must NOT reach the trailer-holding sector(s) at the top of the
+    /// slot, which requires slot >> image -- AEN's real slot size
+    /// (`DT_SIZE_K(2688)`) against a far smaller application, not this
+    /// harness's own fill-to-capacity
+    /// convention. Bypasses maximal() and calls install_image() directly
+    /// with ImageSize::Given(), touching no other maker or test.
+    pub fn make_image_undersized(self, deps: &DepTest, permanent: bool) -> Images {
+        const UNDERSIZED_IMAGE_LEN: usize = 4096;
+
+        let num_images = self.num_images();
+        let mut flash = self.flash;
+        let ram = self.ram.clone();
+        let images: Vec<OneImage> = self.slots.into_iter().enumerate().map(|(image_num, slots)| {
+            let dep: Box<dyn Depender> = if num_images > 1 {
+                Box::new(PairDep::new(num_images, image_num, deps))
+            } else {
+                Box::new(BoringDep::new(image_num, deps))
+            };
+            let primaries = install_image(&mut flash, &self.areadesc, &slots, 0,
+                ImageSize::Given(UNDERSIZED_IMAGE_LEN), &ram, &*dep, ImageManipulation::None, Some(0));
+            let upgrades = match deps.depends[image_num] {
+                DepType::NoUpgrade => install_no_image(),
+                _ => install_image(&mut flash, &self.areadesc, &slots, 1,
+                    ImageSize::Given(UNDERSIZED_IMAGE_LEN), &ram, &*dep, ImageManipulation::None, Some(1)),
+            };
+            OneImage { slots, primaries, upgrades }
+        }).collect();
+        install_ptable(&mut flash, &self.areadesc);
+
+        let mut images = Images {
+            flash,
+            areadesc: self.areadesc,
+            images,
+            total_count: None,
+            ram: self.ram,
+        };
+        for image in &images.images {
+            mark_upgrade(&mut images.flash, &image.slots[1]);
+        }
+
+        if !Caps::modifies_flash() {
+            return images;
+        }
+
+        let total_count = match images.run_basic_upgrade(permanent) {
+            Some(v) => v,
+            // (alp-sdk#1066) Same UpgradeInfo::Held tolerance make_image()
+            // above gives: with dependencies that hold the upgrade back,
+            // run_basic_upgrade() legitimately returns None with nothing
+            // wrong. Restored here rather than left as a bare panic!() so a
+            // future caller that passes deps other than &NO_DEPS (every
+            // caller today) does not fall into a trap this maker's own
+            // sibling already knows how to avoid.
+            None =>
+                if deps.upgrades.iter().any(|u| *u == UpgradeInfo::Held) {
+                    0
+                } else {
+                    panic!("Unable to perform basic undersized upgrade");
+                }
+        };
+        c::reset_security_counters();
+
+        images.total_count = Some(total_count);
+        images
+    }
