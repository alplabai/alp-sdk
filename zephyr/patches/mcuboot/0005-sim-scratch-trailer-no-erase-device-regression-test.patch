+/// (alp-sdk#1066) Backs `flash_area_erase_required()` in the C support
+/// code, which the sim's flash_map_backend.h did not implement at all
+/// before this patch -- bootutil's device_requires_erase() macro
+/// (bootutil_area.h) is gated on MCUBOOT_SUPPORT_DEV_WITHOUT_ERASE /
+/// _WITH_ERASE, and the sim's own mcuboot_config.h never defined either,
+/// so every device the simulator built was hardcoded
+/// device_requires_erase() == true regardless of erased_val -- the
+/// no-explicit-erase defect this issue closes was unreachable by any sim
+/// test. Returns true (erase required) for every device unless a test has
+/// explicitly called SimFlash::set_erase_required(false) on it.
+#[no_mangle]
+pub extern "C" fn sim_flash_erase_required(id: u8) -> u8 {
+    THREAD_CTX.with(|ctx| {
+        ctx.borrow().flash_params.get(&id).unwrap().erase_required as u8
+    })
+}
+
 fn map_err(err: Result<()>) -> libc::c_int {
     match err {
         Ok(()) => 0,
diff --git a/sim/mcuboot-sys/src/c.rs b/sim/mcuboot-sys/src/c.rs
index e45f741..64a6fd5 100644
--- a/sim/mcuboot-sys/src/c.rs
+++ b/sim/mcuboot-sys/src/c.rs
@@ -221,6 +221,37 @@ pub fn reset_security_counters() {
     api::sim_reset_nv_counters();
 }

+/// (alp-sdk#1066) Direct probe for boot_scramble_region()'s backwards
+/// branch -- see invoke_scramble_region_backwards_probe() in
+/// csupport/run.c for the mechanics and why no existing sim_test can
+/// distinguish this bug from a passing run. Fills `area_id`'s whole area
+/// with `sentinel`, scrambles its last 3 write blocks backwards, and
+/// returns (byte at the range's own low boundary, byte one write block
+/// below it).
+pub fn scramble_region_backwards_probe(areadesc: &AreaDesc, multiflash: &mut SimMultiFlash,
+                                        area_id: u8, sentinel: u8) -> Result<(u8, u8), i32> {
+    for (&dev_id, flash) in multiflash.iter_mut() {
+        api::set_flash(dev_id, flash);
+    }
+    let mut sim_ctx = api::CSimContext { .. Default::default() };
+    let mut boundary_byte: u8 = 0;
+    let mut below_byte: u8 = 0;
+    let rc: i32 = unsafe {
+        let adesc = areadesc.get_c();
+        raw::invoke_scramble_region_backwards_probe(&mut sim_ctx as *mut _,
+            adesc.borrow() as *const _, area_id, sentinel,
+            &mut boundary_byte as *mut u8, &mut below_byte as *mut u8) as i32
+    };
+    for &dev_id in multiflash.keys() {
+        api::clear_flash(dev_id);
+    }
+    if rc == 0 {
+        Ok((boundary_byte, below_byte))
+    } else {
+        Err(rc)
+    }
+}
+
 mod raw {
     use crate::area::CAreaDesc;
     use crate::api::{BootRsp, CSimContext};
