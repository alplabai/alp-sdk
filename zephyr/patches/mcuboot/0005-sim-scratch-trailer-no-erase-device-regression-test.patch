@@ -66,6 +66,14 @@ pub trait Flash {
 
     fn align(&self) -> usize;
     fn erased_val(&self) -> u8;
+
+    /// Whether this device needs `erase()` called before a sector can be
+    /// rewritten (alp-sdk#1066). True for every existing device profile
+    /// (matches bootutil's own MCUBOOT_SUPPORT_DEV_WITH_ERASE-only default),
+    /// so this is additive: nothing that does not call
+    /// `set_erase_required(false)` observes any change.
+    fn erase_required(&self) -> bool;
+    fn set_erase_required(&mut self, required: bool);
 }
 
 fn ebounds<T: AsRef<str>>(message: T) -> FlashError {
@@ -94,6 +102,10 @@ pub struct SimFlash {
     align: usize,
     verify_writes: bool,
     erased_val: u8,
+    // (alp-sdk#1066) Defaults true for every existing caller of `new()`, so
+    // this is additive: nothing observes a change unless it explicitly
+    // calls `set_erase_required(false)`.
+    erase_required: bool,
 }
 
 impl SimFlash {
@@ -112,6 +124,7 @@ impl SimFlash {
             align,
             verify_writes: true,
             erased_val,
+            erase_required: true,
         }
     }
 
@@ -267,6 +280,14 @@ impl Flash for SimFlash {
     fn erased_val(&self) -> u8 {
         self.erased_val
     }
+
+    fn erase_required(&self) -> bool {
+        self.erase_required
+    }
+
+    fn set_erase_required(&mut self, required: bool) {
+        self.erase_required = required;
+    }
 }
 
