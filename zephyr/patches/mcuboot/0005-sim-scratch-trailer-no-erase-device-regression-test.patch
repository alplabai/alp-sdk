+    /// Regression test for alp-sdk#1066 (the issue's other mechanism, distinct
+    /// from swap_size_erased_collision above): on a flash device that does
+    /// not require an explicit erase before rewrite -- modelled here via
+    /// `SimFlash::set_erase_required(false)`, since MRAM is directly
+    /// rewritable without a bulk erase, same reasoning
+    /// swap_size_erased_collision's own doc comment gives for
+    /// set_verify_writes(false) -- completing a scratch-based swap used to
+    /// leave the scratch area's *temporary* trailer magic GOOD forever.
+    ///
+    /// The "erase" call meant to remove it (swap_scratch.c, "Erase the
+    /// temporary trailer from the scratch area") was a documented no-op on
+    /// such a device: boot_erase_region() (bootutil_area.c) takes the
+    /// `device_requires_erase(fa) == false` branch, logs "device without
+    /// erase", and returns success without touching flash. Nothing else in
+    /// the completed-swap path cleared it, so on the next boot a GOOD
+    /// scratch magic unconditionally selected BOOT_STATUS_SOURCE_SCRATCH
+    /// (boot_status_tables[], swap_scratch.c) regardless of image_ok, and
+    /// the device resumed the same already-finished swap forever.
+    ///
+    /// This is orthogonal to erased_val: the ambiguous-*value* collision
+    /// swap_size_erased_collision reproduces (and the companion 0002/0003
+    /// patches close) depends on erased_val == 0x00, but this is a skipped
+    /// *erase call*, not a value ambiguity, so this method does not gate on
+    /// erased_val and is exercised under both values each_device() sweeps.
+    /// Before this issue's 0004 fix, this method could not be expressed at
+    /// all: the simulator's own mcuboot_config.h never defined
+    /// MCUBOOT_SUPPORT_DEV_WITHOUT_ERASE, so device_requires_erase() was
+    /// hardcoded true for every device the simulator ever built --
+    /// unreachable by any test that only varies erased_val, which is why
+    /// this defect went uncaught by the full 26-case sweep the companion
+    /// fix's own regression test runs under.
+    ///
+    /// Uses make_image_undersized(), not make_image(): the STATE_0 branch
+    /// this method targets is itself gated on `!bs->use_scratch`
+    /// (swap_scratch.c), which requires the swapped image to NOT reach the
+    /// trailer-holding sector(s) at the top of the slot -- i.e. slot >>
+    /// image, matching AEN's real 2.75 MB slot against a far smaller
+    /// application. make_image()'s images always fill the slot to capacity
+    /// (maximal() ignores its size argument and always returns
+    /// ImageSize::Largest), so `!bs->use_scratch` -- and therefore this
+    /// entire fix -- is unreachable with it: verified empirically, zero
+    /// `swap_scramble_trailer_sectors: fa_id=<scratch>` log lines across
+    /// all 26 device/align/erased_val combinations with make_image().
+    pub fn run_scratch_trailer_cleared_after_swap(&self) -> bool {
+        if !Caps::SwapUsingScratch.present() || !Caps::modifies_flash() {
+            return false;
+        }
+
+        let mut flash = self.flash.clone();
+        for dev in flash.values_mut() {
+            dev.set_erase_required(false);
+            // The simulator's own write-verification otherwise rejects any
+            // rewrite of an already-programmed (non-erased) location as an
+            // illegal NOR/NAND-style write. That does not apply to a device
+            // that does not require an explicit erase: MRAM is directly
+            // rewritable without a bulk erase, which is the reason this
+            // device class exists in the first place (same justification
+            // swap_size_erased_collision's own set_verify_writes(false)
+            // call above gives).
+            dev.set_verify_writes(false);
+        }
+
+        // A real, uninterrupted, permanent upgrade -- not a revert-pending
+        // one -- so the swap actually completes and the scratch trailer's
+        // fate after a finished swap is what gets checked.
+        self.mark_permanent_upgrades(&mut flash, 1);
+
+        if !c::boot_go(&mut flash, &self.areadesc, None, None, false).success() {
+            warn!("scratch_trailer_cleared_after_swap: boot_go failed");
+            return true;
+        }
+        if !self.verify_trailers(&flash, 0, BOOT_MAGIC_GOOD,
+                                 BOOT_FLAG_SET, BOOT_FLAG_SET) {
+            warn!("scratch_trailer_cleared_after_swap: primary slot trailer \
+                   mismatch after a supposedly-completed swap");
+            return true;
+        }
+
+        // No SlotInfo for the scratch area exists on Images/ImagesBuilder
+        // (only primary/secondary do) -- build one the same way
+        // ImagesBuilder::new() already does for those two, via the real
+        // boot_magic_sz()/boot_max_align() accessors rather than a
+        // hand-computed constant, so this stays correct if either ever
+        // changes.
+        let (scratch_base, scratch_len, scratch_dev_id) =
+            match self.areadesc.find(FlashId::ImageScratch) {
+                Some(info) => info,
+                None => {
+                    warn!("scratch_trailer_cleared_after_swap: no scratch area, skipping");
+                    return false;
+                }
+            };
+        let offset_from_end = c::boot_magic_sz() + c::boot_max_align() * 4;
+        let scratch = SlotInfo {
+            base_off: scratch_base,
+            trailer_off: scratch_base + scratch_len - offset_from_end,
+            len: scratch_len,
+            dev_id: scratch_dev_id,
+            index: 0,
+        };
+
+        // Deliberately BOOT_MAGIC_GOOD, not BOOT_MAGIC_UNSET ("must read back
+        // as fully erased"): scratch is legitimately reused as a staging
+        // buffer for later sectors' image data once its temporary trailer's
+        // job is done, so the magic-sized region at its tail can end up
+        // holding ordinary image bytes rather than the device's erased_val
+        // -- harmless, and not what #1066 is about. verify_trailer(...,
+        // BOOT_MAGIC_GOOD, ...) returns true only when those bytes equal the
+        // real MAGIC constant, so this is exactly "assert no GOOD magic",
+        // the property that actually matters: a GOOD magic is the one byte
+        // pattern that makes the next boot's boot_status_tables[] lookup
+        // (swap_scratch.c) select BOOT_STATUS_SOURCE_SCRATCH and resume.
+        if verify_trailer(&flash, &scratch, BOOT_MAGIC_GOOD, None, None) {
+            error!("scratch_trailer_cleared_after_swap: completed swap left a GOOD \
+                    magic in the scratch area's temporary trailer -- alp-sdk#1066's \
+                    self-perpetuating re-swap: the scratch-trailer erase is a no-op \
+                    on a device that does not require an explicit erase, and nothing \
+                    else clears it");
+            return true;
+        }
+
+        false
+    }
+
