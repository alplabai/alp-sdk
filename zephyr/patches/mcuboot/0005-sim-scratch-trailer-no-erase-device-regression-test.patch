+    // (alp-sdk#1066) Snapshotted alongside align/erased_val at set_flash()
+    // time, same as both; see sim_flash_erase_required() below.
+    erase_required: bool,
 }
 
 pub type FlashParams = HashMap<u8, FlashParamsStruct>;
@@ -183,6 +186,7 @@ pub fn set_flash(dev_id: u8, dev: &mut dyn Flash) {
         ctx.borrow_mut().flash_params.insert(dev_id, FlashParamsStruct {
             align: dev.align() as u32,
             erased_val: dev.erased_val(),
+            erase_required: dev.erase_required(),
         });
         unsafe {
             let dev: &'static mut dyn Flash = mem::transmute(dev);
@@ -320,6 +324,23 @@ pub extern "C" fn sim_flash_erased_val(id: u8) -> u8 {
     })
 }
 
+/// (alp-sdk#1066) Backs `flash_area_erase_required()` in the C support
+/// code, which the sim's flash_map_backend.h did not implement at all
+/// before this patch -- bootutil's device_requires_erase() macro
+/// (bootutil_area.h) is gated on MCUBOOT_SUPPORT_DEV_WITHOUT_ERASE /
+/// _WITH_ERASE, and the sim's own mcuboot_config.h never defined either,
+/// so every device the simulator built was hardcoded
+/// device_requires_erase() == true regardless of erased_val -- the
+/// no-explicit-erase defect this issue closes was unreachable by any sim
+/// test. Returns true (erase required) for every device unless a test has
+/// explicitly called SimFlash::set_erase_required(false) on it.
+#[no_mangle]
+pub extern "C" fn sim_flash_erase_required(id: u8) -> u8 {
+    THREAD_CTX.with(|ctx| {
+        ctx.borrow().flash_params.get(&id).unwrap().erase_required as u8
+    })
+}
+
