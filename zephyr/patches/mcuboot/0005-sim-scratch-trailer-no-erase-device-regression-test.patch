--- a/sim/mcuboot-sys/src/api.rs
+++ b/sim/mcuboot-sys/src/api.rs
@@ -23,6 +23,9 @@ pub type FlashMap = HashMap<u8, FlashPtr>;
 pub struct FlashParamsStruct {
