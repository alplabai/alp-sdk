 #ifndef __FLASH_MAP_BACKEND_H__
 #define __FLASH_MAP_BACKEND_H__
 
+#include <stdbool.h>
 #include <storage/flash_map.h>
 
 static inline uint32_t flash_area_get_off(const struct flash_area *fa)
@@ -35,4 +36,20 @@ static inline uint8_t flash_area_get_id(const struct flash_area *fa)
 	return fa->fa_id;
 }
 
+/* (alp-sdk#1066) bootutil's device_requires_erase(fa) (bootutil_area.h)
+ * expands to this function when both MCUBOOT_SUPPORT_DEV_WITHOUT_ERASE and
+ * MCUBOOT_SUPPORT_DEV_WITH_ERASE are defined -- see build.rs, which now
+ * defines both unconditionally so the simulator can model either class of
+ * device instead of hardcoding "always requires erase". Backed by
+ * sim_flash_erase_required() (mcuboot-sys/src/api.rs), which defaults
+ * true for every device unless a test opts a specific one out via
+ * SimFlash::set_erase_required(false).
+ */
+extern uint8_t sim_flash_erase_required(uint8_t flash_id);
+
+static inline bool flash_area_erase_required(const struct flash_area *fa)
+{
+	return sim_flash_erase_required(fa->fa_device_id) != 0;
+}
+
 #endif /* __FLASH_MAP_BACKEND_H__*/
diff --git a/sim/mcuboot-sys/src/api.rs b/sim/mcuboot-sys/src/api.rs
