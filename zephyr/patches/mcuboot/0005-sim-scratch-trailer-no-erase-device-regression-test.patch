diff --git a/sim/mcuboot-sys/csupport/run.c b/sim/mcuboot-sys/csupport/run.c
index fd4c347..fedf29e 100644
--- a/sim/mcuboot-sys/csupport/run.c
+++ b/sim/mcuboot-sys/csupport/run.c
@@ -647,6 +647,85 @@ int flash_area_get_sector(const struct flash_area *fa, uint32_t off,
     return (i < slot->num_areas) ? 0 : -1;
 }

+/* (alp-sdk#1066) Direct regression coverage for boot_scramble_region()'s
+ * backwards branch (bootutil_area.c) -- see fix (ii) in
+ * 0004-scramble-scratch-trailer-and-backward-scramble-off-by-one.patch.
+ * Every real bootutil caller reaches this function only through
+ * swap_scramble_trailer_sectors(), and every one of ITS callers (this
+ * issue's own swap_scratch.c hunk, plus swap_move.c/swap_offset.c and
+ * boot_scramble_slot()) always passes an off/size whose sum equals the
+ * flash area's own size -- the exact shape
+ * scratch_trailer_cleared_after_swap (the companion 0005 sim test)
+ * already exercises end to end. That shape cannot distinguish "wrote the
+ * boundary block" from "silently dropped it": reverting just this
+ * hunk during review left all pre-existing sim tests passing. This
+ * calls boot_scramble_region() directly instead, over an arbitrary
+ * sub-range of the area, so the boundary write is directly observable.
+ *
+ * Fills the whole area with the caller-supplied `sentinel` byte (the
+ * caller picks one that differs from the device's own erased_val, so the
+ * scramble's actual write is always distinguishable from the fill),
+ * scrambles backwards over the area's last three write blocks, and reads
+ * back two bytes: the first byte of the block AT the scramble range's own
+ * low boundary (must no longer read as `sentinel` -- this is the block
+ * the pre-fix loop guard skipped), and the first byte of the write block
+ * immediately BELOW that boundary (must still read as `sentinel`,
+ * proving the scramble touched nothing outside its own requested range).
+ */
+int invoke_scramble_region_backwards_probe(struct sim_context *ctx,
+        struct area_desc *adesc, uint8_t area_id, uint8_t sentinel,
+        uint8_t *out_boundary_byte, uint8_t *out_below_byte)
+{
+    const struct flash_area *fa;
+    uint8_t buf[BOOT_MAX_ALIGN];
+    uint32_t write_block, total_len, scramble_off, scramble_len, off;
+    int rc;
+
+    sim_set_flash_areas(adesc);
+    sim_set_context(ctx);
+
+    rc = flash_area_open(area_id, &fa);
+    if (rc != 0) {
+        goto reset;
+    }
+
+    write_block = flash_area_align(fa);
+    total_len = flash_area_get_size(fa);
+    if (total_len < 4 * write_block || write_block > sizeof(buf)) {
+        rc = -1;
+        goto close;
+    }
+
+    memset(buf, sentinel, sizeof(buf));
+    for (off = 0; off < total_len; off += write_block) {
+        rc = flash_area_write(fa, off, buf, write_block);
+        if (rc != 0) {
+            goto close;
+        }
+    }
+
+    scramble_len = 3 * write_block;
+    scramble_off = total_len - scramble_len;
+
+    rc = boot_scramble_region(fa, scramble_off, scramble_len, true);
+    if (rc != 0) {
+        goto close;
+    }
+
+    rc = flash_area_read(fa, scramble_off, out_boundary_byte, 1);
+    if (rc != 0) {
+        goto close;
+    }
+    rc = flash_area_read(fa, scramble_off - write_block, out_below_byte, 1);
+
+close:
+    flash_area_close(fa);
+reset:
+    sim_reset_flash_areas();
+    sim_reset_context();
+    return rc;
+}
+
 void sim_assert(int x, const char *assertion, const char *file, unsigned int line, const char *function)
 {
     if (!(x)) {
